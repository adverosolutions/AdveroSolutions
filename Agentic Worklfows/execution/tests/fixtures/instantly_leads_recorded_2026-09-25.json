    "notes": [
      "FILTER_VAL_CONTACTED returned the same first five leads as FILTER_VAL_COMPLETED_NO_REPLY",
      "FILTER_VAL_SKIPPED returned no leads",
      "next_starting_after cursors were not recorded"
    ]
