# AdveroSolutions - Git Ignore
# NEVER commit sensitive data or credentials

# Environment variables
.env
.env.local
.env.production

# Google OAuth credentials
credentials.json
token.json
token.pickle

# Temporary files
.tmp/
*.tmp
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebook
.ipynb_checkpoints

# Testing
.pytest_cache/
.coverage
htmlcov/

# Modal
.modal/

# Logs
*.log
error_log.txt
debug.log

# Data files (intermediates)
*.csv
*.xlsx
*.json
!webhooks.json
!requirements.txt
!package.json

# Backup files
*.bak
*.backup

# Revenue automation: committed config, snapshots and test fixtures
!Agentic\ Worklfows/config/**/*.json
!**/tests/fixtures/*.json
!.claude/settings.json
!.claude/agents/

# Change-set source: the approved copy, settings and label taxonomy Lorenzo
# reviews before a live apply. These are inputs, not intermediates, and
# changesets/tests/test_phase0.py reads them.
!Agentic\ Worklfows/changesets/**/*.json

# Change-set rollback points: the before-image of every live apply, and the
# ONLY copy of that state (NOT regenerable; dry-runs write under .tmp/).
# Ignored because they contain live email_list data; keep them on disk and
# never delete one. Listed AFTER the negation above so the directory rule wins.
Agentic Worklfows/changesets/backups/
.tmp/

# Credential-looking string: kept on this Mac only, never pushed (2026-09-23)
Supabase/Untitled Document (1).txt

# Inputs the code and tests need, not intermediates (added for the GitHub push, 2026-09-23)
!**/fixtures/**/*.json
!Coding/upwork-pipeline/jobs/*/build/
!Coding/upwork-pipeline/jobs/**/*.json
!Coding/upwork-pipeline/*.csv
!Coding/upwork-pipeline/maker-school-state.json
!Coding/upwork-pipeline/jobs/**/*.csv
!Coding/make_module_catalog.json
!Coding/make_catalog_report.json
!Coding/apify-lead-engine/scrape-leads-skill/input_schema.json
!Coding/lead-scrape-2026/tests/*.json
!Coding/lead-scrape-2026/instantly_campaigns.json
# Apify filter settings per niche (no lead data); the list factory and its tests read them.
!Coding/lead-scrape-2026/niches/*.json
!Agentic\ Worklfows/products/**/*.json
!Agentic\ Worklfows/products/**/*.csv
!Agentic\ Worklfows/execution/style_cards/*.json
!Agentic\ Worklfows/execution/linkedin_*.json
!Free\ Value\ Documents/*.json
!Free\ Value\ Documents/*.csv
# Local-only: session cookies and machine-specific settings
Agentic\ Worklfows/execution/.sessions/
.claude/settings.local.json
.mcp.json

# Sections split (2026-09-23): per-chat git worktrees, and the one-doc tooling's JSON
.worktrees/
!Agentic\ Worklfows/tools/**/*.json
Agentic Worklfows/tools/template_doc/roundtrip_export.txt

# Sanitized instruction/source snapshots and helper-skill assets (2026-11-04).
!ClaudeConfig/grok-source/**/*.json
!ClaudeConfig/grok-source/**/*.jsonl
!ClaudeConfig/synced-skills/**/*.json
