{
  "font": {"family": "Figtree", "fallback": "system-ui, sans-serif", "weights": [300, 400, 500, 600, 700, 800],
           "google": "https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700;800&display=swap"},
  "color": {
    "ink": "#16202e", "ink2": "#4d596b", "ink3": "#8792a3",
    "blue": "#2f74f5", "blue2": "#6aa5ff", "blueDeep": "#1f5fd6",
    "mint": "#1fb487", "amber": "#e8a13a",
    "page": "#e9f0f8", "line": "rgba(150,170,200,.28)",
    "skyStops": ["#c9dcf2", "#dce8f5", "#ecf1f7", "#f3f4f6", "#e9edf2"],
    "textGradient": ["#2f74f5", "#5b9bff"]
  },
  "radius": {"panel": 28, "pill": 99},
  "shadow": {
    "panel": "inset 0 1px 0 #fff, inset 0 0 0 1px rgba(255,255,255,.55), 0 40px 70px -30px rgba(38,72,128,.30), 0 16px 30px -18px rgba(38,72,128,.22)",
    "pill": "inset 0 1px 0 #fff, 0 6px 18px -8px rgba(38,72,128,.25)"
  },
  "type": {
    "display": {"weight": 600, "size": "44-96px", "lineHeight": 1.02, "letterSpacing": "-0.035em"},
    "h2": {"weight": 600, "size": "38-70px", "lineHeight": 1.02, "letterSpacing": "-0.035em"},
    "sub": {"weight": 450, "size": "17-21px", "lineHeight": 1.45, "color": "ink2"},
    "eyebrow": {"weight": 600, "size": "13px", "letterSpacing": "0.14em", "transform": "uppercase", "color": "blueDeep"}
  },
  "motion": {"ease": "cubic-bezier(.16,1,.3,1)"}
}
