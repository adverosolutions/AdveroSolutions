#!/usr/bin/env python3
"""Instantly reply_received backup poll. Quiet when nothing new."""
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from collections import Counter
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

CT = ZoneInfo("America/Chicago")
BASE = "https://api.instantly.ai/api/v2"
STATE = Path.home() / "advero/state/instantly_last_poll.json"
HANDLED = Path.home() / "advero/state/handled.jsonl"
WH_STATE = Path.home() / "advero/state/instantly_webhook.json"
OUT = Path("/tmp/instantly_poll_backup_result.json")
SECRETS = Path("/home/box/advero/bin/_load_box_secrets.py")


def load_key() -> str:
    import importlib.util

    spec = importlib.util.spec_from_file_location("lbs", SECRETS)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    m.apply()
    key = os.environ.get("INSTANTLY_API_KEY")
    if not key:
        raise SystemExit("INSTANTLY_API_KEY is not set")
    return key


def api_get(key: str, path: str, params: dict) -> tuple[dict | list | None, str | None]:
    q = urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
    url = f"{BASE}{path}?{q}" if q else f"{BASE}{path}"
    req = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {key}",
            "Accept": "application/json",
            "Content-Type": "application/json",
            "User-Agent": "Mozilla/5.0 (compatible; AdveroBot/1.0)",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=45) as resp:
            body = resp.read().decode("utf-8", "replace")
        return json.loads(body), None
    except urllib.error.HTTPError as e:
        err = e.read().decode("utf-8", "replace")[:400]
        return None, f"HTTP {e.code}: {err}"
    except Exception as e:
        return None, str(e)


def parse_ts(s: str | None) -> datetime | None:
    if not s:
        return None
    s = s.replace("Z", "+00:00")
    try:
        return datetime.fromisoformat(s)
    except ValueError:
        return None


def handled_email_ids() -> set[str]:
    ids: set[str] = set()
    if not HANDLED.exists():
        return ids
    for line in HANDLED.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        eid = row.get("email_id")
        if eid:
            ids.add(str(eid))
    return ids


def brief(item: dict) -> dict:
    body = item.get("body") or ""
    if isinstance(body, dict):
        text = body.get("text") or body.get("html") or ""
    else:
        text = str(body)
    preview = (item.get("content_preview") or text or "")[:280]
    return {
        "id": item.get("id"),
        "timestamp_email": item.get("timestamp_email"),
        "from": item.get("from_address_email"),
        "lead": item.get("lead"),
        "subject": item.get("subject"),
        "campaign_id": item.get("campaign_id"),
        "eaccount": item.get("eaccount"),
        "thread_id": item.get("thread_id"),
        "ue_type": item.get("ue_type"),
        "preview": preview,
    }


def main() -> int:
    now = datetime.now(CT)
    key = load_key()
    prev = {}
    if STATE.exists():
        try:
            prev = json.loads(STATE.read_text())
        except json.JSONDecodeError:
            prev = {}

    result = {
        "quiet": True,
        "reason": "",
        "last_checked_ct": now.isoformat(),
        "last_seen_email_id": prev.get("last_seen_email_id"),
        "last_seen_timestamp_email": prev.get("last_seen_timestamp_email"),
        "webhook_status": None,
        "webhook_id": None,
        "webhook_raw_status": None,
        "webhook_items_count": 0,
        "new_inbound_count": 0,
        "new_inbound_ids": [],
        "unhandled_inbound_count": 0,
        "unhandled_inbound_ids": [],
        "stale_unhandled_in_received_scan": 0,
        "stale_unhandled_note": "",
        "stale_unhandled_ids": [],
        "already_handled_inbound_ids": [],
        "webhook_alerted_today": False,
        "webhook_alerted_today_date": None,
        "need_webhook_alert": False,
        "new_inbound_briefs": [],
        "scan": {},
        "wake_parent": False,
        "skip": False,
    }

    # Skip Sunday; window 07:00-19:00 CT
    if now.weekday() == 6:
        result["skip"] = True
        result["reason"] = "skip_sunday"
        OUT.write_text(json.dumps(result, indent=2))
        STATE.write_text(json.dumps(result, indent=2))
        print(json.dumps({"quiet": True, "reason": "skip_sunday"}))
        return 0
    if not (7 <= now.hour < 19):
        result["skip"] = True
        result["reason"] = "outside_window"
        OUT.write_text(json.dumps(result, indent=2))
        STATE.write_text(json.dumps(result, indent=2))
        print(json.dumps({"quiet": True, "reason": "outside_window"}))
        return 0

    watermark_prev = prev.get("last_seen_timestamp_email") or "1970-01-01T00:00:00.000Z"
    wm_dt = parse_ts(watermark_prev)
    handled = handled_email_ids()

    all_data, all_err = api_get(key, "/emails", {"limit": 20})
    recv_data, recv_err = api_get(key, "/emails", {"limit": 50, "email_type": "received"})
    wh_data, wh_err = api_get(key, "/webhooks", {"limit": 50})

    all_items = (all_data or {}).get("items") or [] if isinstance(all_data, dict) else []
    recv_items = (recv_data or {}).get("items") or [] if isinstance(recv_data, dict) else []
    wh_items = (wh_data or {}).get("items") or [] if isinstance(wh_data, dict) else []

    # Persist raw for debug
    Path("/tmp/instantly_poll__emails_limit=20.json").write_text(json.dumps(all_data or {}, indent=2))
    Path("/tmp/instantly_poll__emails_limit=50_email_type=received.json").write_text(
        json.dumps(recv_data or {}, indent=2)
    )
    Path("/tmp/instantly_poll__webhooks_limit=50.json").write_text(json.dumps(wh_data or {}, indent=2))

    inbound = [i for i in recv_items if i.get("ue_type") == 2]
    ue_counter = Counter(str(i.get("ue_type")) for i in recv_items)

    # Latest inbound by timestamp
    def sort_key(i):
        t = parse_ts(i.get("timestamp_email")) or datetime.min.replace(tzinfo=ZoneInfo("UTC"))
        return t

    inbound_sorted = sorted(inbound, key=sort_key)
    latest = inbound_sorted[-1] if inbound_sorted else None
    latest_id = latest.get("id") if latest else prev.get("last_seen_email_id")
    latest_ts = latest.get("timestamp_email") if latest else prev.get("last_seen_timestamp_email")

    # New = strictly after watermark OR equal ts but unseen id, and not in handled
    new_inbound = []
    stale_unhandled = []
    already_handled_newish = []
    for item in inbound:
        eid = item.get("id")
        ts = parse_ts(item.get("timestamp_email"))
        after_wm = False
        if ts and wm_dt:
            # compare aware
            if wm_dt.tzinfo is None:
                wm_cmp = wm_dt.replace(tzinfo=ZoneInfo("UTC"))
            else:
                wm_cmp = wm_dt
            if ts.tzinfo is None:
                ts_cmp = ts.replace(tzinfo=ZoneInfo("UTC"))
            else:
                ts_cmp = ts
            after_wm = ts_cmp > wm_cmp
        elif ts and not wm_dt:
            after_wm = True

        if eid in handled:
            if after_wm:
                already_handled_newish.append(eid)
            continue
        if after_wm:
            new_inbound.append(item)
        else:
            stale_unhandled.append(eid)

    # Also: any inbound id not in handled that appears in the mixed recent list as lead reply
    # (watermark gate still applies for backup poll)

    # Webhook reply_received status
    reply_hooks = [w for w in wh_items if w.get("event_type") == "reply_received"]
    hook = reply_hooks[0] if reply_hooks else None
    wh_status = hook.get("status") if hook else None
    wh_id = hook.get("id") if hook else None

    alerted_date = prev.get("webhook_alerted_today_date")
    today = now.date().isoformat()
    already_alerted = bool(prev.get("webhook_alerted_today")) and alerted_date == today
    need_alert = (wh_status is None or wh_status == -1) and not already_alerted

    # Outbound latest from all list (for scan context)
    out_latest = None
    for i in all_items:
        if i.get("ue_type") != 2:
            if out_latest is None or sort_key(i) > sort_key(out_latest):
                out_latest = i

    # Watermark advances only when we have inbound; keep previous if scan empty of newer
    # Policy from prior runs: watermark_next stays at latest inbound ts seen (even if handled)
    # If new inbound found, watermark becomes max of those + previous
    watermark_next = watermark_prev
    next_id = prev.get("last_seen_email_id")
    candidates = inbound_sorted
    if candidates:
        # Use the newest inbound overall as last_seen (matches prior quiet runs)
        watermark_next = latest_ts or watermark_prev
        next_id = latest_id

    # If there are NEW unhandled after watermark, do not advance past them until processed?
    # Prior runs: watermark_next stayed at latest inbound even when already handled.
    # Keep same: last_seen = latest inbound in scan.

    all_out_ts = out_latest.get("timestamp_email") if out_latest else None
    all_out_id = out_latest.get("id") if out_latest else None

    result.update(
        {
            "last_seen_email_id": next_id,
            "last_seen_timestamp_email": watermark_next,
            "webhook_status": wh_status if wh_status is not None else -1 if hook is None else wh_status,
            "webhook_id": wh_id,
            "webhook_raw_status": wh_status,
            "webhook_items_count": len(wh_items),
            "new_inbound_count": len(new_inbound),
            "new_inbound_ids": [i.get("id") for i in new_inbound],
            "unhandled_inbound_count": len(new_inbound),
            "unhandled_inbound_ids": [i.get("id") for i in new_inbound],
            "stale_unhandled_in_received_scan": len(stale_unhandled),
            "stale_unhandled_note": (
                "pre-watermark inbound not in handled.jsonl; ignored by backup poll (watermark gate)"
                if stale_unhandled
                else ""
            ),
            "stale_unhandled_ids": stale_unhandled[:50],
            "already_handled_inbound_ids": already_handled_newish,
            "webhook_alerted_today": already_alerted,
            "webhook_alerted_today_date": alerted_date if already_alerted else None,
            "need_webhook_alert": need_alert,
            "new_inbound_briefs": [brief(i) for i in new_inbound],
            "scan": {
                "all_count": len(all_items),
                "received_count": len(recv_items),
                "inbound_ue2_in_scan": len(inbound),
                "watermark_prev": watermark_prev,
                "watermark_next": watermark_next,
                "latest_id": latest_id,
                "latest_ts": latest_ts,
                "all_list_latest_outbound_id": all_out_id,
                "all_list_latest_outbound_ts": all_out_ts,
                "pages_extra": 0,
                "received_err": recv_err,
                "all_err": all_err,
                "webhook_err": wh_err,
                "in_window": True,
                "dow": now.weekday(),
                "filter": "email_type=received",
                "recv_ue_counter": dict(ue_counter),
                "reply_hook_summary": (
                    {
                        "id": wh_id,
                        "status": wh_status,
                        "event_type": hook.get("event_type") if hook else None,
                        "url": hook.get("url") if hook else None,
                    }
                    if hook or True
                    else None
                ),
            },
        }
    )

    if need_alert:
        result["quiet"] = False
        result["reason"] = "webhook_missing_or_disabled"
        result["wake_parent"] = True
    elif new_inbound:
        result["quiet"] = False
        result["reason"] = "new_inbound"
        result["wake_parent"] = True  # parent/automation continues classify+hold; this script flags
    else:
        result["quiet"] = True
        result["reason"] = "no_new_inbound_webhook_ok" if (wh_status == 1) else "no_new_inbound"
        result["wake_parent"] = False

    # Update webhook state file
    WH_STATE.write_text(
        json.dumps(
            {
                "id": wh_id,
                "status": wh_status,
                "event_type": "reply_received",
                "url": hook.get("url") if hook else None,
                "checked_ct": now.isoformat(timespec="minutes"),
            },
            indent=2,
        )
    )

    OUT.write_text(json.dumps(result, indent=2))
    STATE.write_text(json.dumps(result, indent=2))
    print(json.dumps({
        "quiet": result["quiet"],
        "reason": result["reason"],
        "new_inbound_count": result["new_inbound_count"],
        "need_webhook_alert": result["need_webhook_alert"],
        "webhook_status": result["webhook_status"],
        "wake_parent": result["wake_parent"],
        "last_seen_timestamp_email": result["last_seen_timestamp_email"],
        "stale_unhandled_in_received_scan": result["stale_unhandled_in_received_scan"],
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
