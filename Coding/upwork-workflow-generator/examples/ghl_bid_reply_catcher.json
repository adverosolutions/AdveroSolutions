  "title": "Bid Reply Catcher",
  "platform": "gohighlevel",
  "sections": [{"key": "r", "label": "1 - CATCH THE REPLY", "note": "Two steps. Any reply from a contact who has a bid out gets the tag that the main workflow's goal is waiting for."}],
