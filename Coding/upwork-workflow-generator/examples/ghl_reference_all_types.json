{
  "title": "REFERENCE - All Step Types",
  "platform": "gohighlevel",
  "sections": [
    {"key": "trig", "label": "TRIGGERS", "note": "Two triggers into one workflow: tag added (with filter) and tag removed (with filter). Other trigger types are out of scope for this reference pass."},
    {"key": "contact", "label": "CONTACT AND MESSAGING", "note": "Tags, SMS, email, waits."},
    {"key": "opps", "label": "OPPORTUNITIES", "note": "Create in Call Booked, then move to Cancelled."},
    {"key": "internal", "label": "INTERNAL", "note": "Notifications (sms, email, in-app), task, manual action, call."},
    {"key": "misc", "label": "OTHER ACTIONS", "note": "Contact field, assign user, webhook, AI step, add to and remove from workflow, review request."},
    {"key": "logic", "label": "GOAL AND IF/ELSE", "note": "Goal on a tag, If/Else on a tag with both branches, Go To and End."}
  ],
  "nodes": [
    {"key": "t_added", "kind": "trigger.app", "app": "ghl", "op": "contact_tag_added", "label": "T1 - Trigger Tag Added Filter call-booked", "section": "trig", "params": {"tag": "call-booked"}},
    {"key": "t_removed", "kind": "trigger.app", "app": "ghl", "op": "contact_tag_removed", "label": "T2 - Trigger Tag Removed Filter call-cancelled", "section": "trig", "params": {"tag": "call-cancelled"}},

    {"key": "s01", "kind": "app.action", "app": "ghl", "op": "add_tag", "label": "01 - Add Tag call-booked", "section": "contact", "params": {"tag": "call-booked"}},
    {"key": "s02", "kind": "app.action", "app": "ghl", "op": "remove_tag", "label": "02 - Remove Tag call-cancelled", "section": "contact", "params": {"tag": "call-cancelled"}},
    {"key": "s03", "kind": "app.action", "app": "ghl", "op": "send_sms", "label": "03 - Send SMS Body Filled", "section": "contact", "params": {"message": "REFERENCE SMS: Hi {{contact.first_name}}, this is the SMS body. It should appear in the message box."}},
    {"key": "s04", "kind": "app.action", "app": "ghl", "op": "send_email", "label": "04 - Send Email Subject and Body Filled", "section": "contact", "params": {"subject": "REFERENCE email subject for {{contact.first_name}}", "body": "REFERENCE email body. Hi {{contact.first_name}}, this text should appear in the email editor."}},
    {"key": "s05", "kind": "flow.wait", "label": "05 - Wait 2 Days", "section": "contact", "params": {"amount": 2, "unit": "days"}},
    {"key": "s06", "kind": "app.action", "app": "ghl", "op": "create_opportunity", "label": "06 - Create Opportunity in Call Booked", "section": "opps", "params": {"pipeline": "Call Booked Pipeline", "stage": "Call Booked", "name": "{{contact.first_name}} {{contact.last_name}} - REFERENCE", "status": "open"}},
    {"key": "s07", "kind": "app.action", "app": "ghl", "op": "update_opportunity", "label": "07 - Update Opportunity to Cancelled", "section": "opps", "params": {"pipeline": "Call Booked Pipeline", "stage": "Cancelled", "status": "open"}},
    {"key": "s08", "kind": "flow.wait", "label": "08 - Wait 1 Hour", "section": "contact", "params": {"amount": 1, "unit": "hours"}},
    {"key": "s09", "kind": "app.action", "app": "ghl", "op": "internal_notification", "label": "09 - Internal Notification SMS to Assigned User", "section": "internal", "params": {"type": "sms", "to": "the contact's assigned user", "message": "REFERENCE internal SMS: {{contact.first_name}} {{contact.last_name}} booked."}},
    {"key": "s10", "kind": "app.action", "app": "ghl", "op": "internal_notification", "label": "10 - Internal Notification Email to Assigned User", "section": "internal", "params": {"type": "email", "to": "the contact's assigned user", "subject": "REFERENCE internal email subject", "message": "REFERENCE internal email body for {{contact.first_name}}."}},
    {"key": "s11", "kind": "app.action", "app": "ghl", "op": "internal_notification", "label": "11 - Internal Notification In-App", "section": "internal", "params": {"type": "in_app", "message": "REFERENCE in-app notification body for {{contact.first_name}}."}},
    {"key": "s12", "kind": "app.action", "app": "ghl", "op": "create_task", "label": "12 - Add Task Due in 1 Day", "section": "internal", "params": {"title": "REFERENCE task: call {{contact.first_name}}", "due_in_days": 1, "assign_to": "the contact's assigned user"}},
    {"key": "s13", "kind": "app.action", "app": "ghl", "op": "manual_action", "label": "13 - Manual Action Call as Add Note", "section": "internal", "params": {"type": "call", "title": "REFERENCE manual call title", "instructions": "REFERENCE manual call instructions: call {{contact.phone}}."}},
    {"key": "s14", "kind": "app.action", "app": "ghl", "op": "call", "label": "14 - Call With Whisper", "section": "internal", "params": {"whisper": "REFERENCE whisper: connecting you to {{contact.first_name}}.", "timeout_seconds": 25}},
    {"key": "s15", "kind": "app.action", "app": "ghl", "op": "update_contact_field", "label": "15 - Update Contact Field Call Notes", "section": "misc", "params": {"field": "Call Notes", "value": "REFERENCE call notes value"}},
    {"key": "s16", "kind": "app.action", "app": "ghl", "op": "assign_user", "label": "16 - Assign to User Round Robin", "section": "misc", "params": {}},
    {"key": "s17", "kind": "app.action", "app": "ghl", "op": "webhook", "label": "17 - Webhook POST", "section": "misc", "params": {"url": "https://example.com/ghl-reference-test", "method": "POST"}},
    {"key": "s18", "kind": "app.action", "app": "ghl", "op": "ai_step", "label": "18 - AI Step Prompt Filled", "section": "misc", "params": {"prompt": "REFERENCE AI prompt: summarise {{contact.call_notes}} in one sentence."}},
    {"key": "s19", "kind": "app.action", "app": "ghl", "op": "add_to_workflow", "label": "19 - Add to Workflow Sales Request Follow-Up", "section": "misc", "params": {"workflow": "Your Sales Request Follow-Up System"}},
    {"key": "s20", "kind": "app.action", "app": "ghl", "op": "remove_from_workflow", "label": "20 - Remove from Workflow Sales Request Follow-Up", "section": "misc", "params": {"workflow": "Your Sales Request Follow-Up System"}},
    {"key": "s21", "kind": "app.action", "app": "ghl", "op": "send_review_request", "label": "21 - Send Review Request", "section": "misc", "params": {}},
    {"key": "s22", "kind": "app.action", "app": "ghl", "op": "goal", "label": "22 - Goal Tag Added call-cancelled", "section": "logic", "params": {"goal_type": "tag_added", "tag": "call-cancelled", "if_not_met": "end"}},
    {"key": "s23", "kind": "flow.branch", "label": "23 - If Else Has Tag call-booked", "section": "logic", "params": {"condition": "contact tag includes \"call-booked\"", "true_label": "Has call-booked"}},
    {"key": "s24", "kind": "app.action", "app": "ghl", "op": "update_opportunity", "label": "24 - Yes Branch Update Opportunity to Showed", "section": "logic", "params": {"pipeline": "Call Booked Pipeline", "stage": "Showed", "status": "open"}},
    {"key": "s25", "kind": "app.action", "app": "ghl", "op": "go_to", "label": "25 - Yes Branch Go To Step 27", "section": "logic", "params": {"target": "27 - No Branch Send SMS Last Step"}},
    {"key": "s26", "kind": "app.action", "app": "ghl", "op": "remove_tag", "label": "26 - No Branch Remove Tag call-booked", "section": "logic", "params": {"tag": "call-booked"}},
    {"key": "s27", "kind": "app.action", "app": "ghl", "op": "send_sms", "label": "27 - No Branch Send SMS Last Step", "section": "logic", "params": {"message": "REFERENCE last SMS in the None branch."}},
    {"key": "s28", "kind": "flow.noop", "label": "28 - End Nothing After Step 27", "section": "logic", "params": {}}
  ],
  "edges": [
