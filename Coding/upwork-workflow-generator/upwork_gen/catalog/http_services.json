      "setup": "API token and board id",
      "default_op": "create_item",
      "operations": {
        "update_columns": {
          "method": "POST",
          "path": "",
          "body": {
            "query": "mutation ($board: ID!, $item: ID!, $cols: JSON!) { change_multiple_column_values (board_id: $board, item_id: $item, column_values: $cols) { id } }",
            "variables": {
              "board": "{config:monday_board_id}",
              "item": "{field:item_id}",
              "cols": "{js:JSON.stringify(JSON.stringify({ status: { label: $json.status } }))}"
            }
          },
          "keywords": {
            "update": 3,
            "write back": 3,
            "status": 2,
            "move": 1
          }
        },
        "create_item": {
          "method": "POST",
          "path": "",
          "body": {
            "query": "mutation ($board: ID!, $name: String!) { create_item (board_id: $board, item_name: $name) { id } }",
            "variables": {
              "board": "{config:monday_board_id}",
              "name": "{field:name}"
            }
          },
          "keywords": {
            "item": 3,
            "board": 2,
            "create": 1,
            "add": 1
          }
        }
      }
    },
