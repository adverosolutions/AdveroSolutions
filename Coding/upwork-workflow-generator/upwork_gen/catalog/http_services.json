{
  "_meta": {
    "purpose": "Real base URLs, auth styles and representative endpoints for the HTTP Request nodes the n8n compiler emits. A net.http node (or an app.action that fell back to HTTP) resolves a service from the `service` shorthand, its `app`, or the service name in its label, then picks an operation by label keywords.",
    "tokens": {
      "{config:KEY}": "A Config node reference when the spec has `config` (the key is added to the Config node if missing), else the service's placeholder for KEY, e.g. PASTE-YOUR-GHL-API-KEY. Never a real secret.",
      "{field:NAME}": "{{ $json.NAME }}, with NAME swapped for a matching sample key where one exists (contact_id -> ghl_contact_id).",
      "{json:NAME}": "Unquoted {{ JSON.stringify($json.NAME) }} inside a JSON body, for arrays and objects.",
      "{js:EXPR}": "Unquoted {{ EXPR }} inside a JSON body.",
      "__sample_row__": "As a whole body: one key per scalar input_sample field."
    },
    "rule": "Only endpoints we are confident exist. When unsure of an operation, it is left out rather than invented.",
    "aliases": "Matched on word boundaries anywhere in the label. Never add an alias that is ordinary English ('high level' matched 'Send a High Level Summary'). strict_aliases (ordinary English words such as 'instantly' or 'monday') only match as the node's app, the `service` shorthand, 'Alias:' in the label, or the first word after the step prefix."
  },
  "services": {
    "gohighlevel": {
      "name": "GoHighLevel",
      "aliases": [
        "gohighlevel",
        "go high level",
        "highlevel",
        "ghl",
        "leadconnector"
      ],
      "strict_aliases": [],
      "base_url": "https://services.leadconnectorhq.com",
      "auth": {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {config:ghl_api_key}"
      },
      "headers": {
        "Version": "2021-07-28",
        "Accept": "application/json"
      },
      "placeholders": {
        "ghl_api_key": "PASTE-YOUR-GHL-API-KEY",
        "ghl_location_id": "PASTE-YOUR-GHL-LOCATION-ID",
        "ghl_pipeline_id": "PASTE-YOUR-GHL-PIPELINE-ID",
        "ghl_stage_id": "PASTE-YOUR-GHL-STAGE-ID",
        "ghl_workflow_id": "PASTE-YOUR-GHL-WORKFLOW-ID"
      },
      "setup": "Private Integration token and location id",
      "default_op": "upsert_contact",
      "operations": {
        "lookup_contact": {
          "method": "GET",
          "path": "/contacts/search/duplicate",
          "query": {
            "locationId": "{config:ghl_location_id}",
            "email": "{field:email}"
          },
          "keywords": {
            "look up": 3,
            "lookup": 3,
            "search": 3,
            "find": 2,
            "existing": 2,
            "duplicate": 3,
            "exists": 2,
            "check": 1
          },
          "id_path": "contact.id"
        },
        "upsert_contact": {
          "method": "POST",
          "path": "/contacts/upsert",
          "body": {
            "locationId": "{config:ghl_location_id}",
            "firstName": "{field:first_name}",
            "lastName": "{field:last_name}",
            "email": "{field:email}",
            "phone": "{field:phone}",
            "source": "{field:source}"
          },
          "keywords": {
            "upsert": 3,
            "create or update": 3,
            "create contact": 3,
            "update contact": 3,
            "add contact": 3,
            "contact": 1,
            "custom field": 2
          },
          "id_path": "contact.id"
        },
        "remove_tag": {
          "method": "DELETE",
          "path": "/contacts/{field:contact_id}/tags",
          "body": {
            "tags": "{json:tags}"
          },
          "keywords": {
            "remove tag": 4,
            "untag": 4,
            "remove the tag": 4
          }
        },
        "add_tag": {
          "method": "POST",
          "path": "/contacts/{field:contact_id}/tags",
          "body": {
            "tags": "{json:tags}"
          },
          "keywords": {
            "tag": 3
          }
        },
        "create_opportunity": {
          "method": "POST",
          "path": "/opportunities/",
          "body": {
            "locationId": "{config:ghl_location_id}",
            "pipelineId": "{config:ghl_pipeline_id}",
            "pipelineStageId": "{config:ghl_stage_id}",
            "contactId": "{field:contact_id}",
            "name": "{field:name}",
            "status": "open"
          },
          "keywords": {
            "opportunit": 3,
            "pipeline": 3,
            "stage": 2,
            "deal": 2
          },
          "id_path": "opportunity.id"
        },
        "add_note": {
          "method": "POST",
          "path": "/contacts/{field:contact_id}/notes",
          "body": {
            "body": "{field:summary}"
          },
          "keywords": {
            "note": 3
          }
        },
        "remove_from_workflow": {
          "method": "DELETE",
          "path": "/contacts/{field:contact_id}/workflow/{config:ghl_workflow_id}",
          "keywords": {
            "remove": 3,
            "unenroll": 3,
            "stop": 2,
            "workflow": 1
          }
        },
        "add_to_workflow": {
          "method": "POST",
          "path": "/contacts/{field:contact_id}/workflow/{config:ghl_workflow_id}",
          "keywords": {
            "enroll": 3,
            "workflow": 3,
            "sequence": 2,
            "follow-up": 1,
            "nurture": 2
          }
        },
        "send_message": {
          "method": "POST",
          "path": "/conversations/messages",
          "headers": {
            "Version": "2021-04-15"
          },
          "body": {
            "type": "SMS",
            "contactId": "{field:contact_id}",
            "message": "{field:message}"
          },
          "keywords": {
            "message": 3,
            "sms": 3,
            "text": 2,
            "reply": 2,
            "send": 1,
            "ask": 1
          }
        }
      }
    },
