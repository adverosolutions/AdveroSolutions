{
  "title": "Your Google Sheets Sync, Fixed and Bulletproofed",
  "platform": "n8n",
  "sections": [
    {
      "key": "intake",
      "label": "1 - THE DATA COMES IN",
      "color": 0,
      "note": "Whatever feeds the sheet lands here, one record at a time, so every run can be replayed against the exact payload that broke it."
    },
    {
      "key": "causes",
      "label": "2 - THE FIVE THINGS THAT BREAK SHEETS SYNCS",
      "color": 0,
      "note": "Wrong types, empty rows, a renamed tab, a moved header, and appending when it should update. Each one gets its own guard before a single cell is written."
    },
    {
      "key": "write",
      "label": "3 - WRITE IT THE RIGHT WAY",
      "color": 0,
      "note": "Matched on a key column, so the same record updates its row instead of quietly stacking duplicates at the bottom of the sheet."
    },
    {
      "key": "guards",
      "label": "4 - QUOTA AND AUTH GUARDS",
      "color": 0,
      "note": "Google throttles bursts and OAuth tokens expire. A failed write backs off, refreshes the credential, and retries instead of dying silently."
    },
    {
      "key": "proof",
      "label": "5 - PROVE IT KEEPS WORKING",
      "color": 0,
      "note": "A heartbeat row on a log tab shows the sync is alive, and any node that fails names itself and the row it was on."
    }
  ],
  "nodes": [
    {
      "key": "hook",
      "kind": "trigger.webhook",
      "label": "1 - Record Arrives",
      "section": "intake"
    },
    {
