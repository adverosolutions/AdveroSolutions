{
  "title": "Multi-Source Lead Capture → Claude Qualification → GoHighLevel → Route & Notify",
  "platform": "n8n",
  "sections": [
    {
      "key": "capture",
      "label": "1 · CAPTURE",
      "color": 0,
      "note": "Three sources, one lead shape. Adding a fourth source later means one new trigger into the same merge — never a second copy of the pipeline."
    },
    {
      "key": "qualify",
      "label": "2 · ENRICH & QUALIFY",
      "color": 0,
      "note": "Enrichment runs before Claude, so scoring sees company size and industry rather than only what the form collected. Score, reason and summary come back against a fixed schema."
    },
    {
      "key": "crm",
      "label": "3 · CRM & ROUTING",
      "color": 0,
      "note": "Contact, company and opportunity written as one unit, then routed on territory and current rep capacity — rules live in a sheet, not in the workflow."
    },
    {
      "key": "notify",
      "label": "4 · NOTIFY, SEQUENCE & LOG",
      "color": 0,
      "note": "The rep gets the summary in Slack before they open the CRM. Every lead lands in reporting whether it qualified or not — the disqualified ones are how the scoring gets tuned."
    }
  ],
  "nodes": [
    {
      "key": "fb",
