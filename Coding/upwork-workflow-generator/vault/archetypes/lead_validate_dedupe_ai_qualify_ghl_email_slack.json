{
  "title": "Lead → Validate → Dedupe → AI Qualify → GHL → Email → Slack",
  "platform": "n8n",
  "sections": [
    {
      "key": "intake",
      "label": "1 · CAPTURE AND VALIDATE THE LEAD",
      "color": 0,
      "note": "One lead comes in from a form or any webhook. Missing email or a bad phone throws with a clear reason, so nothing half-broken reaches the CRM."
    },
    {
      "key": "dedupe",
      "label": "2 · CHECK THE CRM FOR A DUPLICATE",
      "color": 0,
      "note": "Search GoHighLevel by email before creating anything. Swapping to Zoho CRM is the same two HTTP calls with different endpoints."
    },
    {
      "key": "qualify",
      "label": "3 · QUALIFY AND PUSH TO THE CRM",
      "color": 0,
      "note": "Claude reads the lead and returns hot, warm, or cold plus a one-line reason. The contact is created with that tag so sales can filter on it."
    },
    {
      "key": "followup",
      "label": "4 · FOLLOW UP AND NOTIFY SALES",
      "color": 0,
      "note": "The lead gets a same-minute email. Sales gets one message with the score, the reason, and the CRM link."
    },
    {
      "key": "errors",
      "label": "5 · FAIL LOUDLY IF SOMETHING BREAKS",
      "color": 0,
      "note": "Any node failing anywhere posts an alert with a link to the run. Nothing fails silently."
    }
  ],
  "nodes": [
    {
      "key": "hook",
      "kind": "trigger.webhook",
      "label": "1 · Lead Captured · Form or Webhook",
      "section": "intake"
    },
    {
