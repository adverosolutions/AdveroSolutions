{
  "title": "AI Receptionist — Qualify, Route & Warm Transfer",
  "platform": "n8n",
  "sections": [
    {
      "key": "call",
      "label": "1 · CALL LANDS",
      "color": 0,
      "note": "ElevenLabs answers and posts the live call to n8n. The caller's number is matched against the book of business before the agent speaks, so a known policyholder is greeted by name instead of being asked to spell it."
    },
    {
      "key": "qualify",
      "label": "2 · QUALIFY",
      "color": 0,
      "note": "One pass captures name, policy number, callback number and reason for calling, and decides what the caller actually needs. Structured output means these land as fields the team can act on, not a transcript someone has to read."
    },
    {
      "key": "route",
      "label": "3 · ROUTE",
      "color": 0,
      "note": "Business hours decide the path. In hours, the caller is routed by intent to sales, service or claims. After hours, nothing is dropped — the call becomes a structured message instead of a voicemail nobody transcribes."
    },
    {
      "key": "fulfil",
      "label": "4 · HANDLE",
      "color": 0,
      "note": "Warm transfer hands the human a screen-pop with everything already captured. Simple service requests never reach a person at all — an auto ID card is texted in seconds — and callbacks are booked straight onto the calendar."
    },
    {
      "key": "log",
      "label": "5 · LOG & NOTIFY",
      "color": 0,
      "note": "Every call is written to the agency system with its outcome, and the team gets a summary. After-hours messages land as a morning queue ordered by urgency rather than a stack of voicemails."
    }
  ],
