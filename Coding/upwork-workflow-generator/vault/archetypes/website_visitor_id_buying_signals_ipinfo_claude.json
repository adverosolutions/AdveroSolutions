{
  "title": "Website Visitor ID + Buying Signals: IPinfo, Claude, Salesforce, Slack",
  "platform": "n8n",
  "sections": [
    {
      "key": "visit",
      "label": "1 · IDENTIFY WHO IS ON THE SITE",
      "color": 0,
      "note": "The tracking script posts every page view here. Bots and home ISPs get dropped, real companies get named by their IP."
    },
    {
      "key": "score",
      "label": "2 · SCORE THE VISIT",
      "color": 0,
      "note": "Pages viewed, time on site and a pricing page visit add up to one number. Only hot visits go further."
    },
    {
      "key": "enrich",
      "label": "3 · CLAUDE ENRICHES, SALESFORCE AND SLACK GET IT",
      "color": 0,
      "note": "Claude checks Salesforce over MCP for an existing account, writes a summary, then the account and a Slack alert are created."
    },
    {
      "key": "signals",
      "label": "4 · EVERY MORNING: WATCH THE WEB FOR BUYING SIGNALS",
      "color": 0,
      "note": "Firecrawl pulls the watched sources, Claude reads them for hiring, funding and expansion signals, and a Salesforce task lands on the matching account."
    },
    {
      "key": "errors",
      "label": "5 · FAIL LOUDLY",
      "color": 0,
      "note": "Any node failing anywhere sends a Slack alert with a link to the run. Nothing dies silently on the Mac mini."
    }
  ],
