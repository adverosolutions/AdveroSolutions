{
  "title": "n8n Hardening: Validate, Retry, Fallback, Log, Alert",
  "platform": "n8n",
  "sections": [
    {
      "key": "validate",
      "label": "1 · VALIDATE BEFORE ANYTHING ELSE RUNS",
      "color": 0,
      "note": "A bad record is rejected here with the exact field that is wrong, instead of blowing up three API calls later."
    },
    {
      "key": "call",
      "label": "2 · CALL SYSTEM A, RETRY ON FAILURE",
      "color": 0,
      "note": "A failed call waits and tries again rather than killing the run. The retry count is a setting, not a guess."
    },
    {
      "key": "fallback",
      "label": "3 · FALLBACK WHEN IT KEEPS FAILING",
      "color": 0,
      "note": "Once retries are used up the record is queued for manual retry. Nothing is ever dropped on the floor."
    },
    {
      "key": "write",
      "label": "4 · MAP THE FIELDS AND WRITE TO SYSTEM B",
      "color": 0,
      "note": "One place where field names are translated between the two systems, so a change is a one line edit."
    },
    {
      "key": "alert",
      "label": "5 · LOG EVERY RUN, ALERT ON ANY FAILURE",
      "color": 0,
      "note": "Every run leaves a row you can read. Anything that still breaks pings you with a link to the run."
    }
  ],
  "nodes": [
    {
      "key": "hook",
      "kind": "trigger.webhook",
      "label": "1 · Incoming Record",
      "section": "validate"
    },
    {
      "key": "check",
      "kind": "data.code",
      "label": "2 · Validate Schema and Required Fields",
      "section": "validate"
    },
    {
      "key": "valid",
      "kind": "flow.branch",
      "label": "3 · Is the Record Valid?",
      "section": "validate"
    },
    {
      "key": "reject",
      "kind": "net.respond",
      "label": "4 · Reject With Field Errors",
      "section": "validate"
    },
    {
      "key": "fetch",
      "kind": "net.http",
      "label": "5 · System A: Fetch Related Record",
      "section": "call"
    },
    {
      "key": "ok",
      "kind": "flow.branch",
      "label": "6 · Did the Call Succeed?",
      "section": "call"
    },
    {
      "key": "exhausted",
      "kind": "flow.branch",
      "label": "7 · Are the Retries Used Up?",
      "section": "call"
    },
    {
      "key": "wait",
      "kind": "flow.wait",
      "label": "8 · Back Off 30 Seconds",
      "section": "call"
    },
    {
      "key": "queue",
      "kind": "net.http",
      "label": "9 · Fallback: Queue for Manual Retry",
      "section": "fallback"
    },
    {
      "key": "map",
      "kind": "data.transform",
      "label": "10 · Map Fields Between Systems",
      "section": "write"
    },
    {
      "key": "write",
      "kind": "net.http",
      "label": "11 · System B: Create or Update Record",
      "section": "write"
    },
    {
      "key": "log",
      "kind": "app.action",
      "label": "12 · Run Log: Status, Latency, Retries",
      "app": "googleSheets",
      "op": "append",
      "section": "alert"
    },
    {
      "key": "respond",
      "kind": "net.respond",
      "label": "13 · Return 200 OK",
      "section": "alert"
    },
    {
      "key": "err",
      "kind": "trigger.app",
      "label": "14 · Any Node Fails, Anywhere",
      "app": "n8n",
      "op": "error_trigger",
      "section": "alert"
    },
    {
      "key": "alert",
      "kind": "app.action",
      "label": "15 · Alert With Link to Failed Execution",
      "app": "slack",
      "op": "post",
      "section": "alert"
    }
  ],
  "edges": [
