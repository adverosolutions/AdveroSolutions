{
  "title": "Clay Enrichment → LinkedIn + Email Launch → Recruit CRM Sync → Weekly Health Digest",
  "platform": "n8n",
  "sections": [
    {
      "key": "enrich",
      "label": "1 · CLAY ENRICHMENT & ICP SCORE",
      "color": 0,
      "note": "Pulls newly enriched rows off the Clay table and scores each contact against the ICP before anything else runs."
    },
    {
      "key": "quality",
      "label": "2 · DEDUPE & DATA QUALITY",
      "color": 0,
      "note": "Checks Recruit CRM for an existing contact and drops duplicates, recently-touched records, and rows missing an email or LinkedIn URL."
    },
    {
      "key": "launch",
      "label": "3 · LAUNCH: LINKEDIN + EMAIL",
      "color": 0,
      "note": "Adds the surviving contacts to the LinkedIn campaign and the cold email sequence in parallel."
    },
    {
      "key": "sync",
      "label": "4 · CRM SYNC & REPLY ROUTING",
      "color": 0,
      "note": "Logs every touchpoint back to Recruit CRM and routes inbound replies to pause outreach and move the deal stage."
    },
    {
      "key": "digest",
      "label": "5 · WEEKLY HEALTH DIGEST",
      "color": 0,
      "note": "Rolls up sends, opens, replies and bounce rate every Monday and flags deliverability before it becomes a problem."
    }
  ],
