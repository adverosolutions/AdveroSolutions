{
  "title": "Prospect & Enrich → AI Score & Personalize → Outreach → CRM → Measure Impact",
  "platform": "n8n",
  "sections": [
    {
      "key": "prospect",
      "label": "1 · PROSPECT & ENRICH",
      "color": 0,
      "note": "New prospects get pulled and enriched with firmographic and intent data before anything else touches them."
    },
    {
      "key": "score",
      "label": "2 · AI SCORE & PERSONALIZE",
      "color": 0,
      "note": "One AI step scores fit against the ICP and drafts personalized outreach, only qualified prospects move forward."
    },
    {
      "key": "outreach",
      "label": "3 · OUTREACH",
      "color": 0,
      "note": "Qualified prospects get personalized touches across email and LinkedIn."
    },
    {
      "key": "sync",
      "label": "4 · SYNC TO CRM",
      "color": 0,
      "note": "Every prospect and touch logs to the CRM, so pipeline stage reflects real engagement, not guesswork."
    },
    {
      "key": "measure",
      "label": "5 · MEASURE IMPACT",
      "color": 0,
      "note": "Reply rate, meeting rate, and pipeline generated roll up to the dashboard, and underperformance gets flagged before it wastes a quarter."
    }
  ],
