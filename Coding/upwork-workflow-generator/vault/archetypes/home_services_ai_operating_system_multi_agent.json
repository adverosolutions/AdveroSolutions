{
  "title": "AI Operating System — Data In → Specialized Agents → Insights → Dashboards & Action",
  "platform": "n8n",
  "sections": [
    {
      "key": "sources",
      "label": "1 · DATA ENTERS",
      "color": 0,
      "note": "Every business system feeds in on a continuous sync, marketing spend, CRM, jobs, and financials, so the AI layer sees the whole business, not one slice."
    },
    {
      "key": "connect",
      "label": "2 · CONNECT & ATTRIBUTE",
      "color": 0,
      "note": "Everything lands in one data layer linked by customer, so a lead can be traced to its job and its invoice, that's what makes cost per lead and profitability answerable."
    },
    {
      "key": "agents",
      "label": "3 · SPECIALIZED AGENTS",
      "color": 0,
      "note": "Not one chatbot, a team. Each agent owns one domain and reads only the data it needs, so the answers stay sharp instead of generic."
    },
    {
      "key": "decide",
      "label": "4 · INSIGHTS & DECISIONS",
      "color": 0,
      "note": "An executive agent sits over the team, answers questions like how many roofing leads this month, and flags issues before someone has to notice them."
    },
    {
      "key": "act",
      "label": "5 · DASHBOARDS & ACTION",
      "color": 0,
      "note": "Insights become dashboards for management and alerts and tasks for the team, that's the part that actually saves staff time."
    }
  ],
