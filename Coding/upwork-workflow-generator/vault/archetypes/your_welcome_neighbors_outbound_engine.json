      "section": "clay"
    },
    {
      "key": "waterfall",
      "kind": "net.http",
      "label": "5 - Clay Waterfall: Email From 3 Providers, Then Verify It Is Deliverable",
      "section": "clay"
    },
    {
      "key": "found",
      "kind": "flow.branch",
      "label": "6 - Deliverable and Owner Found?",
      "section": "clay"
