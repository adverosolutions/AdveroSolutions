{
  "title": "Your Welcome Neighbors Outbound Engine",
  "platform": "n8n",
  "sections": [
    {
      "key": "source",
      "label": "1 - SOURCE LOCAL BUSINESSES BY AREA",
      "color": 0,
      "note": "Pick the metro, pull every HVAC, dental, roofing and plumbing business in those zip codes. Nobody uploads a CSV."
    },
    {
      "key": "clay",
      "label": "2 - CLAY ENRICHMENT WATERFALL",
      "color": 0,
      "note": "Clay enriches the business, finds the owner, then runs three email providers in order until one returns a verified address."
    },
    {
      "key": "qualify",
      "label": "3 - QUALIFY AND PERSONALIZE",
      "color": 0,
      "note": "Claude reads their site and Google profile, scores the fit, and writes the first line off what it actually found."
    },
    {
      "key": "campaign",
      "label": "4 - INTO THE CAMPAIGN",
      "color": 0,
      "note": "The lead lands in the campaign for its segment with the variables already filled, and the follow-ups run on schedule."
    },
    {
      "key": "replies",
      "label": "5 - REPLIES, ROUTING AND THE NUMBERS",
      "color": 0,
      "note": "Every reply is read and routed within minutes, and the day's real numbers land in one sheet you can open."
    }
  ],
  "nodes": [
    {
      "key": "sched",
      "kind": "trigger.schedule",
      "label": "1 - Every Weekday at 6am, Next Target Metro",
      "section": "source"
    },
    {
      "key": "maps",
      "kind": "net.http",
      "label": "2 - Google Maps: Pull HVAC, Dental, Roofing and Plumbing Businesses in the Zip Codes",
      "section": "source"
    },
    {
      "key": "enrich",
      "kind": "net.http",
      "label": "3 - Clay: Enrich the Business, Website, Phone, Size and Reviews",
