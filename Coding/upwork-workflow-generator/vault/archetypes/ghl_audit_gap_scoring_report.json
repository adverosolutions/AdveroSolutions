      "key": "diagnose",
      "label": "2 · MAP & DIAGNOSE",
      "color": 0,
      "note": "Maps each workflow's trigger, actions, and exit point, then runs it through three checks a lead can silently fall through."
    },
    {
      "key": "score",
      "label": "3 · SCORE & PRIORITIZE",
      "color": 0,
      "note": "Scores every confirmed gap by lead-flow impact so the fix list is ordered by what actually costs leads, not by what's easiest."
    },
    {
      "key": "deliver",
      "label": "4 · DELIVER REPORT & RECOMMENDATIONS",
      "color": 0,
      "note": "Turns the flagged gaps into specific, named fixes and sends the report rather than a vague punch list."
    }
