{
  "title": "AI Marketing Automation: Acquire, Nurture, Retain, Report",
  "platform": "n8n",
  "sections": [
    {
      "key": "capture",
      "label": "1 · CAPTURE EVERY LEAD AND CUSTOMER EVENT",
      "color": 0,
      "note": "Form fills, purchases and signups all land in one place and get cleaned into the same shape."
    },
    {
      "key": "decide",
      "label": "2 · DECIDE WHO THEY ARE AND WHAT THEY GET NEXT",
      "color": 0,
      "note": "Claude looks the person up in the CRM and picks the next best message instead of a fixed drip."
    },
    {
      "key": "acquisition",
      "label": "3 · ACQUISITION: WELCOME THE NEW ONES",
      "color": 0,
      "note": "Brand new contacts get the welcome and the first offer straight away, while interest is highest."
    },
    {
      "key": "journey",
      "label": "4 · NURTURE AND RETENTION: KEEP THEM MOVING",
      "color": 0,
      "note": "Nurture loops a personalized touch every two days until they engage, capped so nobody gets spammed. Quiet customers get a win back instead."
    },
    {
      "key": "measure",
      "label": "5 · MEASURE, REPORT, AND CATCH FAILURES",
      "color": 0,
      "note": "Every send updates the CRM and logs a metrics row, and Monday morning the numbers land in Slack."
    }
  ],
