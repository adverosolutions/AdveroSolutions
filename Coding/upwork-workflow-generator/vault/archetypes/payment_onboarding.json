{
  "archetype": "payment_onboarding",
  "title": "Stripe Payment → Provision → Onboarding Sequence",
  "platform": "n8n",
  "sections": [
    { "key": "paid",   "label": "1 · PAYMENT",     "note": "Stripe fires on successful payment. The signature is verified and the event deduplicated before anything is provisioned — webhooks retry, and provisioning twice is worse than not at all." },
    { "key": "setup",  "label": "2 · PROVISION",   "note": "The account is created, the plan entitlements applied, and the workspace seeded. Failures here alert immediately, because a customer who paid and got nothing is the most expensive kind of bug." },
    { "key": "route",  "label": "3 · BY PLAN",     "note": "Enterprise buyers get a human — a real onboarding call booked with their CSM. Self-serve plans get the automated sequence. The split is by plan value, not by guesswork." },
    { "key": "welcome","label": "4 · ONBOARD",     "note": "Welcome email with credentials goes immediately, then a paced sequence over the first two weeks tied to activation milestones rather than a fixed drip everyone gets regardless of usage." }
  ],
  "nodes": [
    { "key": "hook",    "kind": "trigger.webhook", "label": "Stripe · payment_succeeded", "section": "paid" },
    { "key": "verify",  "kind": "data.filter", "label": "Verify & Dedupe Event", "section": "paid" },
    { "key": "customer","kind": "app.action", "app": "stripe", "op": "get", "label": "Fetch Customer & Plan", "section": "paid" },
    { "key": "account", "kind": "net.http", "label": "Provision Account", "section": "setup" },
    { "key": "ok",      "kind": "flow.branch", "label": "Provisioned?", "section": "setup" },
    { "key": "alert",   "kind": "app.action", "app": "slack", "op": "post", "label": "Alert #provisioning", "section": "setup" },
    { "key": "plan",    "kind": "flow.switch", "label": "Plan Tier", "section": "route" },
    { "key": "csm",     "kind": "app.action", "app": "slack", "op": "post", "label": "Assign a CSM", "section": "route" },
    { "key": "welcome", "kind": "app.action", "app": "gmail", "op": "send", "label": "Welcome + Credentials", "section": "welcome" },
    { "key": "wait",    "kind": "flow.wait", "label": "Wait 3 Days", "section": "welcome" },
    { "key": "nudge",   "kind": "app.action", "app": "gmail", "op": "send", "label": "Activation Nudge", "section": "welcome" },
    { "key": "crm",     "kind": "app.action", "app": "hubspot", "op": "create_contact", "label": "Sync to CRM", "section": "welcome" }
  ],
  "edges": [
    { "from": "hook", "to": "verify" },
    { "from": "verify", "to": "customer" },
    { "from": "customer", "to": "account" },
    { "from": "account", "to": "ok" },
    { "from": "ok", "to": "plan", "branch": "true" },
    { "from": "ok", "to": "alert", "branch": "false" },
    { "from": "plan", "to": "csm", "branch": "enterprise" },
    { "from": "plan", "to": "welcome", "branch": "self_serve" },
    { "from": "csm", "to": "welcome" },
    { "from": "welcome", "to": "wait" },
    { "from": "wait", "to": "nudge" },
    { "from": "nudge", "to": "crm" }
  ],
