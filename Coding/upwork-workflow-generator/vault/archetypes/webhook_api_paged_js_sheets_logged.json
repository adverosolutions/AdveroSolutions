{
  "title": "Webhook → External API (Paged, Authed, Rate-Limited) → JavaScript Transform → Google Sheets, With Logging",
  "platform": "n8n",
  "sections": [
    {
      "key": "in",
      "label": "1 · WEBHOOK IN",
      "color": 0,
      "note": "The request comes in and gets validated in JavaScript before anything else runs, so a bad payload fails loudly here instead of quietly later."
    },
    {
      "key": "api",
      "label": "2 · EXTERNAL API, DONE PROPERLY",
      "color": 0,
      "note": "Auth on the call, backoff on a rate limit, and it keeps paging until the API says it's done. That's the part that usually gets skipped and breaks at 10x volume."
    },
    {
      "key": "sheet",
      "label": "3 · LOG TO SHEETS",
      "color": 0,
      "note": "Every page gets normalized into the same clean rows in JavaScript, appended once, and the caller gets a real response with the row count."
    },
    {
      "key": "ops",
      "label": "4 · ERRORS & RUN LOG",
      "color": 0,
      "note": "One run-log row per execution and an alert with the step and the error when something fails. Small on purpose, nothing here is more than the task needs."
    }
  ],
  "nodes": [
    {
