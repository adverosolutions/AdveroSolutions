{
  "title": "Apollo → MillionVerifier → Segment Router → Instantly + HighLevel",
  "platform": "n8n",
  "sections": [
    {
      "key": "source",
      "label": "1 · LEAD SOURCING",
      "color": 0,
      "note": "Pulls each Apollo saved search on a schedule and tags every lead with its source segment so audiences never mix."
    },
    {
      "key": "verify",
      "label": "2 · VERIFY & FILTER",
      "color": 0,
      "note": "Every email goes through MillionVerifier. Only clean, deliverable addresses move on — protects sender reputation."
    },
    {
      "key": "route",
      "label": "3 · DEDUPE & SEGMENT ROUTER",
      "color": 0,
      "note": "Checks the master log so nobody gets contacted twice, then routes each lead to its own campaign lane."
    },
    {
      "key": "deliver",
      "label": "4 · CAMPAIGNS & CRM SYNC",
      "color": 0,
      "note": "Leads land in the right Instantly campaign and sync into HighLevel with the segment recorded. Add a new segment by duplicating one lane."
    }
  ],
