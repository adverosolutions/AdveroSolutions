{
  "title": "Your Commercial Cleaning Prospecting Engine",
  "platform": "n8n",
  "sections": [
    {
      "key": "discover",
      "label": "1 - DISCOVER",
      "color": 0,
      "note": "Outscraper works one zip cluster a morning and pulls the buildings that actually buy cleaning. Nobody uploads a list."
    },
    {
      "key": "enrich",
      "label": "2 - ENRICH",
      "color": 0,
      "note": "Apollo turns a building into a named facilities or office manager with a verified email. No name, no guessing, it parks."
    },
    {
      "key": "research",
      "label": "3 - RESEARCH AND SCORE",
      "color": 0,
      "note": "The agent reads the site and the Google profile, then scores the account on size, foot traffic, vendor signals and hiring."
    },
    {
      "key": "approval",
      "label": "4 - HUMAN APPROVAL, THEN THE CRM",
      "color": 0,
      "note": "Nothing reaches HighLevel until a human says yes. The morning list posts to Slack, one tap approves, one tap rejects with a reason."
    },
    {
      "key": "logs",
      "label": "5 - LOGS, DEDUPE, ALERTS",
      "color": 0,
      "note": "Postgres is the dedupe key, by place id and normalized phone, so the same building never shows up twice. Every failure names its node."
    }
  ],
  "nodes": [
    {
      "key": "sched",
      "kind": "trigger.schedule",
      "label": "1 - Every Weekday at 5am, Next Zip Cluster",
      "section": "discover"
    },
    {
      "key": "outscraper",
      "kind": "net.http",
      "label": "2 - Outscraper: Offices, Medical, Gyms, Schools, Warehouses Over 5,000 Sq Ft",
      "section": "discover"
    },
    {
      "key": "normalize",
      "kind": "data.transform",
      "label": "3 - Normalize: Name, Address, Phone, Category, Reviews",
      "section": "discover"
    },
    {
      "key": "seen",
      "kind": "app.action",
      "label": "4 - Seen Before? Check the Prospect Database",
      "app": "postgres",
      "op": "select",
      "section": "discover"
    },
    {
      "key": "isnew",
      "kind": "flow.branch",
      "label": "5 - New Prospect?",
      "section": "discover"
    },
    {
      "key": "skip",
      "kind": "flow.noop",
      "label": "5b - Skip, Already Known",
      "section": "discover"
    },
    {
      "key": "apollo",
      "kind": "net.http",
      "label": "6 - Apollo: Find the Facilities or Office Manager and Verified Email",
      "section": "enrich"
    },
    {
      "key": "dmfound",
      "kind": "flow.branch",
      "label": "7 - Decision Maker Found?",
      "section": "enrich"
    },
    {
      "key": "manual",
      "kind": "app.action",
      "label": "7b - Park for Manual Enrichment",
      "app": "postgres",
      "op": "insert",
      "section": "enrich"
    },
    {
      "key": "agent",
      "kind": "ai.agent",
      "label": "8 - Research Agent: Size, Foot Traffic, Current Vendor Signals, Hiring",
      "section": "research"
    },
    {
      "key": "model",
      "kind": "ai.model",
      "label": "GPT-4o",
      "app": "openai",
      "parent": "agent",
      "port": "ai_languageModel"
    },
    {
      "key": "tool",
      "kind": "ai.tool",
      "label": "Read the Website and Google Profile",
      "parent": "agent",
      "port": "ai_tool"
    },
    {
      "key": "parser",
      "kind": "ai.parser",
      "label": "Score 1 to 10, Reason, Best Angle",
      "parent": "agent",
      "port": "ai_outputParser"
    },
    {
      "key": "gate",
      "kind": "flow.branch",
      "label": "9 - Score 7 or Higher?",
      "section": "research"
    },
    {
      "key": "lowpri",
      "kind": "app.action",
      "label": "9b - Store as Low Priority",
      "app": "postgres",
      "op": "insert",
      "section": "research"
    },
    {
      "key": "post",
      "kind": "app.action",
      "label": "10 - Post the Top Prospects to #approvals With Approve and Reject Buttons",
      "app": "slack",
      "op": "post",
      "section": "approval"
    },
    {
      "key": "decision",
      "kind": "trigger.webhook",
      "label": "11 - Approval Decision Comes Back",
      "section": "approval"
    },
    {
      "key": "approved",
      "kind": "flow.branch",
      "label": "12 - Approved?",
      "section": "approval"
    },
    {
      "key": "rejected",
      "kind": "app.action",
      "label": "12b - Rejected, With the Reason, Feeds the Scoring Prompt",
      "app": "postgres",
      "op": "insert",
      "section": "approval"
    },
    {
      "key": "ghlcontact",
      "kind": "net.http",
      "label": "13 - HighLevel: Create Contact, Tag, Opportunity in Prospecting Pipeline",
      "section": "approval"
    },
    {
      "key": "ghlworkflow",
      "kind": "net.http",
      "label": "14 - HighLevel: Trigger the Sales Follow-Up Workflow",
      "section": "approval"
    },
    {
      "key": "record",
      "kind": "app.action",
      "label": "15 - Write the Prospect Record With Score, Source, Approval",
      "app": "postgres",
      "op": "insert",
      "section": "logs"
    },
    {
      "key": "err",
      "kind": "trigger.app",
      "label": "16 - Any Step Fails",
      "app": "n8n",
      "op": "error_trigger",
      "section": "logs"
    },
    {
      "key": "alert",
      "kind": "app.action",
      "label": "17 - Alert With the Failing Node",
      "app": "slack",
      "op": "post",
      "section": "logs"
    }
  ],
