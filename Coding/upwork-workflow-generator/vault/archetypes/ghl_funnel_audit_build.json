      "label": "Create or Update Contact",
      "app": "gohighlevel",
      "op": "create",
      "section": "optin",
      "notes": "Matched on phone, then email — the tagging strategy is worthless if the same person exists twice."
    },
    {
      "key": "tag",
      "kind": "data.transform",
      "label": "Apply Source, Offer & Interest Tags",
      "section": "optin"
    },
    {
      "key": "pipe",
