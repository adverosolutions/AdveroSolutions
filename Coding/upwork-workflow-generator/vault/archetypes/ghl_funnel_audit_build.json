{
  "title": "Opt-In → Sales Page → Upsell / Downsell → Pipeline",
  "platform": "gohighlevel",
  "sections": [
    {
      "key": "optin",
      "label": "1 · OPT-IN",
      "color": 0,
      "note": "One contact record from the first touch, tagged by source and interest at the moment of capture — retagging later never reconstructs what you did not record."
    },
    {
      "key": "sales",
      "label": "2 · SALES PAGE",
      "color": 0,
      "note": "The sequence carries the offer while the pipeline stage tracks it, so the funnel and the CRM never disagree about where someone is."
    },
    {
      "key": "offer",
      "label": "3 · UPSELL / DOWNSELL",
      "color": 0,
      "note": "The branch every funnel needs and most skip: buyers see the upsell, non-buyers see a downsell rather than falling into the same nurture as a cold opt-in."
    },
    {
      "key": "sync",
      "label": "4 · SYNC",
      "color": 0,
      "note": "The Zapier hand-off, scoped deliberately — only where GoHighLevel has no native path, so it stays one integration to maintain instead of six."
    }
  ],
  "nodes": [
    {
      "key": "hook",
      "kind": "trigger.form",
      "label": "Opt-In Form Submitted",
      "section": "optin"
    },
    {
      "key": "contact",
