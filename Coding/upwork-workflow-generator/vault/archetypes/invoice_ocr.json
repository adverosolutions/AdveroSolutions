{
  "archetype": "invoice_ocr",
  "title": "Invoice Inbox → OCR → Coded & Approved → Accounting",
  "platform": "n8n",
  "sections": [
    { "key": "intake",  "label": "1 · CAPTURE",     "note": "Invoices arrive by email. The PDF is pulled off the message and its text extracted before anything is read, so scans and native PDFs both work." },
    { "key": "extract", "label": "2 · EXTRACT",     "note": "Vendor, invoice number, dates, line items, tax and total are read into a fixed schema. The structured output parser means a missing field fails loudly rather than silently becoming null in your ledger." },
    { "key": "check",   "label": "3 · APPROVAL",    "note": "Anything above the approval threshold, or from a vendor not seen before, is routed to a human in Slack with the extracted values attached. Everything else posts straight through." },
    { "key": "post",    "label": "4 · POST & FILE", "note": "The bill is created in accounting with line items coded to the right account, the original PDF is filed in Drive against the vendor, and the sender gets a confirmation with the reference number." }
  ],
  "nodes": [
    { "key": "email",   "kind": "trigger.email", "label": "New Invoice Email", "section": "intake" },
