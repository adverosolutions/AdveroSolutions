    { "key": "parser",  "kind": "ai.parser", "label": "Invoice Schema", "parent": "agent" },
    { "key": "gate",    "kind": "flow.branch", "label": "Over $5,000?", "section": "check" },
    { "key": "approve", "kind": "app.action", "app": "slack", "op": "post", "label": "Request Approval", "section": "check" },
    { "key": "book",    "kind": "app.action", "app": "quickbooks", "op": "create", "label": "Create Bill", "section": "post" },
    { "key": "file",    "kind": "app.action", "app": "googleDrive", "op": "upload", "label": "File Original PDF", "section": "post" },
    { "key": "confirm", "kind": "app.action", "app": "gmail", "op": "reply", "label": "Confirm to Sender", "section": "post" }
  ],
