{
  "title": "Content Calendar → AI Repurpose → 5-Platform Publish → Performance Tracking",
  "platform": "n8n",
  "sections": [
    {
      "key": "queue",
      "label": "1 · CONTENT CALENDAR & QUEUE",
      "color": 0,
      "note": "Checks the calendar every hour for posts due to go out, and only touches ones marked approved."
    },
    {
      "key": "repurpose",
      "label": "2 · REPURPOSE FOR EACH PLATFORM",
      "color": 0,
      "note": "One base piece of content gets reshaped into each platform's own format and tone before anything publishes."
    },
    {
      "key": "publish",
      "label": "3 · PUBLISH ACROSS PLATFORMS",
      "color": 0,
      "note": "Fans out to all five platforms in parallel so one slow API doesn't hold up the others."
    },
    {
      "key": "confirm",
      "label": "4 · CONFIRM & LOG",
      "color": 0,
      "note": "Every publish result gets checked before the calendar is updated, so a silent failure never gets logged as a success."
    },
    {
      "key": "track",
      "label": "5 · PERFORMANCE TRACKING",
      "color": 0,
      "note": "Pulls engagement daily from every platform and writes it straight back to the same calendar record."
    }
  ],
  "nodes": [
    {
      "key": "trig",
      "kind": "trigger.schedule",
      "label": "Check for Scheduled Posts Every Hour",
      "section": "queue"
    },
    {
      "key": "pull_calendar",
      "kind": "app.action",
      "label": "Pull Posts Due to Publish from the Content Calendar",
      "app": "airtable",
      "op": "list_records",
      "section": "queue"
    },
    {
      "key": "approved_branch",
      "kind": "flow.branch",
      "label": "Post Marked Approved and Ready?",
      "section": "queue"
    },
    {
      "key": "repurpose_agent",
      "kind": "ai.agent",
      "label": "Repurpose Base Content for Each Platform's Format and Tone",
      "section": "repurpose"
    },
    {
      "key": "repurpose_model",
      "kind": "ai.model",
      "label": "GPT-4.1",
      "app": "openai",
      "parent": "repurpose_agent",
      "port": "ai_languageModel"
    },
    {
      "key": "fb_post",
      "kind": "app.action",
      "label": "Publish to Facebook Page",
      "app": "facebook",
      "op": "create_post",
      "section": "publish"
    },
    {
      "key": "ig_post",
      "kind": "app.action",
      "label": "Publish to Instagram",
      "app": "instagram",
      "op": "create_post",
      "section": "publish"
    },
    {
      "key": "tiktok_post",
      "kind": "app.action",
      "label": "Publish to TikTok",
      "app": "tiktok",
      "op": "create_post",
      "section": "publish"
    },
    {
      "key": "li_post",
      "kind": "app.action",
      "label": "Publish to LinkedIn",
      "app": "linkedin",
      "op": "create_post",
      "section": "publish"
    },
    {
      "key": "tw_post",
      "kind": "app.action",
      "label": "Publish to X · Twitter",
      "app": "twitter",
      "op": "create_tweet",
      "section": "publish"
    },
    {
      "key": "merge_results",
      "kind": "data.merge",
      "label": "Merge Publish Results Across All Platforms",
      "section": "publish"
    },
    {
      "key": "publish_check",
      "kind": "flow.branch",
      "label": "Every Platform Published Successfully?",
      "section": "confirm"
    },
    {
      "key": "log_status",
      "kind": "app.action",
      "label": "Log Post URLs and Status Back to the Calendar",
      "app": "airtable",
      "op": "update_record",
      "section": "confirm"
    },
    {
      "key": "alert_fail",
      "kind": "app.action",
      "label": "Alert: Publish Failed on One or More Platforms",
      "app": "slack",
      "op": "post",
      "section": "confirm"
    },
    {
      "key": "perf_trig",
      "kind": "trigger.schedule",
      "label": "Daily Performance Pull",
      "section": "track"
    },
    {
      "key": "fb_insights",
      "kind": "app.action",
      "label": "Pull Facebook Post Engagement",
      "app": "facebook",
      "op": "get_insights",
      "section": "track"
    },
    {
      "key": "ig_insights",
      "kind": "app.action",
      "label": "Pull Instagram Post Engagement",
      "app": "instagram",
      "op": "get_insights",
      "section": "track"
    },
    {
      "key": "tiktok_insights",
      "kind": "app.action",
      "label": "Pull TikTok Video Metrics",
      "app": "tiktok",
      "op": "get_metrics",
      "section": "track"
    },
    {
      "key": "li_insights",
      "kind": "app.action",
      "label": "Pull LinkedIn Post Metrics",
      "app": "linkedin",
      "op": "get_metrics",
      "section": "track"
    },
    {
      "key": "tw_insights",
      "kind": "app.action",
      "label": "Pull X · Twitter Post Metrics",
      "app": "twitter",
      "op": "get_metrics",
      "section": "track"
    },
    {
      "key": "aggregate_perf",
      "kind": "data.aggregate",
      "label": "Aggregate Likes, Comments, Shares, and Clicks by Post",
      "section": "track"
    },
    {
      "key": "write_perf",
      "kind": "app.action",
      "label": "Write Performance Data Back to the Calendar",
      "app": "airtable",
      "op": "update_record",
      "section": "track"
    }
  ],
