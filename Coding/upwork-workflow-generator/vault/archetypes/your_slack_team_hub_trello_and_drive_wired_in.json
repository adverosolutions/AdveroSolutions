{
  "title": "Your Slack Team Hub - Trello and Drive Wired In",
  "platform": "make",
  "sections": [
    {
      "key": "events",
      "label": "1 - TRELLO AND DRIVE EVENTS COME IN",
      "color": 0,
      "note": "Two ways in. A Trello card is created or moved to a new list, or a file lands in a watched Drive folder. Make allows one trigger per scenario, so this ships as two scenarios that share everything downstream."
    },
    {
      "key": "route",
      "label": "2 - ROUTE TO THE RIGHT TEAM CHANNEL",
      "color": 0,
      "note": "One table holds team to channel. The board or list name on a Trello card, or the folder name on a Drive file, picks the arm. Anything unrecognised falls to the default arm so nothing is lost."
    },
    {
      "key": "post",
      "label": "3 - POST TO SLACK",
      "color": 0,
      "note": "The message is built once, then posted into the private channel for that team. Card updates and file uploads read differently, so each gets its own wording and its own link back."
    },
    {
      "key": "reliable",
      "label": "4 - KEEP IT RELIABLE",
      "color": 0,
      "note": "Every post is checked. A refused post alerts ops instead of vanishing, and every notification lands in an audit sheet so you can prove what fired and when."
    }
  ],
  "nodes": [
    {
      "key": "hook",
      "kind": "trigger.webhook",
      "label": "1 - Trello Card or Drive File Event Arrives",
      "section": "events"
    },
    {
      "key": "map",
      "kind": "data.transform",
      "label": "2 - Private Channel Map",
      "section": "route"
    },
    {
      "key": "pick",
      "kind": "data.transform",
      "label": "3 - Pick the Team Channel From the Map",
      "section": "route",
      "notes": "design -> #team-design, editing -> #team-editing, writing -> #team-writing, anything else -> #ops"
    },
    {
      "key": "build",
      "kind": "data.transform",
      "label": "4 - Build the Message",
      "section": "post"
    },
    {
      "key": "kind",
      "kind": "flow.branch",
      "label": "5 - Card Update or File Upload?",
      "section": "post"
    },
    {
      "key": "post_card",
      "kind": "app.action",
      "label": "6 - Post the Card Update to the Team Channel",
      "app": "slack",
      "op": "post",
      "section": "post"
    },
    {
      "key": "post_file",
      "kind": "app.action",
      "label": "6b - Post the File Link and Who Uploaded It",
      "app": "slack",
      "op": "post",
      "section": "post"
    },
    {
      "key": "ok",
      "kind": "flow.branch",
      "label": "7 - Posted OK?",
      "section": "reliable"
    },
    {
      "key": "opsalert",
      "kind": "app.action",
      "label": "8 - Alert Ops That the Post Failed",
      "app": "slack",
      "op": "post",
      "section": "reliable"
    },
    {
      "key": "log",
      "kind": "app.action",
      "label": "9 - Log Every Notification",
      "app": "googleSheets",
      "op": "append",
      "section": "reliable"
    }
  ],
  "edges": [
