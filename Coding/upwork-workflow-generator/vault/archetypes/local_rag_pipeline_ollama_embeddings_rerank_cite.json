{
  "title": "Local RAG Pipeline: Ollama Embeddings, Rerank, Cited Answers",
  "platform": "n8n",
  "sections": [
    {
      "key": "ingest",
      "label": "1 · NIGHTLY INGESTION: PULL, CHUNK, EMBED, STORE",
      "color": 0,
      "note": "Every night the source documents are pulled, cut into chunks, embedded on a local Ollama model and written to the vector store. Nothing leaves the box."
    },
    {
      "key": "retrieve",
      "label": "2 · RETRIEVE AND RERANK",
      "color": 0,
      "note": "The question is embedded the same way, the 20 nearest chunks come back, and a local model reranks them to the 5 that actually answer it."
    },
    {
      "key": "answer",
      "label": "3 · ANSWER WITH CITATIONS (LOCAL LLM + KAG)",
      "color": 0,
      "note": "The agent answers only from the reranked chunks and the knowledge graph. It has to return sources and a confidence score, not just text."
    },
    {
      "key": "respond",
      "label": "4 · RESPOND, OR ASK TO CLARIFY, AND TRACK ACCURACY",
      "color": 0,
      "note": "Confident answers go back with sources. Weak ones say what is missing. Every question is logged so accuracy can be measured week over week."
    },
    {
      "key": "reliability",
      "label": "5 · RELIABILITY",
      "color": 0,
      "note": "Any failure anywhere raises an alert with a link to the run. Nothing fails silently."
    }
  ],
