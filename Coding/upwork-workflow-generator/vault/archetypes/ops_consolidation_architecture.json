{
  "title": "LinkedIn Growth Ops → Airtable Core → AI Decisioning → Outreach",
  "platform": "n8n",
  "sections": [
    {
      "key": "capture",
      "label": "1 · CAPTURE",
      "color": 0,
      "note": "Every lead source lands in one normalized shape before anything downstream sees it — the precondition for consolidating Make, n8n and Zapier onto one spine."
    },
    {
      "key": "decide",
      "label": "2 · AI DECISIONING",
      "color": 0,
      "note": "An agent with tools, not a trigger-action rule. It reads the account history and decides segment, priority and the opening line."
    },
    {
      "key": "sync",
      "label": "3 · AIRTABLE CORE + SYNC",
      "color": 0,
      "note": "Airtable stays the single source of truth; Sheets, Docs and Excel are mirrors written from it, never written to directly."
    },
    {
      "key": "activate",
      "label": "4 · ACTIVATE",
      "color": 0,
      "note": "Outreach and human hand-off fire from the record state, so nothing depends on someone remembering."
    }
  ],
