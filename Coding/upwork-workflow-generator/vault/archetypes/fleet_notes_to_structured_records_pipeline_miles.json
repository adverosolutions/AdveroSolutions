    },
    {
      "from": "save_record",
      "to": "respond"
    },
    {
      "from": "hook_board",
      "to": "parse_loads"
    },
    {
      "from": "parse_loads",
      "to": "score"
    },
    {
      "from": "score",
      "to": "combine"
    },
    {
      "from": "combine",
      "to": "card"
    },
    {
      "from": "card",
      "to": "save_loads"
    },
    {
      "from": "err",
      "to": "alert"
    }
  ],
