{
  "title": "Fleet Notes to Structured Records Pipeline - Milestone 1 and 3",
  "platform": "n8n",
  "sections": [
    {
      "key": "intake",
      "label": "1 · NOTE INTAKE",
      "color": 0,
      "note": "A dispatcher or driver sends a voice note or a text note. Audio goes through Whisper first, text skips straight ahead."
    },
    {
      "key": "extract",
      "label": "2 · EXTRACT AND VALIDATE",
      "color": 0,
      "note": "The cheap model turns the note into JSON. Nothing is trusted until it passes the schema check."
    },
    {
      "key": "save",
      "label": "3 · SAVE AND REVIEW",
      "color": 0,
      "note": "The clean record lands in Supabase and comes back to the review screen for a human to confirm."
    },
    {
      "key": "loads",
      "label": "4 · LOAD PARSER AND SCORING",
      "color": 0,
      "note": "Pasted load-board text becomes scored loads, then the best legal combination for each truck, then a load card."
    },
    {
      "key": "errors",
      "label": "5 · WHEN SOMETHING BREAKS",
      "color": 0,
      "note": "Every failure is caught and posted with a link to the exact run. Nothing drops silently."
    }
  ],
  "nodes": [
    {
      "key": "hook_note",
      "kind": "trigger.webhook",
      "label": "1 · Voice or Text Note From Dispatcher or Driver",
      "section": "intake"
    },
    {
      "key": "is_audio",
      "kind": "flow.branch",
      "label": "2 · Is This an Audio Recording?",
      "section": "intake"
    },
    {
      "key": "whisper",
      "kind": "net.http",
      "label": "3 · Whisper: Turn the Recording Into Text",
      "section": "intake"
    },
    {
      "key": "normalize",
      "kind": "data.transform",
      "label": "4 · Clean the Note and Attach Truck, Driver and Date",
      "section": "intake"
    },
    {
      "key": "extract",
      "kind": "ai.llm",
      "label": "5 · Extraction Model, Cheap: Note Into Structured JSON",
      "section": "extract"
    },
    {
      "key": "extract_model",
      "kind": "ai.model",
      "label": "Provider Adapter: Anthropic / OpenAI / Google",
      "app": "anthropic",
      "parent": "extract",
      "port": "ai_languageModel"
    },
    {
      "key": "extract_parser",
      "kind": "ai.parser",
      "label": "Force the Schema: Loads, Expenses, Driver Events, Broker Contacts, Maintenance",
      "parent": "extract",
      "port": "ai_outputParser"
    },
    {
      "key": "validate",
      "kind": "data.code",
      "label": "6 · Check the JSON Against the Record Schema",
      "section": "extract"
    },
    {
      "key": "is_valid",
      "kind": "flow.branch",
      "label": "7 · Did It Come Back Valid?",
      "section": "extract"
    },
    {
      "key": "repair",
      "kind": "flow.wait",
      "label": "8 · Send It Back With a Repair Prompt, Twice at Most",
      "section": "extract"
    },
    {
      "key": "save_record",
      "kind": "app.action",
      "label": "9 · Save the Record, Row Locked to That Fleet",
      "app": "supabase",
      "op": "insert",
      "section": "save"
    },
    {
      "key": "respond",
      "kind": "net.respond",
      "label": "10 · Hand the Record to the Review Screen",
      "section": "save"
    },
    {
      "key": "hook_board",
      "kind": "trigger.webhook",
      "label": "11 · Raw Load-Board Text Pasted In",
      "section": "loads"
    },
    {
      "key": "parse_loads",
      "kind": "ai.llm",
      "label": "12 · Extraction Model: Pull the Loads Out of Messy Text",
      "section": "loads"
    },
    {
      "key": "loads_parser",
      "kind": "ai.parser",
      "label": "Force One Row per Load: Pickup, Drop, Rate, Miles, Vehicles",
      "parent": "parse_loads",
      "port": "ai_outputParser"
    },
    {
      "key": "score",
      "kind": "data.code",
      "label": "13 · Score Revenue per Mile, Deadhead, 9-Car Unit and Weight Limits",
      "section": "loads"
    },
    {
      "key": "combine",
      "kind": "data.code",
      "label": "14 · Pick the Best Legal Combination for Each Truck",
      "section": "loads"
    },
    {
      "key": "card",
      "kind": "ai.llm",
      "label": "15 · Synthesis Model, Larger: Write the HTML Load Card",
      "section": "loads"
    },
    {
      "key": "card_model",
      "kind": "ai.model",
      "label": "Provider Adapter: Same Interface, Bigger Model",
      "app": "anthropic",
      "parent": "card",
      "port": "ai_languageModel"
    },
    {
      "key": "save_loads",
      "kind": "app.action",
      "label": "16 · Save the Scored Loads and the Card",
      "app": "supabase",
      "op": "insert",
      "section": "loads"
    },
    {
      "key": "err",
      "kind": "trigger.app",
      "label": "17 · Any Step Fails, Anywhere",
      "app": "n8n",
      "op": "error_trigger",
      "section": "errors"
    },
    {
      "key": "alert",
      "kind": "app.action",
      "label": "18 · Post the Failure With a Link to the Run",
      "app": "slack",
      "op": "post",
      "section": "errors"
    }
  ],
  "edges": [
    {
