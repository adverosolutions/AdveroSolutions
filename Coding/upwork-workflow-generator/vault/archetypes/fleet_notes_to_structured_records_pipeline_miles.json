    },
    {
      "from": "whisper",
      "to": "normalize"
    },
    {
      "from": "normalize",
      "to": "extract"
    },
    {
      "from": "extract",
      "to": "validate"
    },
    {
      "from": "validate",
      "to": "is_valid"
    },
    {
      "from": "is_valid",
      "to": "save_record",
      "branch": "true"
    },
    {
      "from": "is_valid",
      "to": "repair",
