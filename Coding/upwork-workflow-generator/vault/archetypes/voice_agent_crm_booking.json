    },
    {
      "key": "model",
      "kind": "ai.model",
      "label": "Claude",
      "app": "anthropic",
      "parent": "agent",
      "port": "ai_languageModel"
    },
    {
      "key": "tool",
      "kind": "ai.tool",
      "label": "Calendar Availability",
