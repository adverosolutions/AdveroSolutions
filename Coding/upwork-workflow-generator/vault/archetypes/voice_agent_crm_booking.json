{
  "title": "Voice AI Call → Dedupe CRM → Book Slot → Call Summary",
  "platform": "n8n",
  "sections": [
    {
      "key": "call",
      "label": "1 · CALL",
      "color": 0,
      "note": "The voice agent hands off the moment the call ends — transcript, caller details and intent in one webhook."
    },
    {
      "key": "identify",
      "label": "2 · IDENTIFY",
      "color": 0,
      "note": "Match before create, always. Phone first, then email, then fuzzy name — this is what keeps duplicate contacts out of the CRM."
    },
    {
      "key": "schedule",
      "label": "3 · SCHEDULE",
      "color": 0,
      "note": "Real availability from the calendar API, not a guess. The agent only ever offers slots that are actually open."
    },
    {
      "key": "record",
      "label": "4 · CONFIRM & RECORD",
      "color": 0,
      "note": "Booking, confirmation and the call summary all land on the same contact record, so nothing has to be re-entered by hand."
    }
  ],
  "nodes": [
    {
      "key": "hook",
      "kind": "trigger.webhook",
      "label": "Voice Agent Call Completed",
      "section": "call",
      "notes": "Signed webhook from the voice platform — retried on failure so a dropped call is never lost."
    },
    {
      "key": "parse",
      "kind": "data.transform",
      "label": "Parse Caller Details & Intent",
      "section": "call"
    },
    {
      "key": "match",
      "kind": "net.http",
      "label": "Match Contact — Phone, Then Email",
      "section": "identify",
      "notes": "Two lookups before any write. The single most common cause of duplicate CRM records is creating on the first miss."
    },
    {
      "key": "upsert",
      "kind": "app.action",
      "label": "Upsert CRM Contact",
      "app": "hubspot",
      "op": "create_contact",
      "section": "identify"
    },
    {
      "key": "avail",
      "kind": "net.http",
      "label": "Fetch Open Calendar Slots",
      "section": "schedule"
    },
    {
      "key": "agent",
