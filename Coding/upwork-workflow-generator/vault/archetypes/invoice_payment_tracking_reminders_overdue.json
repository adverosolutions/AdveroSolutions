      "op": "append",
      "section": "reminders"
    },
    {
      "key": "notify_overdue",
      "kind": "app.action",
      "label": "Notify the Team: Invoice Overdue",
      "app": "slack",
      "op": "post",
      "section": "reminders"
    }
  ],
