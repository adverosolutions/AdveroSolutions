      "app": "googleSheets",
      "op": "append",
      "section": "payment"
    },
    {
      "key": "notify_paid",
      "kind": "app.action",
      "label": "Notify the Team: Payment Received",
      "app": "slack",
      "op": "post",
      "section": "payment"
    },
    {
      "key": "daily_trig",
      "kind": "trigger.schedule",
      "label": "Daily Check, 8am",
