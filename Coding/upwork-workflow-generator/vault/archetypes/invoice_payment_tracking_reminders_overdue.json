{
  "title": "Invoice & Payment Tracking — Invoice In → Status Sync → Reminders → Overdue Alerts",
  "platform": "n8n",
  "sections": [
    {
      "key": "invoice",
      "label": "1 · INVOICE IN",
      "color": 0,
      "note": "Every new invoice lands in the tracking sheet the moment it's created, so the sheet is the single source of truth, not a weekly export."
    },
    {
      "key": "payment",
      "label": "2 · PAYMENT RECEIVED",
      "color": 0,
      "note": "A payment gets matched to its invoice and marked paid everywhere at once, accounting tool, sheet, and team, so no one chases an invoice that's already settled."
    },
    {
      "key": "reminders",
      "label": "3 · REMINDERS & OVERDUE",
      "color": 0,
      "note": "A daily check sends the right message for where each invoice actually is, upcoming, due today, or overdue, and the team only hears about the overdue ones."
    }
  ],
  "nodes": [
    {
      "key": "invoice_trig",
      "kind": "trigger.app",
      "label": "New Invoice Created in the Accounting Tool",
      "section": "invoice"
    },
    {
      "key": "normalize",
      "kind": "data.transform",
      "label": "Normalize Invoice: Customer, Amount, Due Date, Status",
      "section": "invoice"
    },
    {
      "key": "add_to_sheet",
      "kind": "app.action",
      "label": "Add the Invoice to the Tracking Sheet",
      "app": "googleSheets",
      "op": "append",
      "section": "invoice"
    },
    {
      "key": "payment_trig",
      "kind": "trigger.webhook",
      "label": "Payment Received from the Payment Tool",
      "section": "payment"
    },
    {
      "key": "match_invoice",
      "kind": "data.transform",
      "label": "Match the Payment to Its Invoice",
      "section": "payment"
    },
    {
      "key": "mark_paid",
      "kind": "net.http",
      "label": "Mark the Invoice Paid in the Accounting Tool",
      "section": "payment"
    },
    {
      "key": "sheet_paid",
      "kind": "app.action",
