{
  "title": "Engagement Scoring → Segmented Send → Re-Engage → Protect Sender",
  "platform": "n8n",
  "sections": [
    {
      "key": "collect",
      "label": "1 · COLLECT",
      "color": 0,
      "note": "Opens, clicks, bounces and complaints pulled from the ESP daily. Every decision below is made on behaviour, not on the list someone imported two years ago."
    },
    {
      "key": "segment",
      "label": "2 · SEGMENT",
      "color": 0,
      "note": "One engagement score per subscriber — recency weighted hardest. Segmentation that is recalculated daily beats static lists that quietly rot."
    },
    {
      "key": "send",
      "label": "3 · SEND",
      "color": 0,
      "note": "Engaged subscribers get the campaign, lapsing ones get a short win-back. Content is written against what actually performed, not against a template."
    },
    {
      "key": "protect",
      "label": "4 · PROTECT",
      "color": 0,
      "note": "The unglamorous half nobody builds: dormant subscribers are suppressed on a schedule. Sender reputation is the ceiling on every other number in this system."
    }
  ],
  "nodes": [
    {
      "key": "cron",
      "kind": "trigger.schedule",
      "label": "Daily — 6:00 AM",
      "section": "collect"
    },
    {
      "key": "pull",
      "kind": "net.http",
      "label": "Pull Campaign & Subscriber Activity",
      "section": "collect",
      "notes": "ESP API — works the same whether you stay on your current platform or move."
    },
    {
      "key": "score",
      "kind": "data.transform",
      "label": "Score Engagement — Recency, Opens, Clicks",
      "section": "segment"
    },
    {
      "key": "log",
