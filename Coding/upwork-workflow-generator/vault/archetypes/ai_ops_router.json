{
  "title": "AI Operating System — Task Intake → Model Routing → QA → Deliver",
  "platform": "n8n",
  "sections": [
    {
      "key": "intake",
      "label": "1 · TASK INTAKE",
      "color": 0,
      "note": "Anyone on the team submits work through one form instead of each person improvising in their own ChatGPT tab. This single entry point is what makes the rest measurable — you cannot standardize what you cannot see."
    },
    {
      "key": "route",
      "label": "2 · MODEL ROUTING",
      "color": 0,
      "note": "A router classifies the task and picks the right tool for it. Long-form writing, structured extraction and live research have genuinely different best answers, and routing them by hand is where teams silently lose the quality gains."
    },
    {
      "key": "execute",
      "label": "3 · EXECUTE",
      "color": 0,
      "note": "Each lane runs the task with the prompt and SOP built for that work type. Prompts live in the workflow, versioned, so improving one improves it for everyone at once rather than living in one person's notes."
    },
    {
      "key": "qa",
      "label": "4 · QUALITY GATE",
      "color": 0,
      "note": "Every output is scored against the SOP rubric before anyone sees it. Work that clears the bar ships; work that does not routes to a human with the reason attached, instead of quietly reaching a client."
    },
    {
      "key": "deliver",
      "label": "5 · DELIVER & MEASURE",
      "color": 0,
      "note": "The result comes back to the requester, and every run logs which tool was used, what it cost and how long it took. That log is what turns \"we use AI\" into a number you can put in front of leadership."
    }
  ],
