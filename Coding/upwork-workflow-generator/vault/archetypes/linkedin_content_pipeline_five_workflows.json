{
  "title": "LinkedIn Content Pipeline — Draft, Approve, Guard, Schedule, Track",
  "platform": "n8n",
  "sections": [
    {
      "key": "intake",
      "label": "1 · DRAFT INTAKE",
      "color": 0,
      "note": "Every draft becomes one Airtable record the moment it exists, so nothing lives only in a Slack thread or a Google Doc that gets lost."
    },
    {
      "key": "approve",
      "label": "2 · APPROVAL",
      "color": 0,
      "note": "A draft moves forward only when a person marks it ready. No post reaches Buffer without someone having actually looked at it."
    },
    {
      "key": "guard",
      "label": "3 · SAFEGUARDS",
      "color": 0,
      "note": "Two checks nobody wants to do by hand every time: is this the same post as one we already ran, and does it trip a banned-word or bad-link rule. Both run before scheduling, not after."
    },
    {
      "key": "schedule",
      "label": "4 · SCHEDULING",
      "color": 0,
      "note": "Only a post that has cleared approval and safeguards reaches Buffer. The slot it lands on is checked against what is already queued so nothing doubles up."
    },
    {
      "key": "track",
      "label": "5 · POST-PUBLISH TRACKING",
      "color": 0,
      "note": "When Buffer actually publishes, that confirmation writes back to the same Airtable record, closing the loop from idea to published post in one place."
    }
  ],
  "nodes": [
