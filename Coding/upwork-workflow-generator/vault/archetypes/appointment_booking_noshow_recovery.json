{
  "title": "Appointment Booking, Reminders, No-Show Recovery, Reschedule & Cancel",
  "platform": "gohighlevel",
  "sections": [
    {
      "key": "book",
      "label": "1 · BOOK THE APPOINTMENT",
      "color": 0,
      "note": "A prospect can only book a slot that is actually open, checked in real time against the calendar, not against a static list that goes stale."
    },
    {
      "key": "confirm",
      "label": "2 · CONFIRM AND REMIND",
      "color": 0,
      "note": "Email plus text confirmation immediately, then a reminder sequence timed to when people actually forget, the day before and the hour before."
    },
    {
      "key": "outcome",
      "label": "3 · DID THEY SHOW UP?",
      "color": 0,
      "note": "The two outcomes need completely different follow-ups. Treating a no-show the same as a completed appointment is the single biggest reason follow-up sequences feel generic."
    },
    {
      "key": "change",
      "label": "4 · RESCHEDULE OR CANCEL, HANDLED CLEANLY",
      "color": 0,
      "note": "Both release the original slot immediately so it goes back into inventory instead of sitting held on a no-longer-real booking."
    },
    {
      "key": "cancel",
      "label": "5 · CANCELLATION",
      "color": 0,
      "note": "A cancelled slot goes straight back into inventory, and the contact moves to nurture on its own path rather than sharing the no-show recovery track."
    }
  ],
