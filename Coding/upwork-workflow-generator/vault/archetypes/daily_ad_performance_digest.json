{
  "title": "Daily Ad Performance → AI Analysis → Budget Recommendation",
  "platform": "n8n",
  "sections": [
    {
      "key": "pull",
      "label": "1 · PULL THE NUMBERS",
      "color": 0,
      "note": "Runs every morning before anyone opens a dashboard. Pulls yesterday plus a trailing 7-day window from every ad account, so a single bad day never triggers a decision on its own."
    },
    {
      "key": "think",
      "label": "2 · WORK OUT WHAT CHANGED",
      "color": 0,
      "note": "The model does not see raw numbers. It sees each campaign against its own target and its own recent baseline, which is what stops the usual output of restating the report back at you."
    },
    {
      "key": "decide",
      "label": "3 · TURN IT INTO A DECISION",
      "color": 0,
      "note": "Every finding comes out as a specific action with a number attached: shift this much, pause this, test this variant. Anything below a materiality threshold is dropped rather than padded into the report."
    },
    {
      "key": "deliver",
      "label": "4 · DELIVER IT",
      "color": 0,
      "note": "One short message every morning with the three things worth doing today, plus the full history logged so the recommendations can be scored against what actually happened."
    }
  ],
  "nodes": [
    {
      "key": "cron",
      "kind": "trigger.schedule",
      "label": "1 · Every Morning, 7am",
      "section": "pull"
    },
    {
      "key": "fetch",
      "kind": "net.http",
      "label": "2 · Pull Campaign Performance · All Accounts",
      "section": "pull"
    },
    {
      "key": "window",
      "kind": "data.transform",
      "label": "3 · Compare vs Target and vs Last 7 Days",
      "section": "pull"
    },
    {
      "key": "agent",
      "kind": "ai.agent",
      "label": "4 · Find What Actually Changed and Why",
      "section": "think"
    },
    {
      "key": "model",
      "kind": "ai.model",
      "label": "Analysis Model",
      "app": "openai",
      "parent": "agent",
      "port": "ai_languageModel"
    },
    {
      "key": "parser",
      "kind": "ai.parser",
      "label": "Force Structured Findings",
      "parent": "agent",
      "port": "ai_outputParser"
    },
    {
      "key": "material",
      "kind": "data.filter",
      "label": "5 · Drop Anything Below the Materiality Cut",
      "section": "decide"
    },
    {
      "key": "actions",
      "kind": "data.transform",
      "label": "6 · Convert Findings into Costed Actions",
      "section": "decide"
    },
    {
      "key": "cap",
      "kind": "flow.branch",
      "label": "7 · Above the Spend-Change Cap?",
      "section": "decide"
    },
    {
      "key": "approve",
      "kind": "app.action",
      "label": "7b · Send for Approval First",
      "app": "slack",
      "op": "send_message",
      "section": "decide"
    },
    {
      "key": "digest",
      "kind": "app.action",
      "label": "8 · Post the Morning Digest",
      "app": "slack",
      "op": "send_message",
      "section": "deliver"
    },
    {
      "key": "log",
      "kind": "app.action",
      "label": "9 · Log It So Recommendations Can Be Scored",
      "app": "googleSheets",
      "op": "update_row",
      "section": "deliver"
    }
  ],
  "edges": [
    {
      "from": "cron",
      "to": "fetch"
    },
    {
      "from": "fetch",
      "to": "window"
    },
    {
      "from": "window",
      "to": "agent"
    },
    {
      "from": "agent",
      "to": "material"
    },
    {
      "from": "material",
      "to": "actions"
    },
    {
      "from": "actions",
      "to": "cap"
