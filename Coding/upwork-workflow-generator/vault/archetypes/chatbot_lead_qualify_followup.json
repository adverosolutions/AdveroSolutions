{
  "title": "Chatbot Lead Capture → AI Qualify → CRM → Follow-Up",
  "platform": "n8n",
  "sections": [
    {
      "key": "capture",
      "label": "1 · CAPTURE",
      "color": 0,
      "note": "The chatbot does the intake, so a lead is already structured before anyone reads it — no form, no drop-off."
    },
    {
      "key": "qualify",
      "label": "2 · AI QUALIFY",
      "color": 0,
      "note": "An agent with the conversation history and CRM access decides fit, priority and the next step. Not a keyword rule."
    },
    {
      "key": "crm",
      "label": "3 · CRM + THIRD PARTY",
      "color": 0,
      "note": "One write to the CRM, then fan out to the other tools from it — the CRM stays the source of truth."
    },
    {
      "key": "followup",
      "label": "4 · FOLLOW-UP",
      "color": 0,
      "note": "Sequence and owner alert fire off the record state, which is what turns a captured lead into a converted one."
    }
  ],
