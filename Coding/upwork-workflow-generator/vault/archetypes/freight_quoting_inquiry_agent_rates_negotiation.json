{
  "title": "Freight Quoting: Inquiry, Agent Rates, Negotiation, Quote, Invoice",
  "platform": "n8n",
  "sections": [
    {
      "key": "intake",
      "label": "1 · READ THE INQUIRY AND PULL THE SHIPMENT DETAILS",
      "color": 0,
      "note": "Claude reads the inbound email and fills a fixed shipment schema. Anything missing goes back to the client before the lane is worked."
    },
    {
      "key": "rates",
      "label": "2 · SOURCE RATES FROM THE AGENT NETWORK",
      "color": 0,
      "note": "One rate request per country, sent from Outlook. The workflow holds the lane open for a day and then collects whatever came back."
    },
    {
      "key": "negotiate",
      "label": "3 · COMPARE, NEGOTIATE, GET HUMAN APPROVAL",
      "color": 0,
      "note": "Rates arrive in different currencies and units. Claude normalizes them, and no quote leaves without a person approving the number."
    },
    {
      "key": "quote",
      "label": "4 · QUOTE THE CLIENT AND FOLLOW UP",
      "color": 0,
      "note": "The quote is written from your template and terms, then chased on a timer until the client answers."
    },
    {
      "key": "close",
      "label": "5 · INVOICE, ARCHIVE, CATCH FAILURES",
      "color": 0,
      "note": "Accepted quotes become a Wafeq invoice. Every quote is archived and every outcome is logged, win or lose."
    }
  ],
  "nodes": [
    {
      "key": "inbox",
      "kind": "trigger.email",
      "label": "1 · New Inquiry Lands in the Outlook Inbox",
      "section": "intake"
    },
    {
      "key": "extract",
      "kind": "ai.llm",
      "label": "2 · Claude Reads the Email and Pulls the Shipment Details",
      "section": "intake"
    },
    {
      "key": "extract_model",
      "kind": "ai.model",
      "label": "Claude",
      "app": "anthropic",
      "parent": "extract",
      "port": "ai_languageModel"
    },
    {
      "key": "extract_parser",
      "kind": "ai.parser",
      "label": "Force Origin Port, Destination Port, Weight, Volume, Cargo Type, Dangerous Goods Class, Incoterms",
      "parent": "extract",
      "port": "ai_outputParser"
    },
    {
      "key": "complete",
      "kind": "flow.branch",
      "label": "3 · Did the Email Contain Every Field We Need to Quote?",
      "section": "intake"
    },
    {
      "key": "askback",
      "kind": "net.http",
      "label": "3b · Outlook: Ask the Client for the Missing Details",
      "section": "intake"
    },
    {
      "key": "log_inquiry",
      "kind": "app.action",
      "label": "4 · Log the Inquiry as a New Quote Reference",
      "app": "googleSheets",
      "op": "append",
      "section": "intake"
    },
    {
      "key": "lane",
      "kind": "flow.switch",
      "label": "5 · Route the Rate Request by Trade Lane",
      "section": "rates"
    },
    {
      "key": "ask_agents",
      "kind": "net.http",
      "label": "6 · Outlook: Email the Rate Request to Agents in That Country",
      "section": "rates"
    },
    {
      "key": "window",
      "kind": "flow.wait",
      "label": "7 · Hold the Lane Open for 24 Hours While Agents Reply",
      "section": "rates"
    },
    {
      "key": "collect",
      "kind": "net.http",
      "label": "8 · Outlook: Collect the Agent Rate Replies for This Quote",
      "section": "rates"
    },
    {
      "key": "compare",
      "kind": "ai.llm",
      "label": "9 · Claude Normalizes Every Rate and Ranks Them Side by Side",
      "section": "negotiate"
    },
    {
      "key": "compare_model",
      "kind": "ai.model",
      "label": "Claude",
      "app": "anthropic",
      "parent": "compare",
      "port": "ai_languageModel"
    },
    {
      "key": "compare_parser",
      "kind": "ai.parser",
      "label": "Force One All In Cost Per Agent in a Single Currency",
      "parent": "compare",
      "port": "ai_outputParser"
    },
    {
      "key": "margin",
      "kind": "flow.branch",
      "label": "10 · Is the Best Rate Inside Our Target Margin?",
      "section": "negotiate"
    },
    {
      "key": "counter",
      "kind": "net.http",
      "label": "10b · Outlook: Send the Agent a Counter Offer, Two Rounds Maximum",
      "section": "negotiate"
    },
    {
      "key": "approve",
      "kind": "app.action",
      "label": "11 · Ask a Human to Approve the Rate Before Anything Is Quoted",
      "app": "slack",
      "op": "post",
      "section": "negotiate"
    },
    {
      "key": "draft",
      "kind": "ai.llm",
      "label": "12 · Claude Writes the Quote From Your Template and Terms",
      "section": "quote"
    },
    {
      "key": "draft_model",
      "kind": "ai.model",
      "label": "Claude",
      "app": "anthropic",
      "parent": "draft",
      "port": "ai_languageModel"
    },
    {
      "key": "send_quote",
      "kind": "net.http",
      "label": "13 · Outlook: Send the Quote to the Client",
      "section": "quote"
    },
    {
      "key": "timer",
      "kind": "flow.wait",
      "label": "14 · Wait Out the Follow Up Timer",
      "section": "quote"
    },
    {
      "key": "replied",
      "kind": "flow.branch",
      "label": "15 · Has the Client Replied or Accepted the Quote?",
      "section": "quote"
    },
    {
      "key": "followup",
      "kind": "net.http",
      "label": "15b · Outlook: Send the Next Follow Up, Three Maximum, Then Stop",
      "section": "quote"
    },
    {
      "key": "invoice",
      "kind": "net.http",
      "label": "16 · Wafeq: Raise the Invoice for the Accepted Quote",
      "section": "close"
    },
    {
      "key": "archive",
      "kind": "app.action",
      "label": "17 · Archive the Quote PDF in the Client's Drive Folder",
      "app": "googleDrive",
      "op": "upload",
      "section": "close"
    },
    {
      "key": "outcome",
      "kind": "app.action",
      "label": "18 · Log the Outcome, Won or Lost, Against the Quote Reference",
      "app": "googleSheets",
      "op": "append",
      "section": "close"
    },
    {
      "key": "err",
      "kind": "trigger.app",
      "label": "19 · Any Step Fails, Anywhere in the Workflow",
      "app": "n8n",
      "op": "error_trigger",
      "section": "close"
    },
    {
      "key": "alert",
      "kind": "app.action",
      "label": "20 · Alert the Team With the Quote Reference and a Link to the Run",
      "app": "slack",
      "op": "post",
      "section": "close"
    }
  ],
