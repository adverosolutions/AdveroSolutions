{
  "title": "Online Audit → 4-Path Segmentation → Pipeline & Nurture",
  "platform": "gohighlevel",
  "sections": [
    {
      "key": "intake",
      "label": "1 · INTAKE & DEDUPE",
      "color": 0,
      "note": "Audit start fires the workflow immediately. The contact is created or matched, then pulled out of every competing sequence before anything sends — this is what stops duplicate and conflicting messages later."
    },
    {
      "key": "qualify",
      "label": "2 · QUALIFY & ROUTE",
      "color": 0,
      "note": "Qualification criteria are written to custom fields, then a 24-hour window lets the prospect finish or book before routing. One switch, four mutually exclusive outcomes — no contact can land in two arms."
    },
    {
      "key": "paths",
      "label": "3 · PATH-SPECIFIC FOLLOW-UP",
      "color": 0,
      "note": "Each outcome gets its own tag, pipeline stage and sequence. Your copy drops straight into these — the structure decides who receives it and when."
    },
    {
      "key": "longterm",
      "label": "4 · LONG-TERM SEGMENTATION",
      "color": 0,
      "note": "Every contact exits into exactly one newsletter audience. Re-entry is handled by triggers on tag change, so a not-qualified lead who later qualifies moves lists without a manual cleanup."
    }
  ],
  "nodes": [
