# Copy to .env (git-ignored) and fill in. Never commit the real .env.

# GoHighLevel Private Integration token, used by `python3 -m upwork_gen.ghl_prereqs`.
# Create it in the sub-account: Settings > Private Integrations > Create new integration.
# Scopes needed: locations/tags.readonly + write, locations/customFields.readonly + write,
# locations/customValues.readonly + write, opportunities.readonly + write.
GHL_PIT_TOKEN=

# GHL sub-account (location) id. Defaults to the AdveroSolutions sub-account.
GHL_LOCATION_ID=ebyNANPagaK7ycf1pfge
