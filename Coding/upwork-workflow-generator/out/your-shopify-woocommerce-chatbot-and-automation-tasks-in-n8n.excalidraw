{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_43", "type": "rectangle", "x": -104, "y": -90, "width": 3310, "height": 780, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 721762279, "version": 1, "versionNonce": 502922617, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_44", "type": "text", "x": -82, "y": -74, "width": 3266, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2120395275, "version": 1, "versionNonce": 253207297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - SHOPIFY/WOOCOMMERCE CHATBOT: ORDERS AND PRODUCT QUESTIONS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - SHOPIFY/WOOCOMMERCE CHATBOT: ORDERS AND PRODUCT QUESTIONS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_45", "type": "text", "x": -82, "y": -38, "width": 3266, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 937195260, "version": 1, "versionNonce": 1234510746, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part 1, the Shopify/WooCommerce chatbot. One setting picks your platform, and order status and product answers come from your live store, never from Claude's memory.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part 1, the Shopify/WooCommerce chatbot. One setting picks your platform, and order status and product answers come from your live store, never from Claude's memory.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_46", "type": "rectangle", "x": 3386, "y": 174, "width": 720, "height": 342, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 555512016, "version": 1, "versionNonce": 1063497604, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_47", "type": "text", "x": 3408, "y": 190, "width": 676, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1708957521, "version": 1, "versionNonce": 1679116189, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - AUTOMATION TASK: LATE ORDERS FLAGGED TO YOU", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - AUTOMATION TASK: LATE ORDERS FLAGGED TO YOU", "lineHeight": 1.25, "autoResize": false}, {"id": "text_48", "type": "text", "x": 3408, "y": 226, "width": 676, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2132480061, "version": 1, "versionNonce": 346094056, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part 2, automation tasks, starting with this one. When a shopper asks about an order still\nunshipped past your shipping promise, you get an email before they ask twice.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part 2, automation tasks, starting with this one. When a shopper asks about an order still\nunshipped past your shipping promise, you get an email before they ask twice.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_49", "type": "rectangle", "x": 4304, "y": 230, "width": 352, "height": 338, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 714537755, "version": 1, "versionNonce": 1929245187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_50", "type": "text", "x": 4326, "y": 246, "width": 308, "height": 82, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1725048951, "version": 1, "versionNonce": 1193309984, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - BUILDING AND IMPROVING\nWORKFLOWS: EVERY CHAT\nLOGGED", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - BUILDING AND IMPROVING\nWORKFLOWS: EVERY CHAT\nLOGGED", "lineHeight": 1.25, "autoResize": false}, {"id": "text_51", "type": "text", "x": 4326, "y": 337, "width": 308, "height": 81, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 588093311, "version": 1, "versionNonce": 1849076401, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part 3, building and improving\nworkflows. Every chat lands in a Google\nSheet with the question, the answer and\nwhether a person was needed, so each\nimprovement comes from real chats.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part 3, building and improving\nworkflows. Every chat lands in a Google\nSheet with the question, the answer and\nwhether a person was needed, so each\nimprovement comes from real chats.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_52", "type": "rectangle", "x": 4836, "y": 306, "width": 720, "height": 290, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1195809358, "version": 1, "versionNonce": 1783684942, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_53", "type": "text", "x": 4858, "y": 322, "width": 676, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1540910401, "version": 1, "versionNonce": 1633982922, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - CONNECTING SYSTEMS: YOUR INBOX TAKES OVER", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - CONNECTING SYSTEMS: YOUR INBOX TAKES OVER", "lineHeight": 1.25, "autoResize": false}, {"id": "text_54", "type": "text", "x": 4858, "y": 358, "width": 676, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 991070208, "version": 1, "versionNonce": 648200382, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part 4, connecting systems. Refunds, cancellations and anything the bot should not guess\ngo to your inbox with the chat and the order, and your reply goes straight to the shopper.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part 4, connecting systems. Refunds, cancellations and anything the bot should not guess\ngo to your inbox with the chat and the order, and your reply goes straight to the shopper.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_55", "type": "rectangle", "x": 5754, "y": 46, "width": 700, "height": 262, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 356416555, "version": 1, "versionNonce": 756849393, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_56", "type": "text", "x": 5776, "y": 62, "width": 656, "height": 55, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 649821630, "version": 1, "versionNonce": 996247159, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - SUPPORTING ONGOING AUTOMATION NEEDS: NOTHING FAILS\nQUIETLY", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 