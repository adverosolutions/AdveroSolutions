@direction LR
@spacing 60

(1 - Zapier Tags the Contact call-booked) -> [2 - Clear an Old call-cancelled Tag]
[2 - Clear an Old call-cancelled Tag] -> [3 - Add the Lead to Call Booked Pipeline]
[3 - Add the Lead to Call Booked Pipeline] -> [4 - Text the Owner the New Booking]
[4 - Text the Owner the New Booking] -> [5 - Email the Owner the Booking Details]
[5 - Email the Owner the Booking Details] -> [6 - Email the Lead One Prep Question]
[6 - Email the Lead One Prep Question] -> [7 - Wait 14 Days While the Call Is Upcoming]
[7 - Wait 14 Days While the Call Is Upcoming] -> [8 - Task: Close Out the Card After the Call]
[8 - Task: Close Out the Card After the Call] -> [9 - Goal: Call Cancelled in Cal.com]
[9 - Goal: Call Cancelled in Cal.com] -> [10 - Move the Opportunity to Cancelled]
[10 - Move the Opportunity to Cancelled] -> [11 - Remove the call-booked Tag]
[11 - Remove the call-booked Tag] -> [12 - Email the Lead a Link to Rebook]
[12 - Email the Lead a Link to Rebook] -> [13 - Text the Owner the Cancellation]
