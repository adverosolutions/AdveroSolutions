{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_21", "type": "rectangle", "x": -104, "y": -90, "width": 1744, "height": 326, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1836494975, "version": 1, "versionNonce": 1349251824, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_22", "type": "text", "x": -82, "y": -74, "width": 1700, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1999744785, "version": 1, "versionNonce": 1946412081, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - THE BOT TALKS TO STUDENTS AND PARENTS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - THE BOT TALKS TO STUDENTS AND PARENTS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_23", "type": "text", "x": -82, "y": -38, "width": 1700, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1552984409, "version": 1, "versionNonce": 1287489454, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The bot answers from your own information and learns what each family needs. Anything sensitive goes straight to a person.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The bot answers from your own information and learns what each family needs. Anything sensitive goes straight to a person.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_24", "type": "rectangle", "x": 1840, "y": -10, "width": 1048, "height": 318, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1066984056, "version": 1, "versionNonce": 772092315, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_25", "type": "text", "x": 1862, "y": 6, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1048386556, "version": 1, "versionNonce": 351564608, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - CONNECTED TO YOUR TOOLS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - CONNECTED TO YOUR TOOLS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_26", "type": "text", "x": 1862, "y": 42, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1289560150, "version": 1, "versionNonce": 2126508551, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Every conversation ends in a booked next step, and the lead lands in your CRM so nobody retypes it.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Every conversation ends in a booked next step, and the lead lands in your CRM so nobody retypes it.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_27", "type": "rectangle", "x": 3086, "y": -26, "width": 700, "height": 234, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1475216846, "version": 1, "versionNonce": 1927728187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_28", "type": "text", "x": 3108, "y": -10, "width": 656, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1236683273, "version": 1, "versionNonce": 314395343, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - TESTED BEFORE LAUNCH, KEPT RUNNING AFTER", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - TESTED BEFORE LAUNCH, KEPT RUNNING AFTER", "lineHeight": 1.25, "autoResize": false}, {"id": "text_29", "type": "text", "x": 3108, "y": 26, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 507088657, "version": 1, "versionNonce": 1795823849, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "You asked for someone who tests their own work, so every path gets tested first, and the bot\nis kept up to date as things change.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "You asked for someone who tests their own work, so every path gets tested first, and the bot\nis kept up to date as things change.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_1", "type": "rectangle", "x": -68, "y": 88, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1390851129, "version": 1, "versionNonce": 647892280, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_2"}, {"type": "arrow", "id": "arrow_30"}], "updated": 1, "link": null, "locked": false}, {"id": "text_2", "type": "text", "x": -56.0, "y": 101.875, "width": 256, "height": 56, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1695753999, "version": 1, "versionNonce": 207388625, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - A student or parent asks\nthe bot a question on your\nwebsite or social page", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_1", "originalText": "1 - A student or parent asks\nthe bot a question on your\nwebsite or social page", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_3", "type": "rectangle", "x": 280, "y": 88, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 311111476, "version": 1, "versionNonce": 404285458, "isDeleted": false, "boundEleme