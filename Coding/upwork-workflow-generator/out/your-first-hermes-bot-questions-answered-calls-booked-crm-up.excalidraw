: null, "seed": 212984477, "version": 1, "versionNonce": 949539217, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - If not, the bot offers a\ncall or the next enrollment\nstep and books it", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_11", "originalText": "5 - If not, the bot offers a\ncall or the next enrollment\nstep and books it", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_13", "type": "rectangle", "x": 2224, "y": 88, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 200071089, "version": 1, "versionNonce": 571981486, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_14"}, {"type": "arrow", "id": "arrow_37"}, {"type": "arrow", "id": "arrow_38"}, {"type": "arrow", "id": "arrow_39"}], "updated": 1, "link": null, "locked": false}, {"id": "text_14", "type": "text", "x": 2236.0, "y": 101.875, "width": 256, "height": 56, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1243862423, "version": 1, "versionNonce": 1800188483, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "6 - The lead and the full chat\nare sent to your CRM by\nwebhook", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_13", "originalText": "6 - The lead and the full chat\nare sent to your CRM by\nwebhook", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_15", "type": "rectangle", "x": 2572, "y": 88, "width": 280, "height": 84, "an