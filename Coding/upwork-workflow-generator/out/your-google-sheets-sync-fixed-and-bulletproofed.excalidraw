{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_33", "type": "rectangle", "x": -104, "y": 42, "width": 352, "height": 266, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 333377415, "version": 1, "versionNonce": 1347535309, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_34", "type": "text", "x": -82, "y": 58, "width": 308, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1460814403, "version": 1, "versionNonce": 1504004732, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - THE DATA COMES IN", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - THE DATA COMES IN", "lineHeight": 1.25, "autoResize": false}, {"id": "text_35", "type": "text", "x": -82, "y": 93, "width": 308, "height": 65, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2133201996, "version": 1, "versionNonce": 1959386987, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Whatever feeds the sheet lands here, one\nrecord at a time, so every run can be\nreplayed against the exact payload that\nbroke it.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Whatever feeds the sheet lands here, one\nrecord at a time, so every run can be\nreplayed against the exact payload that\nbroke it.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_36", "type": "rectangle", "x": 448, "y": -38, "width": 1764, "height": 486, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 295334610, "version": 1, "versionNonce": 401991736, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_37", "type": "text", "x": 470, "y": -22, "width": 1720, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1159380354, "version": 1, "versionNonce": 2036236842, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - THE FIVE THINGS THAT BREAK SHEETS SYNCS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - THE FIVE THINGS THAT BREAK SHEETS SYNCS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_38", "type": "text", "x": 470, "y": 14, "width": 1720, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 279172787, "version": 1, "versionNonce": 260573196, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Wrong types, empty rows, a renamed tab, a moved header, and appending when it should update. Each one gets its own guard before a single cell is written.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Wrong types, empty rows, a renamed tab, a moved header, and appending when it should update. Each one gets its own guard before a single cell is written.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_39", "type": "rectangle", "x": 2390, "y": -122, "width": 352, "height": 490, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1329753548, "version": 1, "versionNonce": 1914012529, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_40", "type": "text", "x": 2412, "y": -106, "width": 308, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1222328496, "version": 1, "versionNonce": 1656961616, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - WRITE IT THE RIGHT WAY", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - WRITE IT THE RIGHT WAY", "lineHeight": 1.25, "autoResize": false}, {"id": "text_41", "type": "text", "x": 2412, "y": -71, "width": 308, "height": 49, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1490376254, "version": 1, "versionNonce": 96907016, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Matched on a key column, so the same record\nupdates its row instead of quietly stacking\nduplicates at the bottom of the sheet.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Matched on a key column, so the same record\nupdates its row instead of quietly stacking\nduplicates at the bottom of the sheet.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_42", "type": "rectangle", "x": 2922, "y": 2, "width": 1068, "height": 326, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1982966163, "version": 1, "versionNonce": 1526706730, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_43", "type": "text", "x": 2944, "y": 18, "width": 1024, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 721762279, "version": 1, "versionNonce": 502922617, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - QUOTA AND AUTH GUARDS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - QUOTA AND AUTH GUARDS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_44", "type": "text", "x": 2944, "y": 54, "width": 1024, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2120395275, "version": 1, "versionNonce": 253207297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Google throttles bursts and OAuth tokens expire. A failed write backs off, refreshes the credential, and retries instead of dying silently.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Google throttles bursts and OAuth tokens expire. A failed write backs off, refreshes the credential, and retries instead of dying silently.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_45", "type": "rectangle", "x": 4188, "y": -50, "width": 1396, "height": 358, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 937195260, "version": 1, "versionNonce": 1234510746, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_46", "type": "text", "x": 4210, "y": -34, "width": 1352, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 555512016, "version": 1, "versionNonce": 1063497604, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - PROVE IT KEEPS WORKING", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - PROVE IT KEEPS WORKING", "lineHeight": 1.25, "autoResize": false}, {"id": "text_47", "type": "text", "x": 4210, "y": 2, "width": 1352, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1708957521, "version": 1, "versionNonce": 1679116189, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "A heartbeat row on a log tab shows the sync is alive, and any node that fails names itself and the row it was on.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "A heartbeat row on a log tab shows the sync is alive, and any node that fails names itself and the row it was on.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_1", "type": "rectangle", "x": -68, "y": 188, "width": 280, "height": 84, "angle": 0, "strokeColor": "#2d6a4f", "backgroundColor": "#b7e4c7", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1390851129, "version": 1, "versionNonce": 647892280, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_2"}, {"type": "arrow", "id": "arrow_48"}], "updated": 1, "link": null, "locked": false}, {"id": "text_2", "type": "text", "x": -56.0, "y": 220.625, "width": 256, "height": 19, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1695753999, "version": 1, "versionNonce": 207388625, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - Record Arrives", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_1", "originalText": "1 - Record Arrives", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_3", "type": "rectangle", "x": 484, "y": 188, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 311111476, "version": 1, "versionNonce"