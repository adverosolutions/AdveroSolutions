baseline": 13, "containerId": null, "originalText": "Your parts 1 and 2: the chatbot goes on\nstaging, and its snippet posts every lead to\nthis one webhook. If it posts through your\nown backend instead, that backend's webhook\npoints here.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_26", "type": "rectangle", "x": 448, "y": -70, "width": 352, "height": 278, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1289560150, "version": 1, "versionNonce": 2126508551, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_27", "type": "text", "x": 470, "y": -54, "width": 308, "height": 55, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1475216846, "version": 1, "versionNonce": 1927728187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - TEST THE LEAD AND\nCONTACT COLLECTION", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - TEST THE LEAD AND\nCONTACT COLLECTION", "lineHeight": 1.25, "autoResize": false}, {"id": "text_28", "type": "text", "x": 470, "y": 9, "width": 308, "height": 49, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1236683273, "version": 1, "versionNonce": 314395343, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part 3: each lead is checked for name,\nemail, phone and message, whatever the\nsnippet calls those fields.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part 3: each lead is checked for name,\nemail, phone and message, whatever the\nsnippet calls those fields.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_29", "type": "rectangle", "x": 998, "y": -70, "width": 352, "height": 278, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 507088657, "version": 1, "versionNonce": 1795823849, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_30", "type": "text", "x": 1020, "y": -54, "width": 308, "height": 55, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 708506837, "version": 1, "versionNonce": 1469118511, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - THE WEBHOOK: LOG EVERY\nCAPTURE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - THE WEBHOOK: LOG EVERY\nCAPTURE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_31", "type": "text", "x": 1020, "y": 9, "width": 308, "height": 49, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 652768598, "version": 1, "versionNonce": 2100080515, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part 4: every capture goes into the\ntest sheet, good or bad, so you can see the\ntest yourself.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part 4: every capture goes into the\ntest sheet, good or bad, so you can see the\ntest yourself.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_32", "type": "rectangle", "x": 1530, "y": -90, "width": 1068, "height": 458, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1811180650, "version": 1, "versionNonce": 168393880, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_33", "type": "text", "x": 1552, "y": -74, "width": 1024, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 333377415, "version": 1, "versionNonce": 1347535309, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - VERIFY IT PASSED CORRECTLY, FLAG WHAT DID NOT", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - VERIFY IT PASSED CORRECTLY, FLAG WHAT DID NOT", "lineHeight": 1.25, "autoResize": false}, {"id": "text_34", "type": "text", "x": 1552, "y": -38, "width": 1024, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1460814403, "version": 1, "versionNonce": 1504004732, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your parts 5 and 6: a complete lead gets a received reply, a broken one gets flagged with the exact field so troubleshooting starts there.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your parts 5 and 6: a complete lead gets a received reply, a broken one gets flagged with the exact field so troubleshooting starts there.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_35", "type": "rectangle", "x": 2796, "y": -134, "width": 700, "height": 262, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2133201996, "version": 1, "versionNonce": 1959386987, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_36", "type": "text", "x": 2818, "y": -118, "width": 656, "height": 55, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 295334610, "version": 1, "versionNonce": 401991736, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - NEXT PHASE: YOUR CRM (SHOWN IN HUBSPOT) AND GOOGLE\nCALENDAR", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - NEXT PHASE: YOUR CRM (SHOWN IN HUBSPOT) AND GOOGLE\nCALENDAR", "lineHeight": 1.25, "autoResize": false}, {"id": "text_37", "type": "text", "x": 2818, "y": -54, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null