{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_41", "type": "rectangle", "x": -104, "y": 90, "width": 2846, "height": 218, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1490376254, "version": 1, "versionNonce": 96907016, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_42", "type": "text", "x": -82, "y": 106, "width": 2802, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1982966163, "version": 1, "versionNonce": 1526706730, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - CUSTOM FIELDS, TAGS AND LEAD SOURCES", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - CUSTOM FIELDS, TAGS AND LEAD SOURCES", "lineHeight": 1.25, "autoResize": false}, {"id": "text_43", "type": "text", "x": -82, "y": 142, "width": 2802, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 721762279, "version": 1, "versionNonce": 502922617, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part on custom fields, tags and lead sources, with the CRM data quality you asked for. Names, phone format and lead source are cleaned, and Pipedrive is searched by email before anyone is created.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part on custom fields, tags and lead sources, with the CRM data quality you asked for. Names, phone format and lead source are cleaned, and Pipedrive is searched by email before anyone is created.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_44", "type": "rectangle", "x": 2942, "y": 30, "width": 352, "height": 278, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2120395275, "version": 1, "versionNonce": 253207297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_45", "type": "text", "x": 2964, "y": 46, "width": 308, "height": 55, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 937195260, "version": 1, "versionNonce": 1234510746, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - LEAD ASSIGNMENT AND\nROUTING", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - LEAD ASSIGNMENT AND\nROUTING", "lineHeight": 1.25, "autoResize": false}, {"id": "text_46", "type": "text", "x": 2964, "y": 109, "width": 308, "height": 49, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 555512016, "version": 1, "versionNonce": 1063497604, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Lead source decides which rep owns the lead\nand which stage the deal opens in. A person\nalready in Pipedrive stays with their rep.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Lead source decides which rep owns the lead\nand which stage the deal opens in. A person\nalready in Pipedrive stays with their rep.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_47", "type": "rectangle", "x": 3472, "y": -90, "width": 1968, "height": 498, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1708957521, "version": 1, "versionNonce": 1679116189, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_48", "type": "text", "x": 3494, "y": -74, "width": 1924, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2132480061, "version": 1, "versionNonce": 346094056, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - CONNECT GHL AND PIPEDRIVE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - CONNECT GHL AND PIPEDRIVE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_49", "type": "text", "x": 3494, "y": -38, "width": 1924, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 714537755, "version": 1, "versionNonce": 1929245187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "One person and one deal per lead in Pipedrive, linked both ways. The Pipedrive deal id goes back onto the GHL contact, and the clean record replaces the messy one.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "One person and one deal per lead in Pipedrive, linked both ways. The Pipedrive deal id goes back onto the GHL contact, and the clean record replaces the messy one.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_50", "type": "rectangle", "x": 448, "y": 90, "width": 1048, "height": 218, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1725048951, "version": 1, "versionNonce": 1193309984, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_51", "type": "text", "x": 470, "y": 106, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 588093311, "version": 1, "versionNonce": 1849076401, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - MIGRATE EXISTING CONTACTS AND OPPORTUNITIES", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - MIGRATE EXISTING CONTACTS AND OPPORTUNITIES", "lineHeight": 1.25, "autoResize": false}, {"id": "text_52", "type": "text", "x": 470, "y": 142, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1195809358, "version": 1, "versionNonce": 1783684942, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Run once before launch. Your existing GHL opportunities and their contacts go through the same cleaner, dedupe and routing as a new lead.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Run once before launch. Your existing GHL opportunities and their contacts go through the same cleaner, dedupe and routing as a new lead.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_53", "type": "rectangle", "x": 1694, "y": 330, "width": 1600, "height": 218, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1540910401, "version": 1, "versionNonce": 1633982922, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_54", "type": "text", "x": 1716, "y": 346, "width": 1556, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 991070208, "version": 1, "versionNonce": 648200382, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - PIPELINE MOVEMENT AND ACTIVITY AUTOMATION", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - PIPELINE MOVEMENT AND ACTIVITY AUTOMATION", "lineHeight": 1.25, "autoResize": false}, {"id": "text_55", "type": "text", "x": 1716, "y": 382, "width": 1556, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 356416555, "version": 1, "versionNonce": 756849393, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "When a rep moves a deal in Pipedrive, the GHL opportunity moves to the same stage and your GHL follow-up workflows fire. The rep's next call is booked on the deal.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "When a rep moves a deal in Pipedrive, the GHL opportunity moves to the same stage and your GHL follow-up workflows fire. The rep's next call is booked on the deal.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_56", "type": "rectangle", "x": 3492, "y": 314, "width": 700, "height": 334, "angle": 0, "strokeColor": "#e8a58f", "backgroundColor": "#fdeae4", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 649821630, "version": 1, "versionNonce": 996247159, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_57", "type": "text", "x": 3514, "y": 330, "width": 656, "height": 28, "angle": 0, "strokeColor": "#8f3416", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1002170859, "version": 1, "versionNonce": 51810463, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "6 - IF A STEP FAILS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "6 - IF A STEP FAILS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_58", "type": "text", "x": 3514, "y": 366, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2082899072, "version": 1, "versionNonce": 783156688, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Any failure emails you the step that stopped and a link to the run, so you can fix it and\nretry.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Any failure emails you the step that stopped and a link to the run, so you can fix it and\nretry.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_1", "type": "rectangle", "x": -68, "y": 188, "width": 280, "height": 84, "angle": 0, "strokeColor": "#2d6a4f", "backgroundColor": "#b7e4c7", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1390851129, "version": 1, "versionNonce": 647892280, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_2"}, {"type": "arrow", "id": "arrow_59"}], "updated": 1, "link": null, "locked": false}, {"id": "text_2", "type": "text", "x": -56.0, "y": 211.25, "width": 256, "height": 38, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1695753999, "version": 1, "versionNonce": 207388625, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - GoHighLevel: New Lead or\nStage Change Sends a Webhook", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_1", "originalText": "1 - GoHighLevel: New Lead or\nStage Cha