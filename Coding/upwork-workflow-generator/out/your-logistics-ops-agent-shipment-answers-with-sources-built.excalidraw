{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_36", "type": "rectangle", "x": -104, "y": -118, "width": 352, "height": 326, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 295334610, "version": 1, "versionNonce": 401991736, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_37", "type": "text", "x": -82, "y": -102, "width": 308, "height": 55, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1159380354, "version": 1, "versionNonce": 2036236842, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - IDENTIFY THE PROCESS:\nQUESTIONS YOUR TEAM ASKS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - IDENTIFY THE PROCESS:\nQUESTIONS YOUR TEAM ASKS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_38", "type": "text", "x": -82, "y": -40, "width": 308, "height": 98, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 279172787, "version": 1, "versionNonce": 260573196, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Discovery starts by ranking the work your\nteam does by hand today: shipment status\nquestions, customer ETA updates, CMR and POD\npaperwork, quoting and invoicing. This\ncanvas builds the first of those so you can\nsee where discovery leads.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Discovery starts by ranking the work your\nteam does by hand today: shipment status\nquestions, customer ETA updates, CMR and POD\npaperwork, quoting and invoicing. This\ncanvas builds the first of those so you can\nsee where discovery leads.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_39", "type": "rectangle", "x": 564, "y": -10, "width": 1452, "height": 420, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1329753548, "version": 1, "versionNonce": 1914012529, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_40", "type": "text", "x": 586, "y": 6, "width": 1408, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1222328496, "version": 1, "versionNonce": 1656961616, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - PRACTICAL TOOLS: N8N, CLAUDE AND A VECTOR STORE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - PRACTICAL TOOLS: N8N, CLAUDE AND A VECTOR STORE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_41", "type": "text", "x": 586, "y": 42, "width": 1408, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1490376254, "version": 1, "versionNonce": 96907016, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Practical means tools your team can run and change. n8n runs the flow, Claude does the reasoning, and a vector store holds your documents.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Practical means tools your team can run and change. n8n runs the flow, Claude does the reasoning, and a vector store holds your documents.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_42", "type": "rectangle", "x": 2284, "y": -106, "width": 720, "height": 342, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1982966163, "version": 1, "versionNonce": 1526706730, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_43", "type": "text", "x": 2306, "y": -90, "width": 676, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 721762279, "version": 1, "versionNonce": 502922617, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - THE AGENT ANSWERS WITH SOURCES OR HANDS OFF", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - THE AGENT ANSWERS WITH SOURCES OR HANDS OFF", "lineHeight": 1.25, "autoResize": false}, {"id": "text_44", "type": "text", "x": 2306, "y": -54, "width": 676, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2120395275, "version": 1, "versionNonce": 253207297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The agent replies only when a tool gave it a source. Anything it cannot source, or anything\nthat needs a decision like a claim or a credit, goes to a person.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The agent replies only when a tool gave it a source. Anything it cannot source, or anything\nthat needs a decision like a claim or a credit, goes to a person.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_45", "type": "rectangle", "x": 3202, "y": 74, "width": 700, "height": 234, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 937195260, "version": 1, "versionNonce": 1234510746, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_46", "type": "text", "x": 3224, "y": 90, "width": 656, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 555512016, "version": 1, "versionNonce": 1063497604, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - INTEGRATED WITH YOUR EXISTING SYSTEMS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - INTEGRATED WITH YOUR EXISTING SYSTEMS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_47", "type": "text", "x": 3224, "y": 126, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1708957521, "version": 1, "versionNonce": 1679116189, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The agent reads and writes your existing shipment system through its API. When it cannot\nanswer, it opens a task there for your ops team.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The agent reads and writes your existing shipment system through its API. When it cannot\nanswer, it opens a task there for your ops team.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_48", "type": "rectangle", "x": 4102, "y": -10, "width": 1396, "height": 218, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2132480061, "version": 1, "versionNonce": 346094056, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_49", "type": "text", "x": 4124, "y": 6, "width": 1352, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 714537755, "version": 1, "versionNonce": 1929245187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - RAG: YOUR SOPS BECOME THE AGENT'S KNOWLEDGE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - RAG: YOUR SOPS BECOME THE AGENT'S KNOWLEDGE", "lineHeight": 1.25, "autoResize": false}, {"id": "text