{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_48", "type": "rectangle", "x": -104, "y": 174, "width": 700, "height": 234, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2132480061, "version": 1, "versionNonce": 346094056, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_49", "type": "text", "x": -82, "y": 190, "width": 656, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 714537755, "version": 1, "versionNonce": 1929245187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - EVERY TICKET AND CHAT ARRIVES HERE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - EVERY TICKET AND CHAT ARRIVES HERE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_50", "type": "text", "x": -82, "y": 226, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1725048951, "version": 1, "versionNonce": 1193309984, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "One entry point for every channel. Before anything is written we know who is asking and what\nthey asked last time.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "One entry point for every channel. Before anything is written we know who is asking and what\nthey asked last time.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_51", "type": "rectangle", "x": 912, "y": 190, "width": 1452, "height": 420, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 588093311, "version": 1, "versionNonce": 1849076401, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_52", "type": "text", "x": 934, "y": 206, "width": 1408, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1195809358, "version": 1, "versionNonce": 1783684942, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - CLAUDE WRITES THE ANSWER FROM YOUR OWN DOCS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - CLAUDE WRITES THE ANSWER FROM YOUR OWN DOCS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_53", "type": "text", "x": 934, "y": 242, "width": 1408, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1540910401, "version": 1, "versionNonce": 1633982922, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "It answers from your help center and past tickets, not from guesswork. It also returns how confident it is.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "It answers from your help center and past tickets, not from guesswork. It also returns how confident it is.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_54", "type": "rectangle", "x": 2632, "y": -90, "width": 1068, "height": 538, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 991070208, "version": 1, "versionNonce": 648200382, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_55", "type": "text", "x": 2654, "y": -74, "width": 1024, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 356416555, "version": 1, "versionNonce": 756849393, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - ROUTE THE ANSWER AND SEND THE REPLY", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - ROUTE THE ANSWER AND SEND THE REPLY", "lineHeight": 1.25, "autoResize": false}, {"id": "text_56", "type": "text", "x": 2654, "y": -38, "width": 1024, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 649821630, "version": 1, "versionNonce": 996247159, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Simple questions get answered and closed. Anything about an account gets answered but stays open.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Simple questions get answered and closed. Anything about an account gets answered but stays open.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_57", "type": "rectangle", "x": 3898, "y": 90, "width": 1048, "height": 478, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1002170859, "version": 1, "versionNonce": 51810463, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_58", "type": "text", "x": 3920, "y": 106, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2082899072, "version": 1, "versionNonce": 783156688, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - HAND OFF TO A HUMAN, LOG EVERY TICKET", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - HAND OFF TO A HUMAN, LOG EVERY TICKET", "lineHeight": 1.25, "autoResize": false}, {"id": "text_59", "type": "text", "x": 3920, "y": 142, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1128488134, "version": 1, "versionNonce": 1210883261, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Low confidence, refunds and complaints go to a person with the draft attached. Every ticket lands in the log either way.", "fontSize": 13, "fontFami