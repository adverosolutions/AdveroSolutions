 write next.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Once a week Claude reads what it got wrong and tells you which help docs to write next.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_1", "type": "rectangle", "x": -68, "y": 288, "width": 280, "height": 84, "angle": 0, "strokeColor": "#2d6a4f", "backgroundColor": "#b7e4c7", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1390851129, "version": 1, "versionNonce": 647892280, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_2"}, {"type": "arrow", "id": "arrow_63"}], "updated": 1, "link": null, "locked": false}, {"id": "text_2", "type": "text", "x": -56.0, "y": 301.875, "width": 256, "height": 56, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1695753999, "version": 1, "versionNonce": 207388625, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - Support Ticket or Chat\nMessage In - From Your Support\nPlatform", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_1", "originalText": "1 - Support Ticket or Chat\nMessage In - From Your Support\nPlatform", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_3", "type": "rectangle", "x": 280, "y": 288, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 311111476, "version": 1, "versionNonce": 404285458, "isDeleted": false, "