@direction LR
@spacing 60

(1 - Rental Inquiry Comes In: rental-inquiry Tag Added) -> [2 - Clear rental-inquiry So Their Next Inquiry Fires Again]
[2 - Clear rental-inquiry So Their Next Inquiry Fires Again] -> [3 - Open the Card Under New Inquiry]
[3 - Open the Card Under New Inquiry] -> [4 - Text Back: Which Dates and Which Car]
[4 - Text Back: Which Dates and Which Car] -> [5 - Email: What You Need to Rent With Us]
[5 - Email: What You Need to Rent With Us] -> [6 - Text You the New Inquiry]
[6 - Text You the New Inquiry] -> [7 - Wait 1 Day]
[7 - Wait 1 Day] -> [8 - Text: Still Need a Car?]
[8 - Text: Still Need a Car?] -> [9 - Goal: They Booked, So No Follow-Up Text]
(10 - You Confirm the Booking: rental-booked Tag Added) -> [11 - Clear rental-booked for Their Next Rental]
[11 - Clear rental-booked for Their Next Rental] -> [12 - Move the Card to Booked - Docs Needed]
[12 - Move the Card to Booked - Docs Needed] -> [13 - Text: You Are Booked, Send License and Insurance]
[13 - Text: You Are Booked, Send License and Insurance] -> [14 - Email: Confirmation, Deposit, Agreement and Rental Rules]
[14 - Email: Confirmation, Deposit, Agreement and Rental Rules] -> [15 - Task: Verify License, Insurance and Deposit Before Pickup]
(16 - Car Comes Back: vehicle-returned Tag Added) -> [17 - Clear vehicle-returned for Their Next Rental]
[17 - Clear vehicle-returned for Their Next Rental] -> [18 - Move the Card to Returned - Inspection]
[18 - Move the Card to Returned - Inspection] -> [19 - Text: Thanks, Deposit Released After Inspection]
[19 - Text: Thanks, Deposit Released After Inspection] -> [20 - Task: Inspect, Log Mileage, Check If Service Is Due]
[20 - Task: Inspect, Log Mileage, Check If Service Is Due] -> [21 - Wait 2 Days While You Inspect]
[21 - Wait 2 Days While You Inspect] -> {22 - Claim Open on This Rental?}
{22 - Claim Open on This Rental?} -> "true" -> [23 - Yes: Stop Here, No Review Ask During a Claim]
{22 - Claim Open on This Rental?} -> "false" -> [24 - No: Move the Card to Rental Completed]
[24 - No: Move the Card to Rental Completed] -> [25 - Send Your Review Request]
(26 - Renter Reports an Accident: accident-reported Tag Added) -> [27 - Clear accident-reported for Any Future Report]
[27 - Clear accident-reported for Any Future Report] -> [28 - Tag claim-open Until the Claim Is Settled]
[28 - Tag claim-open Until the Claim Is Settled] -> [29 - Move the Card to Accident or Claim]
[29 - Move the Card to Accident or Claim] -> [30 - Text: Are You Safe, Then Photos and Police Report]
[30 - Text: Are You Safe, Then Photos and Police Report] -> [31 - Email: Everything We Need to Open the Claim]
[31 - Email: Everything We Need to Open the Claim] -> [32 - Text You the Accident Right Away]
[32 - Text You the Accident Right Away] -> [33 - Task: Open the Accidents/Claims Record and Call Your Insurer]
(34 - A Ticket Comes In: ticket-received Tag Added) -> [35 - Clear ticket-received for the Next Ticket]
[35 - Clear ticket-received for the Next Ticket] -> [36 - Clear an Old ticket-paid Tag]
[36 - Clear an Old ticket-paid Tag] -> [37 - Text the Renter the Ticket and the Fee]
[37 - Text the Renter the Ticket and the Fee] -> [38 - Email: Ticket Details and Your Payment Link]
[38 - Email: Ticket Details and Your Payment Link] -> [39 - Task: Log It in the Tickets Tab, Transfer or Pay]
[39 - Task: Log It in the Tickets Tab, Transfer or Pay] -> [40 - Wait 3 Days for Payment]
[40 - Wait 3 Days for Payment] -> {41 - Still Unpaid?}
{41 - Still Unpaid?} -> "true" -> [42 - Yes: Text a Payment Reminder]
{41 - Still Unpaid?} -> "false" -> [43 - No: Paid, Nothing More to Send]
