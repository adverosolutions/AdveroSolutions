{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_27", "type": "rectangle", "x": -104, "y": -215, "width": 352, "height": 343, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1475216846, "version": 1, "versionNonce": 1927728187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_28", "type": "text", "x": -82, "y": -199, "width": 308, "height": 55, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1236683273, "version": 1, "versionNonce": 314395343, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - CAPTURE LEADS FROM\nYOUR ADS AND WEBSITE FORMS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - CAPTURE LEADS FROM\nYOUR ADS AND WEBSITE FORMS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_29", "type": "text", "x": -82, "y": -136, "width": 308, "height": 114, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 507088657, "version": 1, "versionNonce": 1795823849, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your website and ad landing-page forms post\nevery lead to one webhook, carrying the UTM\ntag your Google and Facebook ads add. That\ntag becomes the lead's source in Zoho. A\nform that drops the tag files the lead as\nWebsite, and your by-source report goes\nflat.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your website and ad landing-page forms post\nevery lead to one webhook, carrying the UTM\ntag your Google and Facebook ads add. That\ntag becomes the lead's source in Zoho. A\nform that drops the tag files the lead as\nWebsite, and your by-source report goes\nflat.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_30", "type": "rectangle", "x": 448, "y": -166, "width": 352, "height": 294, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 708506837, "version": 1, "versionNonce": 1469118511, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_31", "type": "text", "x": 470, "y": -150, "width": 308, "height": 55, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 652768598, "version": 1, "versionNonce": 2100080515, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - ENRICH EACH LEAD\nTHROUGH APOLLO", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - ENRICH EACH LEAD\nTHROUGH APOLLO", "lineHeight": 1.25, "autoResize": false}, {"id": "text_32", "type": "text", "x": 470, "y": -87, "width": 308, "height": 65, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1811180650, "version": 1, "versionNonce": 168393880, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Apollo looks the lead up by work email and\nadds job title, company, website and\nlocation. No match, and the lead carries on\nwithout them.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Apollo looks the lead up by work email and\nadds job title, company, website and\nlocation. No match, and the lead carries on\nwithout them.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_33", "type": "rectangle", "x": 998, "y": -134, "width": 720, "height": 290, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 333377415, "version": 1, "versionNonce": 1347535309, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_34", "type": "text", "x": 1020, "y": -118, "width": 676, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1460814403, "version": 1, "versionNonce": 1504004732, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - ROUTE INTO ZOHO CRM: FIELD MAPPING AND DEDUP", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - ROUTE INTO ZOHO CRM: FIELD MAPPING AND DEDUP", "lineHeight": 1.25, "autoResize": false}, {"id": "text_35", "type": "text", "x": 1020, "y": -82, "width": 676, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2133201996, "version": 1, "versionNonce": 1959386987, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Every field maps to your Zoho CRM lead layout, and Zoho checks email, then phone, before it\nwrites. New leads are created; returning ones are updated and skip the follow-up.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Every field maps to your Zoho CRM lead layout, and Zoho checks email, then phone, before it\nwrites. New leads are created; returning ones are updated and skip the follow-up.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_36", "type": "rectangle", "x": 1898, "y": -118, "width": 1744, "height": 274, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 295334610, "version": 1, "versionNonce": 401991736, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_37", "type": "text", "x": 1920, "y": -102, "width": 1700, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1159380354, "version": 1, "versionNonce": 2036236842, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - FOLLOW-UP SEQUENCE: EMAIL NOW, TEXT NEXT DAY", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - FOLLOW-UP SEQUENCE: EMAIL NOW, TEXT NEXT DAY", "lineHeight": 1.25, "autoResize": false}, {"id": "text_38", "type": "text", "x": 1920, "y": -66, "width": 1700, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 279172787, "version": 1, "versionNonce": 260573196, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Email 1 goes from your Gmail within a minute, BCC'd to Zoho so it shows on the lead. The next day a text goes out, only if Zoho still shows them not contacted.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Email 1 goes from your Gmail within a minute, BCC'd to Zoho so it shows on the lead. The next day a text goes out, only if Zoho still shows them not contacted.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_39", "type": "rectangle", "x": 3840, "y": -90, "width": 1396, "height": 218, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1329753548, "version": 1, "versionNonce": 1914012529, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_40", "type": "text", "x": 3862, "y": -74, "width": 1352, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1222328496, "version": 1, "versionNonce": 1656961616, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - REPORT: LEAD VOLUME AND CONVERSION BY SOURCE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": nu