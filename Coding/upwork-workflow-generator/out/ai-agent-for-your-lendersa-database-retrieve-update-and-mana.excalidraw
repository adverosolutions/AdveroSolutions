{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_34", "type": "rectangle", "x": -104, "y": -10, "width": 1888, "height": 420, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1460814403, "version": 1, "versionNonce": 1504004732, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_35", "type": "text", "x": -82, "y": 6, "width": 1844, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2133201996, "version": 1, "versionNonce": 1959386987, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - AN AI AGENT ON YOUR EXISTING DATABASE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - AN AI AGENT ON YOUR EXISTING DATABASE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_36", "type": "text", "x": -82, "y": 42, "width": 1844, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 295334610, "version": 1, "versionNonce": 401991736, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "You ask your Lendersa database a question in plain English. Claude reads your lenders, loan programs and borrower requests and answers from the real rows, never from memory.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "You ask your Lendersa database a question in plain English. Claude reads your lenders, loan programs and borrower requests and answers from the real rows, never from memory.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_37", "type": "rectangle", "x": 2080, "y": -82, "width": 720, "height": 390, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1159380354, "version": 1, "versionNonce": 2036236842, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_38", "type": "text", "x": 2102, "y": -66, "width": 676, "height": 55, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 279172787, "version": 1, "versionNonce": 260573196, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - RETRIEVE, UPDATE AND MANAGE: UPDATES WAIT FOR YOUR\nYES", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - RETRIEVE, UPDATE AND MANAGE: UPDATES WAIT FOR YOUR\nYES", "lineHeight": 1.25, "autoResize": false}, {"id": "text_39", "type": "text", "x": 2102, "y": -2, "width": 676, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1329753548, "version": 1, "versionNonce": 1914012529, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your parts 2 and 3: retrieving and updating in one smooth chat. A change is shown back to you\nas old value and new value first, and only a yes moves it forward.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your parts 2 and 3: retrieving and updating in one smooth chat. A change is shown back to you\nas old value and new value first, and only a yes moves it forward.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_40", "type": "rectangle", "x": 3000, "y": -106, "width": 1048, "height": 234, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1222328496, "version": 1, "versionNonce": 1656961616, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_41", "type": "text", "x": 3022, "y": -90, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1490376254, "version": 1, "versionNonce": 96907016, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - INTEGRATED WITH YOUR CURRENT DATABASE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - INTEGRATED WITH YOUR CURRENT DATABASE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_42", "type": "text", "x": 3022, "y": -54, "width": 1004, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1982966163, "version": 1, "versionNonce": 1526706730, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The approved change is written to your own Postgres, inside one transaction, only to the tables and columns you allowed. Every change lands\nin a change log you can undo from.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The approved change is written to your own Postgres, inside one transaction, only to the tables and columns you allowed. Every change lands\nin a change log you can undo from.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_43", "type": "rectangle", "x": 4246, "y": -54, "width": 700, "height": 262, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 721762279, "version": 1, "versionNonce": 502922617, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_44", "type": "text", "x": 4268, "y": -38, "width": 656, "height": 55, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2120395275, "version": 1, "versionNonce": 253207297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - RELIABLE PERFORMANCE: IF ANYTHING FAILS, YOU HEAR\nABOUT IT", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - RELIABLE PERFORMANCE: IF ANYTHING FAILS, YOU HEAR\nABOUT IT", "lineHeight": 1.25, "autoResize": false}, {"id": "text_45", "type": "text", "x": 4268, "y": 26, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 937195260, "version": 1, "versionNonce": 1234510746, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "A failed query or a timeout never fails quietly. You get an email with the step, the error\nand a link to the run.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "A failed query or a timeout never fails quietly. You get an email with the step, the error\nand a link to the run.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_1", "type": "rectangle", "x": -68, "y": 88, "width": 280, "height": 84, "angle": 0, "strokeColor": "#2d6a4f", "backgroundColor": "#b7e4c7", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1390851129, "version": 1, "versionNonce": 647892280, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_2"}, {"type": "arrow", "id": "arrow_46"}], "updated": 1, "link": null, "locked": false}, {"id": "text_2", "type": "text", "x": -56.0, "y": 111.25, "width": 256, "height": 38, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1695753999, "version": 1, "versionNonce": 207388625, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - You Ask Your Lendersa\nDatabase in Plain English", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_1", "originalText": "1 - You Ask Your Lendersa\nDatabase in Plain English", "lineHeight": 1.25, "autoResize":