e": 2132084005, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "10 - Every week we test two\nfirst emails and keep the one\nthat books more calls", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_19", "originalText": "10 - Every week we test two\nfirst emails and keep the one\nthat books more calls", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_21", "type": "rectangle", "x": 4022, "y": 8, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1836494975, "version": 1, "versionNonce": 1349251824, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_22"}, {"type": "arrow", "id": "arrow_51"}, {"type": "arrow", "id": "arrow_52"}], "updated": 1, "link": null, "locked": false}, {"id": "text_22", "type": "text", "x": 4034.0, "y": 21.875, "width": 256, "height": 56, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1999744785, "version": 1, "versionNonce": 1946412081, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "11 - Month one shows the sends\nper booked call, then we add\ndomains to reach 30", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_21", "originalText": "11 - Month one shows the sends\nper booked call, then we add\ndomains to reach 30", "lineHeight": 1.25, "autoResize": false}, {"id": "diamond_23", "type": "diamond", "x": 4552, "y": -20, "width": 320, "height": 140, "angle": 0, "strokeColor": "#8a5a00", "backgroundC