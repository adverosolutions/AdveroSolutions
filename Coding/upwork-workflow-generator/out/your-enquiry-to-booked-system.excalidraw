{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_49", "type": "rectangle", "x": -104, "y": -90, "width": 2112, "height": 486, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 714537755, "version": 1, "versionNonce": 1929245187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_50", "type": "text", "x": -82, "y": -74, "width": 2068, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1725048951, "version": 1, "versionNonce": 1193309984, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - CAPTURE AND VALIDATE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - CAPTURE AND VALIDATE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_51", "type": "text", "x": -82, "y": -38, "width": 2068, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 588093311, "version": 1, "versionNonce": 1849076401, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "One form, one webhook. Every enquiry is de-duplicated, standardized and checked against GoHighLevel before anything is created.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "One form, one webhook. Every enquiry is de-duplicated, standardized and checked against GoHighLevel before anything is created.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_52", "type": "rectangle", "x": 2304, "y": -30, "width": 1366, "height": 520, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1195809358, "version": 1, "versionNonce": 1783684942, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_53", "type": "text", "x": 2326, "y": -14, "width": 1322, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1540910401, "version": 1, "versionNonce": 1633982922, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - AI QUALIFICATION, NEVER INVENTED", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - AI QUALIFICATION, NEVER INVENTED", "lineHeight": 1.25, "autoResize": false}, {"id": "text_54", "type": "text", "x": 2326, "y": 22, "width": 1322, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 991070208, "version": 1, "versionNonce": 648200382, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Claude extracts the service, summarizes the enquiry and classifies it. Anything it cannot read is flagged, not guessed.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Claude extracts the service, summarizes the enquiry and classifies it. Anything it cannot read is flagged, not guessed.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_55", "type": "rectangle", "x": 3870, "y": 150, "width": 1396, "height": 218, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 356416555, "version": 1, "versionNonce": 756849393, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_56", "type": "text", "x": 3892, "y": 166, "width": 1352, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 649821630, "version": 1, "versionNonce": 996247159, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - INTO GOHIGHLEVEL", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - INTO GOHIGHLEVEL", "lineHeight": 1.25, "autoResize": false}, {"id": "text_57", "type": "text", "x": 3892, "y": 202, "width": 1352, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1002170859, "version": 1, "versionNonce": 51810463, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Contact, custom fields, tags, opportunity stage and notes. Sales opens one record and sees the whole enquiry.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Contact, custom fields, tags, opportunity stage and notes. Sales opens one record and sees the whole enquiry.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_58", "type": "rectangle", "x": 5464, "y": -10, "width": 1048, "height": 378, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2082899072, "version": 1, "versionNonce": 783156688, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_59", "type": "text", "x": 5486, "y": 6, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1128488134, "version": 1, "versionNonce": 1210883261, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - FOLLOW UP UNTIL THEY REPLY, BOOK OR OPT OUT", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - FOLLOW UP UNTIL THEY REPLY, BOOK OR OPT OUT", "lineHeight": 1.25, "autoResize": false}, {"id": "text_60", "type": "text", "x": 5486, "y": 42, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17581914, "version": 1, "versionNonce": 625675343, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Approved messaging and the booking link go out on a sequence that stops itself the moment the lead responds.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Approved messaging and the booking link go out on a sequence that stops itself the moment the lead responds.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_61", "type": "rectangle", "x": 6712, "y": -10, "width": 1396, "height": 378, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1799361520, "version": 1, "versionNonce": 1585932014, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_62", "type": "text", "x": 6734, "y": 6, "width": 1352, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1368426742, "version": 1, "versionNonce": 538981927, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - LOGS, RETRIES AND ALERTS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - LOGS, RETRIES AND ALERTS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_63", "type": "text", "x": 6734, "y": 42, "width": 1352, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 231897702, "version": 1, "versionNonce": 1961269854, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Every run writes a log row. A failed step retries once on a delay, then it tells you instead of failing quietly.", "fontSize": 13, "fon