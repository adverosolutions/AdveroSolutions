": 1, "link": null, "locked": false, "text": "10 - Each campaign asks for\none thing, either a booked\nmeeting or an online sign-up", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_19", "originalText": "10 - Each campaign asks for\none thing, either a booked\nmeeting or an online sign-up", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_21", "type": "rectangle", "x": 4022, "y": 8, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1836494975, "version": 1, "versionNonce": 1349251824, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_22"}, {"type": "arrow", "id": "arrow_51"}, {"type": "arrow", "id": "arrow_52"}], "updated": 1, "link": null, "locked": false}, {"id": "text_22", "type": "text", "x": 4034.0, "y": 12.5, "width": 256, "height": 75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1999744785, "version": 1, "versionNonce": 1946412081, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "11 - Replies land in one\nunibox, and clicks,\nappointments and sign-ups are\nall tracked", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_21", "originalText": "11 - Replies land in one\nunibox, and clicks,\nappointments and sign-ups are\nall tracked", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_23", "type": "rectangle", "x": 4370, "y": 8, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "s