e", "baseline": 15, "containerId": "rectangle_13", "originalText": "7 - Each email has your postal\naddress and a working opt-out,\nand uses business data only", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_15", "type": "rectangle", "x": 2774, "y": 8, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 619570853, "version": 1, "versionNonce": 505913793, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_16"}, {"type": "arrow", "id": "arrow_48"}, {"type": "arrow", "id": "arrow_49"}], "updated": 1, "link": null, "locked": false}, {"id": "text_16", "type": "text", "x": 2786.0, "y": 21.875, "width": 256, "height": 56, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1324919353, "version": 1, "versionNonce": 776213900, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "8 - Claude researches each\npractice so every email opens\nwith something true about it", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_15", "originalText": "8 - Claude researches each\npractice so every email opens\nwith something true about it", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_17", "type": "rectangle", "x": 3122, "y": 8, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 442620899, "version": 1, "versionNonce": 806899910, "isDeleted": false, "