{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_33", "type": "rectangle", "x": -104, "y": 74, "width": 700, "height": 234, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 333377415, "version": 1, "versionNonce": 1347535309, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_34", "type": "text", "x": -82, "y": 90, "width": 656, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1460814403, "version": 1, "versionNonce": 1504004732, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - A REQUEST COMES IN", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - A REQUEST COMES IN", "lineHeight": 1.25, "autoResize": false}, {"id": "text_35", "type": "text", "x": -82, "y": 126, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2133201996, "version": 1, "versionNonce": 1959386987, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Any website form, inbox or app that can send a webhook plugs in here. The fields get tidied\nfirst, so a messy entry never breaks a later step.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Any website form, inbox or app that can send a webhook plugs in here. The fields get tidied\nfirst, so a messy entry never breaks a later step.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_36", "type": "rectangle", "x": 912, "y": 74, "width": 1018, "height": 436, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 295334610, "version": 1, "versionNonce": 401991736, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_37", "type": "text", "x": 934, "y": 90, "width": 974, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1159380354, "version": 1, "versionNonce": 2036236842, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - OPENAI READS IT AND WRITES THE REPLY", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - OPENAI READS IT AND WRITES THE REPLY", "lineHeight": 1.25, "autoResize": false}, {"id": "text_38", "type": "text", "x": 934, "y": 126, "width": 974, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 279172787, "version": 1, "versionNonce": 260573196, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "One OpenAI call returns the category, urgency, key details and a ready reply, in a fixed format. Every request is logged to the sheet\nbefore anything else happens.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "One OpenAI call returns the category, urgency, key details and a ready reply, in a fixed format. Every request is logged to the sheet\nbefore anything else happens.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_39", "type": "rectangle", "x": 2110, "y": -106, "width": 1068, "height": 714, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1329753548, "version": 1, "versionNonce": 1914012529, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_40", "type": "text", "x": 2132, "y": -90, "width": 1024, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1222328496, "version": 1, "versionNonce": 1656961616, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - THE RIGHT PERSON HEARS ABOUT IT", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - THE RIGHT PERSON HEARS ABOUT IT", "lineHeight": 1.25, "autoResize": false}, {"id": "text_41", "type": "text", "x": 2132, "y": -54, "width": 1024, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1490376254, "version": 1, "versionNonce": 96907016, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Quote requests get a reply in seconds and sales gets the summary. Support issues, and anything the AI is unsure about, wait as a Gmail draft a\nperson approves. Spam stops here.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Quote requests get a reply in seconds and sales gets the summary. Support issues, and anything the AI is unsure about, wait as a Gmail draft a\nperson approves. Spam stops here.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_42", "type": "rectangle", "x": 3376, "y": 14, "width": 1048, "height": 294, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1982966163, "version": 1, "versionNonce": 1526706730, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_43", "type": "text", "x": 3398, "y": 30, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 721762279, "version": 1, "versionNonce": 502922617, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - CLOSE THE LOOP, FAIL LOUDLY", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - CLOSE THE LOOP, FAIL LOUDLY", "lineHeight": 1.25, "autoResize": false}, {"id": "text_44", "type": "text", "x": 3398, "y": 66, "width": 1004, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2120395275, "version": 1, "versionNonce": 253207297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The row is marked handled with the Slack link and the time it took, so the team sees status in one place. If any step fails, Slack gets an\nalert with a link to the failed run.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The row is marked handled with the Slack link and the time it took, so the team sees status in one place. If any step fails, Slack gets an\nalert with a link to the failed run.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_1", "type": "rectangle", "x": -68, "y": 188, "width": 280, "height": 84, "angle": 0, "strokeColor": "#2d6a4f", "backgroundColor": "#b7e4c7", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1390851129, "version": 1, "versionNonce": 647892280, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_2"}, {"type": "arrow", "id": "arrow_45"}], "updated": 1, "link": null, "locked": false}, {"id": "text_2", "type": "text", "x": -56.0, "y": 220.625, "width": 256, "height": 19, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1695753999, "version": 1, "versionNonce": 207388625, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - New Request Comes In", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_1", "originalText": "1 - New Request Comes In", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_3", "type": "rectangle", "x": 280, "y": 188, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444"