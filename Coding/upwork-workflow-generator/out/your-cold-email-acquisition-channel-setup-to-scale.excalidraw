: null, "originalText": "Everything sends from lookalike domains on your card. 30 a day per mailbox, 3 mailboxes per domain, warmed before a single email goes out.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_36", "type": "rectangle", "x": 1144, "y": -30, "width": 1048, "height": 458, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 295334610, "version": 1, "versionNonce": 401991736, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_37", "type": "text", "x": 1166, "y": -14, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1159380354, "version": 1, "versionNonce": 2036236842, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - TWO LISTS, BOTH CLEANED BEFORE THEY LOAD", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - TWO LISTS, BOTH CLEANED BEFORE THEY LOAD", "lineHeight": 1.25, "autoResize": false}, {"id": "text_38", "type": "text", "x": 1166, "y": 22, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 279172787, "version": 1, "versionNonce": 260573196, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Distressed-owner data and agent data come from different places and get different treatment. Nothing loads until it is verified.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Distressed-owner data and agent data come from different places and get different treatment. Nothing loads until it is verified.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_39", "type": "rectangle", "x": 2390, "y": -10, "width": 1048, "height": 218, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1329753548, "version": 1, "versionNonce": 1914012529, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_40", "type": "text", "x": 2412, "y": 6, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1222328496, "version": 1, "versionNonce": 1656961616, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - COPY THAT READS LIKE A PERSON WROTE IT", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - COPY THAT READS LIKE A PERSON WROTE IT", "lineHeight": 1.25, "autoResize": false}, {"id": "text_41", "type": "text", "x": 2412, "y": 42, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1490376254, "version": 1, "versionNonce": 96907016, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Plain text, short, one ask. Sellers and agents get their own sequences with a first line pulled from the record.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Plain text, short, one ask. Sellers and agents get their own sequences with a first line pulled from the record.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_42", "type": "rectangle", "x": 3638, "y": -38, "width": 1048, "height": 346, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1982966163, "version": 1, "versionNonce": 1526706730, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_43", "type": "text", "x": 3660, "y": -22, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 721762279, "version": 1, "versionNonce": 502922617, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - TWO WEEKS AT LOW VOLUME BEFORE WE SCALE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - TWO WEEKS AT LOW VOLUME BEFORE WE SCALE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_44", "type": "text", "x": 3660, "y": 14, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2120395275, "version": 1, "versionNonce": 253207297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Bounce, reply, positive reply and spam complaints decide what scales. Losers get cut, winners get more inboxes.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Bounce, reply, positive reply and spam complaints decide what scales. Losers get cut, winners get more inboxes.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_45", "type": "rectangle", "x": 4884, "y": -106, "width": 1048, "height": 234, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 937195260, "version": 1, "versionNonce": 1234510746, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_46", "type": "text", "x": 4906, "y": -90, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 555512016, "version": 1, "versionNonce": 1063497604, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - SCALE IT, THEN YOUR TEAM RUNS IT", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - SCALE IT, THEN YOUR TEAM RUNS IT", "lineHeight": 1.25, "autoResize": false}, {"id": "text_47", "type": "text", "x": 4906, "y": -54, "width": 1004, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1708957521, "version": 1, "versionNonce": 1679116189, "isDeleted": false, "boundElements": [], "updated": 1,