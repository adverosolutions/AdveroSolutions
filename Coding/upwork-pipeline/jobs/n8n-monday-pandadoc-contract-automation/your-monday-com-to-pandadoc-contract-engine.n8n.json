        800,
        -120
      ]
    },
    {
      "parameters": {
        "content": "## 3 - CHECK EVERYTHING BEFORE ANYTHING IS SENT\n\nRequired fields present, amounts parse as numbers, dates are real dates. Anything short of that stops here and a person looks at it.",
        "height": 640,
        "width": 460,
        "color": 6
      },
      "id": "9d59b185-8db8-5aaf-b9a6-f3887bdd120c",
