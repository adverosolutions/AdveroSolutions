      "typeVersion": 1,
      "position": [
        -60,
        -120
      ]
    },
    {
      "parameters": {
        "content": "## 2 - PULL THE FIELDS OUT OF THE PDF\n\nText first, then one extraction step that returns a fixed JSON schema. Scanned PDFs get routed to OCR instead of failing.",
        "height": 640,
        "width": 1200,
        "color": 4
      },
      "id": "bcbd4b1d-894c-56c0-9108-95ea892f71e6",
