{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_52", "type": "rectangle", "x": -104, "y": 242, "width": 2092, "height": 326, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1195809358, "version": 1, "versionNonce": 1783684942, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_53", "type": "text", "x": -82, "y": 258, "width": 2048, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1540910401, "version": 1, "versionNonce": 1633982922, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - DISCOVER", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - DISCOVER", "lineHeight": 1.25, "autoResize": false}, {"id": "text_54", "type": "text", "x": -82, "y": 294, "width": 2048, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 991070208, "version": 1, "versionNonce": 648200382, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Outscraper works one zip cluster a morning and pulls the buildings that actually buy cleaning. Nobody uploads a list.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Outscraper works one zip cluster a morning and pulls the buildings that actually buy cleaning. Nobody uploads a list.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_55", "type": "rectangle", "x": 2188, "y": 162, "width": 1048, "height": 326, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 356416555, "version": 1, "versionNonce": 756849393, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_56", "type": "text", "x": 2210, "y": 178, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 649821630, "version": 1, "versionNonce": 996247159, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - ENRICH", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - ENRICH", "lineHeight": 1.25, "autoResize": false}, {"id": "text_57", "type": "text", "x": 2210, "y": 214, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1002170859, "version": 1, "versionNonce": 51810463, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Apollo turns a building into a named facilities or office manager with a verified email. No name, no guessing, it parks.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Apollo turns a building into a named facilities or office manager with a verified email. No name, no guessing, it parks.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_58", "type": "rectangle", "x": 3522, "y": 62, "width": 1686, "height": 448, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2082899072, "version": 1, "versionNonce": 783156688, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_59", "type": "text", "x": 3544, "y": 78, "width": 1642, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1128488134, "version": 1, "versionNonce": 1210883261, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - RESEARCH AND SCORE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - RESEARCH AND SCORE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_60", "type": "text", "x": 3544, "y": 114, "width": 1642, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17581914, "version": 1, "versionNonce": 625675343, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The agent reads the site and the Google profile, then scores the account on size, foot traffic, vendor signals and hiring.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The agent reads the site and the Google profile, then scores the account on size, foot traffic, vendor signals and hiring.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_61", "type": "rectangle", "x": 5406, "y": -90, "width": 1744, "height": 458, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1799361520, "version": 1, "versionNonce": 1585932014, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_62", "type": "text", "x": 5428, "y": -74, "width": 1700, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1368426742, "version": 1, "versionNonce": 538981927, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - HUMAN APPROVAL, THEN THE CRM", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - HUMAN APPROVAL, THEN THE CRM", "lineHeight": 1.25, "autoResize": false}, {"id": "text_63", "type": "text", "x": 5428, "y": -38, "width": 1700, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 231897702, "version": 1, "versionNonce": 1961269854, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Nothing reaches HighLevel until a human says yes. The morning list posts to Slack, one tap approves, one tap rejects with a reason.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Nothing reaches HighLevel until a human says yes. The morning list posts to Slack, one tap approves, one tap rejects with a reason.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_64", "type": "rectangle", "x": 7350, "y": -90, "width": 1048, "height": 578, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1685254564, "version": 1, "versionNonce": 1709696036, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_65", "type": "text", "x": 7372, "y": -74, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1713601029, "version": 1, "versionNonce": 1692732590, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - LOGS, DEDUPE, ALERTS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - LOGS, DEDUPE, ALERTS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_66", "type": "text", "x": 7372, "y": -38, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 444688429, "version": 1, "versionNonce": 2068124765, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Postgres is the dedupe key, by place id and normalized phone, so the same building never shows up twice. Every failure names its node.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Postgres is the dedupe key, by place id and normalized phone, so the same building never shows up twice. Every failure names its node.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_1", "type": "rectangle", "x": -68, "y": 368, "width": 280, "height": 84, "angle": 0, "strokeColor": "#2d6a4f", "backgroundColor": "#b7e4c7", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1390851129, "version": 1, "versionNonce": 647892280, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_2"}, {"type": "arrow", "id": "arrow_67"}], "updated": 1, "link": null, "locked": false}, {"id": "text_2", "type": "text", "x": -56.0, "y": 391.25, "width": 256, "height": 38, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1695753999, "version": 1, "versionNonce": 207388625, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - Every Weekday at 5am, Next\nZip Cluster", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_1", "originalText": "1 - Every Weekday at 5am, Next\nZip Cluster", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_3", "type": "rectangle", "x": 280, "y": 368, "width": 280, "height": 84, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "#b5e5ec", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 311111476, "version": 1, "versionNonce": 404285458, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_4"}, {"type": "arrow"