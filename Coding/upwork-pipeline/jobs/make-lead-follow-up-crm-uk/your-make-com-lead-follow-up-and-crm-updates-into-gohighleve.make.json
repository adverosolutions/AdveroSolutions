{
  "name": "Your Make.com Lead Follow-Up and CRM Updates Into GoHighLevel",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 12421,
        "maxResults": 1,
        "path": "website-enquiries"
      },
      "mapper": {
        "maxResults": 1
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "1 - New Lead From Your Website Form"
        },
        "restore": {}
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {
        "scope": "roundtrip"
      },
      "mapper": {
        "name": "sample_input",
        "scope": "roundtrip",
        "value": "{\n  \"full_name\": \"hannah whitlock\",\n  \"email\": \"Hannah.Whitlock@outlook.com\",\n  \"phone\": \"07700 900418\",\n  \"message\": \"Hi, I'd like to book an initial consultation. Are you free any evenings next week? Thanks\",\n  \"form_name\": \"Website contact form\",\n  \"submitted_at\": \"2026-09-24T18:42:00+01:00\"\n}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Sample Input"
        },
        "restore": {}
      }
    },
    {
      "id": 3,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {},
      "mapper": {
        "select": "chat",
        "model": "gpt-4.1",
        "messages": [
          {
            "role": "system",
            "content": "You read new website enquiries for PASTE-YOUR-BUSINESS-NAME, a UK business that manages its leads in GoHighLevel. Services: PASTE-YOUR-SERVICE-LIST. Booking link: PASTE-YOUR-BOOKING-LINK. Write in British English, warm and brief, as the business (we), with no emojis and no exclamation marks. Never quote a price, promise a time slot or add anything the enquiry does not say.\nReturn one JSON object with these keys and nothing else:\nis_real_lead: true for anyone asking about a service, however short the message. false for spam, test entries, sales pitches, SEO or web design offers, link-only messages and gibberish.\nfirst_name, last_name: split from the full name with normal capitalisation. If only one name is given, leave last_name empty.\nemail: lowercased and trimmed. Empty if missing or clearly fake.\nphone: international format with no spaces, so GoHighLevel can text it. A UK mobile starting 07 becomes +447...; a number that already starts with + stays as it is; if you cannot tell the country, return it exactly as typed. Empty if there is none.\nservice: the closest match from the services list, or other.\nmessage_clean: their message on one line, line breaks replaced with spaces and double quotes with single quotes.\nsummary: one sentence a colleague reads before calling them back, including anything time-sensitive they mentioned.\nsms_reply: the first text back, under 320 characters (two SMS segments). Use their first name, answer what they asked in one line and end with the booking link. If the message is empty, thank them for getting in touch and ask what they need help with.\nNo value may contain a line break or a double quote."
          },
          {
            "role": "user",
            "content": "New enquiry from {{1.form_name}}, received {{1.submitted_at}}.\nFull name: {{1.full_name}}\nEmail: {{1.email}}\nPhone: {{1.phone}}\nMessage: {{1.message}}\n\nReturn the JSON object: is_real_lead, first_name, last_name, email, phone, service, message_clean, summary, sms_reply."
          }
        ],
        "max_tokens": "800",
        "temperature": "0.3",
        "n_completions": "1",
        "response_format": "json_object"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "2 - Read the Enquiry and Write the First Reply"
        },
        "restore": {}
      }
    },
    {
