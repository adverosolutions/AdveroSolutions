      "typeVersion": 1,
      "position": [
        1920,
        -120
      ]
    },
    {
      "parameters": {
        "content": "## 4 - DEDUPE AND ADD TO THE RIGHT CAMPAIGN\n\nSkips anyone already in a campaign, then routes by segment: local service, medtech, or B2B.",
        "height": 1000,
        "width": 940,
        "color": 7
      },
      "id": "40ff3856-f880-5670-bbd5-e3bb89d2a922",
