{
  "title": "Prospect Research, Fit-Check, Verify, Route to Hunter Campaign",
  "platform": "n8n",
  "sections": [
    {
      "key": "pull",
      "label": "1 · PULL TODAY'S CANDIDATE COMPANIES",
      "color": 0,
      "note": "Runs every weekday morning. Pulls a small batch from the source list and works through it one company at a time."
    },
    {
      "key": "fit",
      "label": "2 · RESEARCH AND FIT-CHECK AGAINST YOUR CRITERIA",
      "color": 0,
      "note": "Claude reads the company site and judges it against your written criteria. Anything it is not sure about gets rejected with the reason, not added."
    },
    {
      "key": "contact",
      "label": "3 · FIND AND VERIFY THE DECISION-MAKER",
      "color": 0,
      "note": "Hunter finds the right person by title, then verifies the address. Unverified emails never reach a campaign."
    },
    {
      "key": "route",
      "label": "4 · DEDUPE AND ADD TO THE RIGHT CAMPAIGN",
      "color": 0,
      "note": "Skips anyone already in a campaign, then routes by segment: local service, medtech, or B2B."
    },
    {
      "key": "digest",
      "label": "5 · LOG EVERY DECISION, SEND THE DAILY DIGEST",
      "color": 0,
      "note": "Every company lands in the log, added or rejected, with the reason. One Slack message a day shows both lists."
    }
  ],
  "nodes": [
    {
      "key": "cron",
      "kind": "trigger.schedule",
      "label": "1 · Every Weekday at 7am",
      "section": "pull"
    },
    {
      "key": "source",
      "kind": "net.http",
      "app": "apollo",
      "op": "search_companies",
      "label": "2 · Apollo: Pull Candidate Companies by Industry and Size",
      "section": "pull",
      "notes": "Swap for Google Maps or a CSV of accounts. Same shape downstream."
    },
    {
      "key": "loop",
      "kind": "data.split",
      "label": "3 · Work Through One Company at a Time",
      "section": "pull"
    },
    {
      "key": "agent",
      "kind": "ai.agent",
      "label": "4 · Fit-Check Against Your Written Criteria",
      "section": "fit",
      "notes": "Reads the site, decides fit, names the segment, gives the reason."
    },
    {
      "key": "model",
      "kind": "ai.model",
      "app": "anthropic",
      "label": "Claude",
      "parent": "agent",
      "port": "ai_languageModel"
    },
    {
      "key": "site",
      "kind": "ai.tool",
      "label": "Read the Company Website and About Page",
      "parent": "agent",
      "port": "ai_tool"
    },
    {
      "key": "parser",
      "kind": "ai.parser",
      "label": "Force: Fit Yes/No, Segment, Confidence, Reason",
      "parent": "agent",
      "port": "ai_outputParser"
    },
    {
      "key": "fits",
      "kind": "flow.branch",
      "label": "5 · Does It Fit, With High Confidence?",
      "section": "fit"
    },
    {
      "key": "finddm",
      "kind": "net.http",
      "app": "hunter",
      "op": "domain_search",
      "label": "6 · Hunter: Find Decision-Maker by Domain and Title",
      "section": "contact",
      "notes": "Owner or founder for local service, VP Marketing or CMO for medtech and B2B."
    },
    {
      "key": "verify",
      "kind": "net.http",
      "app": "hunter",
      "op": "verify_email",
      "label": "7 · Hunter: Verify the Email Address",
      "section": "contact"
    },
    {
      "key": "deliverable",
      "kind": "flow.branch",
      "label": "8 · Is the Email Deliverable?",
      "section": "contact"
    },
    {
      "key": "dedupe",
      "kind": "net.http",
      "app": "hunter",
      "op": "search_leads",
      "label": "9 · Hunter: Check if Already in Any Campaign",
      "section": "route"
    },
    {
      "key": "isnew",
      "kind": "flow.branch",
      "label": "10 · Is This a Brand New Lead?",
      "section": "route"
    },
    {
      "key": "segment",
      "kind": "flow.switch",
      "label": "11 · Route by Segment",
      "section": "route"
    },
    {
      "key": "addlocal",
      "kind": "net.http",
      "app": "hunter",
      "op": "add_lead_local",
      "label": "12a · Hunter: Add to Local Service Campaign",
      "section": "route"
    },
    {
      "key": "addmed",
      "kind": "net.http",
      "app": "hunter",
      "op": "add_lead_medtech",
      "label": "12b · Hunter: Add to Medtech Campaign",
      "section": "route"
    },
    {
      "key": "addb2b",
      "kind": "net.http",
      "app": "hunter",
      "op": "add_lead_b2b",
      "label": "12c · Hunter: Add to B2B Campaign",
      "section": "route"
    },
    {
      "key": "log",
      "kind": "app.action",
      "app": "googleSheets",
      "op": "append",
      "label": "13 · Log the Decision: Added or Rejected, and Why",
      "section": "digest"
    },
    {
      "key": "slack",
      "kind": "app.action",
      "app": "slack",
      "op": "post",
      "label": "14 · Slack: Daily Digest of Added, Rejected, and Reasons",
      "section": "digest"
    },
    {
      "key": "err",
      "kind": "trigger.app",
      "app": "n8n",
      "op": "error_trigger",
      "label": "15 · Any Node Fails, Anywhere",
      "section": "digest"
    },
    {
      "key": "alert",
      "kind": "app.action",
      "app": "slack",
      "op": "post",
      "label": "16 · Slack: Alert With a Link to the Failed Run",
      "section": "digest"
    }
  ],
  "edges": [
    {
      "from": "cron",
      "to": "source"
    },
    {
      "from": "source",
      "to": "loop"
    },
    {
      "from": "loop",
      "to": "agent",
      "branch": "loop"
    },
    {
      "from": "loop",
      "to": "slack",
      "branch": "done"
    },
    {
      "from": "agent",
      "to": "fits"
    },
    {
      "from": "fits",
      "to": "finddm",
      "branch": "true"
    },
    {
      "from": "fits",
      "to": "log",
      "branch": "false"
    },
    {
      "from": "finddm",
      "to": "verify"
    },
    {
      "from": "verify",
      "to": "deliverable"
    },
    {
      "from": "deliverable",
      "to": "dedupe",
      "branch": "true"
    },
    {
      "from": "deliverable",
      "to": "log",
      "branch": "false"
    },
    {
      "from": "dedupe",
      "to": "isnew"
    },
    {
      "from": "isnew",
      "to": "segment",
      "branch": "true"
    },
    {
      "from": "isnew",
      "to": "log",
      "branch": "false"
    },
    {
      "from": "segment",
      "to": "addlocal",
      "branch": "Local Service"
    },
    {
      "from": "segment",
      "to": "addmed",
      "branch": "Medtech"
    },
    {
      "from": "segment",
      "to": "addb2b",
      "branch": "B2B"
    },
    {
      "from": "addlocal",
      "to": "log"
    },
    {
      "from": "addmed",
      "to": "log"
    },
    {
      "from": "addb2b",
      "to": "log"
    },
    {
      "from": "log",
      "to": "loop",
      "loop": true
    },
    {
      "from": "err",
      "to": "alert"
    }
  ],
