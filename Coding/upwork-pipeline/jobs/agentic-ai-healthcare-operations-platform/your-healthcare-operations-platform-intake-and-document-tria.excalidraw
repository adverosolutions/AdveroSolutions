{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_59", "type": "rectangle", "x": -104, "y": 174, "width": 1396, "height": 474, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1128488134, "version": 1, "versionNonce": 1210883261, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_60", "type": "text", "x": -82, "y": 190, "width": 1352, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17581914, "version": 1, "versionNonce": 625675343, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - INTAKE SUPPORT AND DOCUMENT TRIAGE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - INTAKE SUPPORT AND DOCUMENT TRIAGE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_61", "type": "text", "x": -82, "y": 226, "width": 1352, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1799361520, "version": 1, "versionNonce": 1585932014, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part 1, intake support and document triage; its internal task routing lands in section 4. Staff send an item from the portal, their role is checked and patient identifiers are masked\nbefore any model sees it.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part 1, intake support and document triage; its internal task routing lands in section 4. Staff send an item from the portal, their role is checked and patient identifiers are masked\nbefore any model sees it.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_62", "type": "rectangle", "x": 1492, "y": 146, "width": 2460, "height": 342, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1368426742, "version": 1, "versionNonce": 538981927, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_63", "type": "text", "x": 1514, "y": 162, "width": 2416, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 231897702, "version": 1, "versionNonce": 1961269854, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - RAG OVER YOUR POLICIES, SOPS, FORMS AND SERVICE GUIDELINES", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - RAG OVER YOUR POLICIES, SOPS, FORMS AND SERVICE GUIDELINES", "lineHeight": 1.25, "autoResize": false}, {"id": "text_64", "type": "text", "x": 1514, "y": 198, "width": 2416, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1685254564, "version": 1, "versionNonce": 1709696036, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part 2, and your question on keeping the AI useful as the knowledge base grows: each item is matched only against the active version of your own documents, filtered by service line and by what the staff role may see. When an admin edits a document, KB 1 to KB 4 re-index it and retire the old version, so no answer cites an\noutdated SOP; items with no matching passage are logged as gaps, so admins see what to write next.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part 2, and your question on keeping the AI useful as the knowledge base grows: each item is matched only against the active version of your own documents, filtered by service line and by what the staff role may see. When an admin edits a document, KB 1 to KB 4 re-index it and retire the old version, so no answer cites an\noutdated SOP; items with no matching passage are logged as gaps, so admins see what to write next.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_65", "type": "rectangle", "x": 4218, "y": -38, "width": 2198, "height": 648, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1713601029, "version": 1, "versionNonce": 1692732590, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_66", "type": "text", "x": 4240, "y": -22, "width": 2154, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 444688429, "version": 1, "versionNonce": 2068124765, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - CLAUDE FIRST, OPENAI AS FALLBACK, CLEAR BOUNDARIES", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - CLAUDE FIRST, OPENAI AS FALLBACK, CLEAR BOUNDARIES", "lineHeight": 1.25, "autoResize": false}, {"id": "text_67", "type": "text", "x": 4240, "y": 14, "width": 2154, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1719888007, "version": 1, "versionNonce": 267352361, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part 3: Claude triages from the matched passages only, cites them and never makes a clinical call. If Claude fails, OpenAI runs the same rules; anything unsure, uncited or clinical goes to a person.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part 3: Claude triages from the matched passages only, cites them and never makes a clinical call. If Claude fails, OpenAI runs the same rules; anything unsure, uncited or clinical goes to a person.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_68", "type": "rectangle", "x": 6596, "y": -198, "width": 352, "height": 686, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 818661758, "version": 1, "versionNonce": 289255806, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_69", "type": "text", "x": 6618, "y": -182, "width": 308, "height": 55, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 896631051, "version": 1, "versionNonce": 1892478002, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - ROUTE THE TASK OR SEND\nIT TO THE REVIEW QUEUE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - ROUTE THE TASK OR SEND\nIT TO THE REVIEW QUEUE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_70", "type": "text", "x": 6618, "y": -120, "width": 308, "height": 98, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 697086886, "version": 1, "versionNonce": 472138490, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your parts 4 and 5: the API call into your\ninternal tools, and the review queue behind\nyour admin screen. Confident, cited items\nbecome a task in the right queue; everything\nelse waits for staff to approve, edit or\nreject it.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your parts 4 and 5: the API call into your\ninternal tools, and the review queue behind\nyour admin screen. Confident, cited items\nbecome a task in the right queue; everything\nelse waits for staff to approve, edit or\nreject it.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_71", "type": "rectangle", "x": 7146, "y": 142, "width": 1048, "height": 266, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1460519318, "version": 1, "versionNonce": 225810526, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_72", "type": "text", "x": 7168, "y": 158, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 439717025, "version": 1, "versionNonce": 1001929, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - AUDIT TRAIL, PERMISSIONS AND THE STAFF SCREEN", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - AUDIT TRAIL, PERMISSIONS AND THE STAFF SCREEN", "lineHeight": 1.25, "autoResize": false}, {"id": "text_73", "type": "text", "x": 7168, "y": 193, "width": 1004, "height": 65, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 649677952, "version": 1, "versionNonce": 435786141, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your parts 6 and 7: logging, permissions and audit trail, then the staff web interface. Permissions are checked at steps 2 and 3 and filter\nretrieval at step 6; every action, that check included, gets its own append-only audit row with who, what, which sources and which model,\nand the staff screen shows status, owner, next steps and sources in plain words. Every later workflow reuses sections 2 to 5 as they are, so\nnew workflows can be added without rebuilding the entire system.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your parts 6 and 7: logging, permissions and audit trail, then the staff web interface. Permissions are checked at steps 2 and 3 and filter\nretrieval at step 6; every action, that check included, gets its own append-only audit row with who, what, which sources and which model,\nand the staff screen shows status, owner, next steps and sources in plain words. Every later workflow reuses sections 2 to 5 as they are, so\nnew workflows can be added without rebuilding the entire system.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_74", "type": "rectangle", "x": 8394, "y": 254, "width": 700, "height": 234, "angle": 0, "strokeColor": "#e8a58f", "backgroundColor": "#fdeae4", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1561692720, "version": 1, "versionNonce": 109525499, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_75", "type": "text", "x": 8416, "y": 270, "width": 656, "height": 28, "angle": 0, "strokeColor": "#8f3416", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 302003102, "version": 1, "versionNonce": 893149981, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "6 - IF ANY STEP FAILS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "6 - IF ANY STEP FAILS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_76", "type": "text", "x": 8416, "y": 306, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1615892811, "version": 1, "versionNonce": 638019486, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The item is held for manual handling, the failure is logged, and the admin screen is flagged\nwith no patient details in the alert, so nothing sits silently.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The item is held for manual handling, the failure is logged, and the admin screen is flagged\nwith no patient details in the alert, so nothing sits silently.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_1", "type": "rectangle", "x": -68, "y": 368, "width": 280, "height": 84, "angle": 0, "strokeColor": "#2d6a4f", "backgroundColor": "#b7e4c7", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1390851129, "version": 1, "versionNonce": 647892280, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_2"}, {"type": "arrow", "id": "arrow_77"}], "updated": 1, "link": null, "locked": false}, {"id": "text_2", "type": "text", "x": -56.0, "y": 391.25, "width": 256, "height": 38, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1695753999, "version": 1, "versionNonce": 207388625, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - New Intake Item or\nDocument From the Staff Portal", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_1", "originalText": "1 - New Intake Item or\nDocument From the Staff Portal", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_3", "type": "rectangle", "x": 280, "y": 368, "width": 280, "height": 84, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "#bcd8f7", "fillS