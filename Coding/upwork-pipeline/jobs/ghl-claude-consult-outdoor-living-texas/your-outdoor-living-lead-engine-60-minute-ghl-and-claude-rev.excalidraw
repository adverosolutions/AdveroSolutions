h workflow adds an\nentry tag in its first step,\nso Claude can see who entered\nit", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_13", "originalText": "7 - Each workflow adds an\nentry tag in its first step,\nso Claude can see who entered\nit", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_15", "type": "rectangle", "x": 2774, "y": 8, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 619570853, "version": 1, "versionNonce": 505913793, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_16"}, {"type": "arrow", "id": "arrow_43"}, {"type": "arrow", "id": "arrow_44"}], "updated": 1, "link": null, "locked": false}, {"id": "text_16", "type": "text", "x": 2786.0, "y": 21.875, "width": 256, "height": 56, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1324919353, "version": 1, "versionNonce": 776213900, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "8 - An If/Else step before\neach message checks that its\nmerge fields are filled in", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_15", "originalText": "8 - An If/Else step before\neach message checks that its\nmerge fields are filled in", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_17", "type": "rectangle", "x": 3122, "y": 8, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0