ctangle_7", "originalText": "4 - Does an older workflow\nfire on the same trigger? We\nmark which one stays", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_9", "type": "rectangle", "x": 1528, "y": 8, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1823296039, "version": 1, "versionNonce": 253877687, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_10"}, {"type": "arrow", "id": "arrow_40"}, {"type": "arrow", "id": "arrow_41"}], "updated": 1, "link": null, "locked": false}, {"id": "text_10", "type": "text", "x": 1540.0, "y": 12.5, "width": 256, "height": 75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 531725348, "version": 1, "versionNonce": 958804058, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - Anything instant or timed\nstays in GHL, like\nspeed-to-lead and consult\nreminders", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_9", "originalText": "5 - Anything instant or timed\nstays in GHL, like\nspeed-to-lead and consult\nreminders", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_11", "type": "rectangle", "x": 1876, "y": 8, "width": 280, "height": 84, "angle": 0, "strokeColor": "#444444", "backgroundColor": "#e9e9e9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 265695474, "version": 1, "versionNonce": 1703729685, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_12"}, {"t