{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_37", "type": "rectangle", "x": -104, "y": 174, "width": 700, "height": 234, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1159380354, "version": 1, "versionNonce": 2036236842, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_38", "type": "text", "x": -82, "y": 190, "width": 656, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 279172787, "version": 1, "versionNonce": 260573196, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - EVERY EVENT THAT COUNTS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - EVERY EVENT THAT COUNTS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_39", "type": "text", "x": -82, "y": 226, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1329753548, "version": 1, "versionNonce": 1914012529, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "One webhook, fed by a GHL workflow per event type. New lead, appointment booked or updated,\ncall outcome, contract sent, payment received. Every one arrives in the same shape.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "One webhook, fed by a GHL workflow per event type. New lead, appointment booked or updated,\ncall outcome, contract sent, payment received. Every one arrives in the same shape.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_40", "type": "rectangle", "x": 776, "y": -106, "width": 1416, "height": 954, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1222328496, "version": 1, "versionNonce": 1656961616, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_41", "type": "text", "x": 798, "y": -90, "width": 1372, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1490376254, "version": 1, "versionNonce": 96907016, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - CREDIT THE RIGHT REP", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - CREDIT THE RIGHT REP", "lineHeight": 1.25, "autoResize": false}, {"id": "text_42", "type": "text", "x": 798, "y": -54, "width": 1372, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1982966163, "version": 1, "versionNonce": 1526706730, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "This is the part that gets scorecards wrong. A booked call is credited to the assigned user on the calendar event, not to whoever owns the contact. Nothing gets counted until a rep is\nresolved.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "This is the part that gets scorecards wrong. A booked call is credited to the assigned user on the calendar event, not to whoever owns the contact. Nothing gets counted until a rep is\nresolved.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_43", "type": "rectangle", "x": 2390, "y": 302, "width": 352, "height": 266, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 721762279, "version": 1, "versionNonce": 502922617, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_44", "type": "text", "x": 2412, "y": 318, "width": 308, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2120395275, "version": 1, "versionNonce": 253207297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - WRITE THE RAW ROW", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - WRITE THE RAW ROW", "lineHeight": 1.25, "autoResize": false}, {"id": "text_45", "type": "text", "x": 2412, "y": 353, "width": 308, "height": 65, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 937195260, "version": 1, "versionNonce": 1234510746, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Every event lands on an Events tab, one row,\ntimestamped. The scorecard is always\nrebuildable from it, so a bad number can be\ntraced to the event that caused it.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Every event lands on an Events tab, one row,\ntimestamped. The scorecard is always\nrebuildable from it, so a bad number can be\ntraced to the event that caused it.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_46", "type": "rectangle", "x": 2942, "y": 190, "width": 2092, "height": 218, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 555512016, "version": 1, "versionNonce": 1063497604, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_47", "type": "text", "x": 2964, "y": 206, "width": 2048, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1708957521, "version": 1, "versionNonce": 1679116189, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - THE SCORECARD", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - THE SCORECARD", "lineHeight": 1.25, "autoResize": false}, {"id": "text_48", "type": "text", "x": 2964, "y": 242, "width": 2048, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2132480061, "version": 1, "versionNonce": 346094056, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Once a night the events roll up per rep into leads, booked, held, contracts, revenue, and the ratios that actually get coached on. One row per rep per day, plus a leaderboard in Slack.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Once a night the events roll up per rep into leads, booked, held, contracts, revenue, and the ratios that actually get coached on. One row per rep per day, plus a leaderboard in Slack.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_49", "type": "rectangle", "x": 5232, "y": 174, "width": 700, "height": 234, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 714537755, "version": 1, "versionNonce": 1929245187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_50", "type": "text", "x": 5254, "y": 190, "width": 656, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1725048951, "version": 1, "versionNonce": 1193309984, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - NOTHING FAILS QUIETLY", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - NOTHING FAILS QUIETLY", "lineHeight": 1.25, "autoResize": false}, {"id": "text_51", "type": "text", "x": 5254, "y": 226, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 588093311, "version": 1, "versionNonce": 1849076401, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "If a step breaks, you hear about it the same day with the failing node named. A silent\nscorecard is worse than no scorecard.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "If a step breaks, you hear about it the same day with the failing node named. A silent\nscorecard is worse than no scorecard.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_1", "type": "rectangle", "x": -68, "y": 288, "width": 280, "height": 84, "angle": 0, "strokeColor": "#2d6a4f", "backgroundColor": "#b7e4c7", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1390851129, "version": 1, "versionNonce": 647892280, "isDeleted": false, "boundElements": [{"type": "text", "id": "text_2"}, {"type": "arrow", "id": "arrow_52"}], "updated": 1, "link": null, "locked": false}, {"id": "text_2", "type": "text", "x": -56.0, "y": 301.875, "width": 256, "height": 56, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1695753999, "version": 1, "versionNonce": 207388625, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - GHL Event: New Lead,\nAppointment, Call, Contract,\nPayment", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "containerId": "rectangle_1", "originalText": "1 - GHL Event: New Lead,\nAppointment, Call, Contract,\nPayment", "li