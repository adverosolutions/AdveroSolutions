      "port": "ai_tool"
    },
    {
      "key": "mcp_kb",
      "kind": "ai.tool",
      "label": "MCP — Business Docs: Policies and FAQs",
      "parent": "agent",
      "port": "ai_tool"
    },
    {
      "key": "parser",
      "kind": "ai.parser",
      "label": "Reply + Action Taken + Confidence",
      "parent": "agent",
      "port": "ai_outputParser"
    },
    {
      "key": "risky",
      "kind": "flow.branch",
      "label": "6 · Money, Booking Change, or Complaint?",
      "section": "guard"
    },
    {
      "key": "review",
      "kind": "app.action",
      "app": "slack",
