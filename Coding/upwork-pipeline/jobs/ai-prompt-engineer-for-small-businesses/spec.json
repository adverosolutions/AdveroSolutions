{
  "title": "Small Business AI Assistant — Prompt Layer + MCP Tool Connections",
  "platform": "n8n",
  "sections": [
    {
      "key": "intake",
      "label": "1 · A REQUEST COMES IN FROM ANY CHANNEL",
      "color": 0,
      "note": "Chat widget, email, or an internal form. Every request lands in the same lane so one set of prompts serves all of them."
    },
    {
      "key": "prompt",
      "label": "2 · LOAD THE BUSINESS'S PROMPT PROFILE",
      "color": 0,
      "note": "Tone, services, pricing rules, and what the assistant is never allowed to promise live in a sheet the owner can edit. No code change to update a prompt."
    },
    {
      "key": "reason",
      "label": "3 · CLAUDE DECIDES AND USES THE BUSINESS'S OWN TOOLS",
      "color": 0,
      "note": "Each tool is an MCP connection into software the business already pays for. Claude reads and writes real records instead of guessing."
    },
    {
      "key": "guard",
      "label": "4 · CHECK THE ANSWER BEFORE IT GOES OUT",
      "color": 0,
      "note": "Anything touching money, bookings, or a complaint goes to a human first. Everything else replies on its own."
    },
    {
      "key": "learn",
      "label": "5 · LOG IT SO THE PROMPTS GET BETTER EVERY WEEK",
      "color": 0,
      "note": "Every exchange is scored. Low-scoring ones become next week's prompt revisions."
    }
  ],
  "nodes": [
    {
      "key": "chat",
      "kind": "trigger.chat",
      "label": "1 · Customer or Staff Message",
      "section": "intake"
    },
    {
      "key": "norm",
      "kind": "data.transform",
      "label": "2 · Normalize Channel, Sender, Business ID",
      "section": "intake"
    },
    {
      "key": "profile",
      "kind": "app.action",
      "app": "googleSheets",
      "op": "read",
      "label": "3 · Read the Prompt Profile for This Business",
      "section": "prompt"
    },
    {
      "key": "build",
      "kind": "data.transform",
      "label": "4 · Assemble System Prompt (Tone + Rules + Context)",
      "section": "prompt"
    },
    {
      "key": "agent",
      "kind": "ai.agent",
      "label": "5 · Claude Handles the Request",
      "section": "reason"
    },
    {
      "key": "model",
      "kind": "ai.model",
      "app": "anthropic",
      "label": "Claude",
      "parent": "agent",
      "port": "ai_languageModel"
    },
    {
      "key": "memory",
      "kind": "ai.memory",
      "label": "Conversation Memory (per customer)",
      "parent": "agent",
      "port": "ai_memory"
    },
    {
      "key": "mcp_crm",
      "kind": "ai.tool",
      "label": "MCP — CRM: Find or Update a Customer",
