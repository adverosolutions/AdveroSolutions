      "port": "ai_tool"
    },
    {
      "key": "mcp_cal",
      "kind": "ai.tool",
      "label": "MCP — Calendar: Check and Book Slots",
      "parent": "agent",
      "port": "ai_tool"
    },
    {
      "key": "mcp_inv",
      "kind": "ai.tool",
      "label": "MCP — Invoicing: Balance and Payment Link",
