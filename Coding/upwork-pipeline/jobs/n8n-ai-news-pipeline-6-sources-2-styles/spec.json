{
  "title": "Your Two-Voice News Desk - 6 Sources to Google Sheets",
  "platform": "n8n",
  "sections": [
    {
      "key": "pull",
      "label": "1 - EVERY MORNING, PULL THE SIX SOURCES",
      "color": 0,
      "note": "One trigger for the whole pipeline. The six urls live in one node, so swapping a source is a one line edit, not a rebuild."
    },
    {
      "key": "screen",
      "label": "2 - KEEP ONLY WHAT IS NEW AND ON TOPIC",
      "color": 0,
      "note": "Keyword screen first, then a lookup against what the sheet already holds. The same story never gets written or paid for twice."
    },
    {
      "key": "voices",
      "label": "3 - REWRITE EVERY STORY IN BOTH VOICES",
      "color": 0,
      "note": "Two separate nodes, two separate prompts. Style A reads like a newsroom wire, style B like a signed column, and you can tune one without touching the other."
    },
    {
      "key": "topics",
      "label": "4 - WRITE THE 20 ORIGINAL TOPICS",
      "color": 0,
      "note": "Your own topic list, written by the same model, landing in the same review sheet with the source marked original so editors can sort them apart."
    },
    {
      "key": "watch",
      "label": "5 - NOTHING FAILS QUIETLY",
      "color": 0,
      "note": "A dead source gets logged and the other five keep running. A real failure pings you before anyone opens the sheet and finds it empty."
    }
  ],
  "nodes": [
    {
      "key": "sched",
      "kind": "trigger.schedule",
      "label": "1 - Every Morning at 6am",
      "section": "pull"
    },
    {
      "key": "sources",
      "kind": "data.transform",
      "label": "2 - Load the 6 Source Feeds",
      "section": "pull"
    },
    {
      "key": "fetch",
      "kind": "net.http",
      "label": "3 - Fetch the RSS Feed",
      "section": "pull"
    },
    {
      "key": "reach",
      "kind": "flow.branch",
      "label": "4 - Feed Reachable?",
      "section": "pull"
    },
    {
      "key": "deadlog",
      "kind": "app.action",
      "app": "googleSheets",
      "op": "append",
      "label": "5 - Log the Dead Source",
      "section": "pull"
    },
    {
      "key": "split",
      "kind": "data.split",
      "label": "6 - Split Into One Story per Item",
      "section": "screen"
    },
    {
      "key": "relevant",
      "kind": "data.filter",
      "label": "7 - Keep Only Topic Relevant Stories",
      "section": "screen"
    },
    {
      "key": "published",
      "kind": "app.action",
      "app": "googleSheets",
      "op": "read",
      "label": "8 - Look Up What We Already Published",
      "section": "screen"
    },
    {
      "key": "isnew",
      "kind": "flow.branch",
      "label": "9 - New Story?",
      "section": "screen"
    },
    {
      "key": "stylea",
      "kind": "ai.llm",
      "label": "10 - Rewrite in Style A, Newsroom",
      "section": "voices"
    },
    {
      "key": "modela",
      "kind": "ai.model",
      "app": "openai",
      "label": "GPT-4o",
      "parent": "stylea",
      "port": "ai_languageModel"
    },
    {
      "key": "styleb",
      "kind": "ai.llm",
      "label": "11 - Rewrite in Style B, Editorial Column",
      "section": "voices"
    },
    {
      "key": "modelb",
      "kind": "ai.model",
      "app": "openai",
      "label": "GPT-4o",
      "parent": "styleb",
      "port": "ai_languageModel"
    },
    {
      "key": "sheetnews",
      "kind": "app.action",
      "app": "googleSheets",
      "op": "append",
      "label": "12 - Write Both Versions to the Review Sheet",
      "section": "voices"
    },
    {
      "key": "topicload",
      "kind": "app.action",
      "app": "googleSheets",
      "op": "read",
      "label": "13 - Load the 20 Topic Prompts",
      "section": "topics"
    },
    {
      "key": "topicwrite",
      "kind": "ai.llm",
      "label": "14 - Write the Topic Article",
      "section": "topics"
    },
    {
      "key": "modelt",
      "kind": "ai.model",
      "app": "openai",
      "label": "GPT-4o",
      "parent": "topicwrite",
      "port": "ai_languageModel"
    },
    {
      "key": "topicappend",
      "kind": "app.action",
      "app": "googleSheets",
      "op": "append",
      "label": "15 - Add the Originals to the Same Sheet",
      "section": "topics"
    },
    {
      "key": "err",
      "kind": "trigger.app",
      "app": "n8n",
      "op": "error_trigger",
      "label": "16 - Any Node Fails, Anywhere",
      "section": "watch"
    },
    {
      "key": "alert",
      "kind": "app.action",
      "app": "telegram",
      "op": "send",
      "label": "17 - Alert: Pipeline Failed",
      "section": "watch"
    }
  ],
  "edges": [
    { "from": "sched", "to": "sources" },
    { "from": "sources", "to": "fetch" },
    { "from": "fetch", "to": "reach" },
    { "from": "reach", "to": "split", "branch": "true" },
    { "from": "reach", "to": "deadlog", "branch": "false" },
    { "from": "split", "to": "relevant" },
    { "from": "relevant", "to": "published" },
    { "from": "published", "to": "isnew" },
    { "from": "isnew", "to": "stylea", "branch": "true" },
    { "from": "isnew", "to": "split", "branch": "false", "loop": true },
    { "from": "stylea", "to": "styleb" },
    { "from": "styleb", "to": "sheetnews" },
    { "from": "sheetnews", "to": "topicload" },
    { "from": "topicload", "to": "topicwrite" },
    { "from": "topicwrite", "to": "topicappend" },
    { "from": "err", "to": "alert" }
  ],
  "input_sample": {
