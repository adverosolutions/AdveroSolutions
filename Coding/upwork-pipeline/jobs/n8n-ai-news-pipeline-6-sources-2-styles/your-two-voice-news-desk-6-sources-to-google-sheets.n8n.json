        2380,
        -120
      ]
    },
    {
      "parameters": {
        "content": "## 4 - WRITE THE 20 ORIGINAL TOPICS\n\nYour own topic list, written by the same model, landing in the same review sheet with the source marked original so editors can sort them apart.",
        "height": 560,
        "width": 800,
        "color": 7
      },
      "id": "e9b734d1-aded-5280-8ee9-a0dde149b927",
