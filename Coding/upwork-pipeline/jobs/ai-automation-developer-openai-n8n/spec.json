{
  "title": "Your AI Request Handler - From Request to Done in Seconds",
  "platform": "n8n",
  "sections": [
    {
      "key": "intake",
      "label": "1 - A REQUEST COMES IN",
      "color": 0,
      "note": "Any website form, inbox or app that can send a webhook plugs in here. The fields get tidied first, so a messy entry never breaks a later step."
    },
    {
      "key": "ai",
      "label": "2 - OPENAI READS IT AND WRITES THE REPLY",
      "color": 0,
      "note": "One OpenAI call returns the category, urgency, key details and a ready reply, in a fixed format. Every request is logged to the sheet before anything else happens."
    },
    {
      "key": "route",
      "label": "3 - THE RIGHT PERSON HEARS ABOUT IT",
      "color": 0,
      "note": "Quote requests get a reply in seconds and sales gets the summary. Support issues, and anything the AI is unsure about, wait as a Gmail draft a person approves. Spam stops here."
    },
    {
      "key": "close",
      "label": "4 - CLOSE THE LOOP, FAIL LOUDLY",
      "color": 0,
      "note": "The row is marked handled with the Slack link and the time it took, so the team sees status in one place. If any step fails, Slack gets an alert with a link to the failed run."
    }
  ],
  "nodes": [
    {
      "key": "hook",
      "kind": "trigger.webhook",
      "label": "1 - New Request Comes In",
      "section": "intake",
      "params": {
        "path": "new-request",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "key": "tidy",
      "kind": "data.transform",
      "label": "2 - Tidy the Name, Email and Message",
      "section": "intake",
      "params": {
        "assignments": {
          "assignments": [
            {
              "id": "5f1c2a90-7d3e-4b6a-9c11-000000000001",
              "name": "request_id",
              "value": "={{ 'req_' + $execution.id }}",
              "type": "string"
            },
            {
              "id": "5f1c2a90-7d3e-4b6a-9c11-000000000002",
              "name": "received_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "5f1c2a90-7d3e-4b6a-9c11-000000000003",
              "name": "name",
              "value": "={{ ($json.body.name || '').trim() }}",
              "type": "string"
            },
            {
              "id": "5f1c2a90-7d3e-4b6a-9c11-000000000004",
              "name": "email",
              "value": "={{ ($json.body.email || '').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "5f1c2a90-7d3e-4b6a-9c11-000000000005",
              "name": "phone",
              "value": "={{ ($json.body.phone || '').replace(/[^0-9+]/g, '') }}",
              "type": "string"
            },
            {
              "id": "5f1c2a90-7d3e-4b6a-9c11-000000000006",
              "name": "company",
              "value": "={{ ($json.body.company || '').trim() }}",
              "type": "string"
            },
            {
              "id": "5f1c2a90-7d3e-4b6a-9c11-000000000007",
              "name": "message",
              "value": "={{ ($json.body.message || '').trim() }}",
              "type": "string"
            },
            {
              "id": "5f1c2a90-7d3e-4b6a-9c11-000000000008",
              "name": "source",
              "value": "={{ $json.body.form || 'Website form' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "key": "read",
      "kind": "ai.llm",
      "label": "3 - OpenAI Sorts It and Drafts the Reply",
      "section": "ai",
      "params": {
        "promptType": "define",
        "text": "=Request from {{ $json.name }}{{ $json.company ? ' at ' + $json.company : '' }} <{{ $json.email }}>, via {{ $json.source }}:\n\n{{ $json.message }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You handle incoming requests for a small business team.\n\nReturn:\n- category: Quote Request, Support Issue or Spam. If you are not sure, use Support Issue so a person checks the reply before it goes out.\n- urgency: high if they mention a deadline or visit within 7 days, something broken, or an unhappy customer. Otherwise normal.\n- summary: one sentence the team can read in Slack.\n- key_details: only facts written in the request, separated by semicolons. Never guess.\n- missing_info: what we still need before we can quote or fix it.\n- reply_subject and reply_body: a short, friendly plain-text email. Thank them by first name, confirm what they asked for, ask for the most important missing detail, and say someone will follow up within one business day. Never give a price or promise a date. Sign off as The Team."
            }
          ]
        }
      }
    },
    {
      "key": "model",
      "kind": "ai.model",
      "app": "openai",
      "label": "OpenAI",
      "parent": "read",
      "port": "ai_languageModel",
      "params": {
        "options": {
          "temperature": 0.2
        }
      }
    },
    {
      "key": "parser",
      "kind": "ai.parser",
      "label": "Category, Urgency, Key Details, Reply",
      "parent": "read",
      "port": "ai_outputParser",
      "params": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Quote Request\",\n        \"Support Issue\",\n        \"Spam\"\n      ]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"high\",\n        \"normal\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"key_details\": {\n      \"type\": \"string\"\n    },\n    \"missing_info\": {\n      \"type\": \"string\"\n    },\n    \"reply_subject\": {\n      \"type\": \"string\"\n    },\n    \"reply_body\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"urgency\",\n    \"summary\",\n    \"key_details\",\n    \"missing_info\",\n    \"reply_subject\",\n    \"reply_body\"\n  ]\n}"
      }
    },
    {
      "key": "log",
      "kind": "app.action",
      "app": "googleSheets",
      "op": "append",
      "label": "4 - Log It to the Requests Sheet",
      "section": "ai",
      "params": {
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "request_id": "={{ $('2 - Tidy the Name, Email and Message').item.json.request_id }}",
            "received_at": "={{ $('2 - Tidy the Name, Email and Message').item.json.received_at }}",
            "name": "={{ $('2 - Tidy the Name, Email and Message').item.json.name }}",
            "email": "={{ $('2 - Tidy the Name, Email and Message').item.json.email }}",
            "phone": "={{ $('2 - Tidy the Name, Email and Message').item.json.phone }}",
            "company": "={{ $('2 - Tidy the Name, Email and Message').item.json.company }}",
            "source": "={{ $('2 - Tidy the Name, Email and Message').item.json.source }}",
            "category": "={{ $json.output.category }}",
            "urgency": "={{ $json.output.urgency }}",
            "summary": "={{ $json.output.summary }}",
            "key_details": "={{ $json.output.key_details }}",
            "missing_info": "={{ $json.output.missing_info }}",
            "reply_subject": "={{ $json.output.reply_subject }}",
            "reply_body": "={{ $json.output.reply_body }}",
            "status": "new"
          },
          "matchingColumns": [
            "request_id"
          ],
          "schema": [
            {
              "id": "request_id",
              "displayName": "request_id",
              "required": false,
              "defaultMatch": true,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "received_at",
              "displayName": "received_at",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "name",
              "displayName": "name",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "email",
              "displayName": "email",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "phone",
              "displayName": "phone",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "company",
              "displayName": "company",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "source",
              "displayName": "source",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "category",
              "displayName": "category",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "urgency",
              "displayName": "urgency",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "summary",
              "displayName": "summary",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "key_details",
              "displayName": "key_details",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "missing_info",
              "displayName": "missing_info",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "reply_subject",
              "displayName": "reply_subject",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "reply_body",
              "displayName": "reply_body",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "status",
              "displayName": "status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "key": "switch",
      "kind": "flow.switch",
      "label": "5 - Route by Category",
      "section": "route"
    },
    {
      "key": "send",
      "kind": "app.action",
      "app": "gmail",
      "op": "send",
      "label": "6a - Email the Reply Right Away",
      "section": "route",
      "params": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.reply_subject }}",
        "emailType": "text",
        "message": "={{ $json.reply_body }}",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "key": "sales",
      "kind": "app.action",
      "app": "slack",
      "op": "post",
      "label": "7a - Tell Sales: New Quote, Reply Sent",
      "section": "route",
      "params": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#sales"
        },
        "text": "={{ $('4 - Log It to the Requests Sheet').item.json.urgency === 'high' ? '<!here> ' : '' }}*New quote request* from {{ $('4 - Log It to the Requests Sheet').item.json.name }}{{ $('4 - Log It to the Requests Sheet').item.json.company ? ', ' + $('4 - Log It to the Requests Sheet').item.json.company : '' }}\n{{ $('4 - Log It to the Requests Sheet').item.json.summary }}\nDetails: {{ $('4 - Log It to the Requests Sheet').item.json.key_details }}\nStill need: {{ $('4 - Log It to the Requests Sheet').item.json.missing_info }}\nReply already sent to {{ $('4 - Log It to the Requests Sheet').item.json.email }}.",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      }
    },
    {
      "key": "draft",
      "kind": "app.action",
      "app": "gmail",
      "op": "draft",
      "label": "6b - Save the Reply as a Draft to Approve",
      "section": "route",
      "params": {
        "subject": "={{ $json.reply_subject }}",
        "emailType": "text",
        "message": "={{ $json.reply_body }}",
        "options": {
          "sendTo": "={{ $json.email }}"
        }
      }
    },
    {
      "key": "support",
      "kind": "app.action",
      "app": "slack",
      "op": "post",
      "label": "7b - Tell Support a Draft Is Waiting",
      "section": "route",
      "params": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#support"
        },
        "text": "={{ $('4 - Log It to the Requests Sheet').item.json.urgency === 'high' ? '<!here> ' : '' }}*Support request* from {{ $('4 - Log It to the Requests Sheet').item.json.name }}\n{{ $('4 - Log It to the Requests Sheet').item.json.summary }}\nDetails: {{ $('4 - Log It to the Requests Sheet').item.json.key_details }}\nA reply is waiting in Gmail Drafts. Check it and hit send.",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      }
    },
    {
      "key": "spam",
      "kind": "flow.noop",
      "label": "6c - Spam: Logged, No Reply",
      "section": "route"
    },
    {
      "key": "done",
      "kind": "app.action",
      "app": "googleSheets",
      "op": "update",
      "label": "8 - Mark the Row Handled",
      "section": "close",
      "params": {
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "request_id": "={{ $('4 - Log It to the Requests Sheet').item.json.request_id }}",
            "status": "={{ $('4 - Log It to the Requests Sheet').item.json.category === 'Quote Request' ? 'reply sent' : 'draft waiting for approval' }}",
            "slack_ts": "={{ $json.ts }}",
            "handled_at": "={{ $now.toISO() }}",
            "seconds_to_handle": "={{ Math.round($now.diff(DateTime.fromISO($('4 - Log It to the Requests Sheet').item.json.received_at), 'seconds').seconds) }}"
          },
          "matchingColumns": [
            "request_id"
          ],
          "schema": [
            {
              "id": "request_id",
              "displayName": "request_id",
              "required": false,
              "defaultMatch": true,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "status",
              "displayName": "status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "slack_ts",
              "displayName": "slack_ts",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "handled_at",
              "displayName": "handled_at",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "seconds_to_handle",
              "displayName": "seconds_to_handle",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "key": "err",
      "kind": "trigger.app",
      "app": "n8n",
      "op": "error_trigger",
      "label": "9 - Any Step Fails",
      "section": "close"
    },
    {
      "key": "alert",
      "kind": "app.action",
      "app": "slack",
      "op": "post",
      "label": "10 - Alert Slack With a Link to the Failed Run",
      "section": "close",
      "params": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#ops-alerts"
        },
        "text": "=:rotating_light: Request handler failed at *{{ $json.execution.lastNodeExecuted }}*\n{{ $json.execution.error.message }}\nOpen the failed run: {{ $json.execution.url }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      }
    }
  ],
  "edges": [
    {
      "from": "hook",
      "to": "tidy"
    },
    {
      "from": "tidy",
      "to": "read"
    },
    {
      "from": "read",
      "to": "log"
    },
    {
      "from": "log",
      "to": "switch"
    },
    {
      "from": "switch",
      "to": "send",
      "branch": "Quote Request"
    },
    {
      "from": "switch",
      "to": "draft",
      "branch": "Support Issue"
    },
    {
      "from": "switch",
      "to": "spam",
      "branch": "Spam"
    },
    {
      "from": "send",
      "to": "sales"
    },
    {
      "from": "draft",
      "to": "support"
    },
    {
      "from": "sales",
      "to": "done"
    },
    {
      "from": "support",
      "to": "done"
    },
    {
      "from": "err",
      "to": "alert"
    }
  ],
  "input_sample": {
    "headers": {
      "content-type": "application/json"
    },
    "params": {},
    "query": {},
    "body": {
      "form": "Website Contact Form",
