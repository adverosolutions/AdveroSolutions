      "id": "06ff5a05-5e12-5af0-9e50-d1ad41e1abe4",
      "name": "2 - Tidy the Name, Email and Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        240,
        180
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Request from {{ $json.name }}{{ $json.company ? ' at ' + $json.company : '' }} <{{ $json.email }}>, via {{ $json.source }}:\n\n{{ $json.message }}",
        "batching": {},
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You handle incoming requests for a small business team.\n\nReturn:\n- category: Quote Request, Support Issue or Spam. If you are not sure, use Support Issue so a person checks the reply before it goes out.\n- urgency: high if they mention a deadline or visit within 7 days, something broken, or an unhappy customer. Otherwise normal.\n- summary: one sentence the team can read in Slack.\n- key_details: only facts written in the request, separated by semicolons. Never guess.\n- missing_info: what we still need before we can quote or fix it.\n- reply_subject and reply_body: a short, friendly plain-text email. Thank them by first name, confirm what they asked for, ask for the most important missing detail, and say someone will follow up within one business day. Never give a price or promise a date. Sign off as The Team."
            }
          ]
        }
      },
      "id": "dc64ece9-03a4-5745-8b8b-e0fbe387f36b",
      "name": "3 - OpenAI Sorts It and Drafts the Reply",
