 the copy the way it comes out, plus the one thing the update should get people to\ndo. Nothing in your draft gets lost on the way to the finished email.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_26", "type": "rectangle", "x": 796, "y": -42, "width": 700, "height": 250, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1289560150, "version": 1, "versionNonce": 2126508551, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_27", "type": "text", "x": 818, "y": -26, "width": 656, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1475216846, "version": 1, "versionNonce": 1927728187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - DESIGN: STRUCTURE AND BRAND KIT", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - DESIGN: STRUCTURE AND BRAND KIT", "lineHeight": 1.25, "autoResize": false}, {"id": "text_28", "type": "text", "x": 818, "y": 9, "width": 656, "height": 49, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1236683273, "version": 1, "versionNonce": 314395343, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The update is broken into sections people can scan in seconds, then dressed in your colors,\nfonts and logo. The header and footer are saved once in GoHighLevel, so every future update\nstarts on brand.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The update is broken into sections people can scan in seconds, then dressed in your colors,\nfonts and logo. The header and footer are saved once in GoHighLevel, so every future update\nstarts on brand.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_29", "type": "rectangle", "x": 1694, "y": -106, "width": 1396, "height": 342, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 507088657, "version": 1, "versionNonce": 1795823849, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_30", "type": "text", "x": 1716, "y": -90, "width": 1352, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 708506837, "version": 1, "versionNonce": 1469118511, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - BUILD AND TEST IN GOHIGHLEVEL", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - BUILD AND TEST IN GOHIGHLEVEL", "lineHeight": 1.25, "autoResize": false}, {"id": "text_31", "type": "text", "x": 1716, "y": -54, "width": 1352, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 652768598, "version": 1, "versionNonce": 2100080515, "isDeleted": false, "boundElements": [], "updated"