{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_32", "type": "rectangle", "x": -104, "y": -106, "width": 700, "height": 234, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1811180650, "version": 1, "versionNonce": 168393880, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_33", "type": "text", "x": -82, "y": -90, "width": 656, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 333377415, "version": 1, "versionNonce": 1347535309, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - CASE READY FOR DEMAND: PULL THE RECORDS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - CASE READY FOR DEMAND: PULL THE RECORDS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_34", "type": "text", "x": -82, "y": -54, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1460814403, "version": 1, "versionNonce": 1504004732, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Your part 4 starts here: collect the case information automatically. The case's medical\nrecords and bills come from its Google Drive folder.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Your part 4 starts here: collect the case information automatically. The case's medical\nrecords and bills come from its Google Drive folder.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_35", "type": "rectangle", "x": 912, "y": -106, "width": 1018, "height": 436, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2133201996, "version": 1, "versionNonce": 1959386987, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_36", "type": "text", "x": 934, "y": -90, "width": 974, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 295334610, "version": 1, "versionNonce": 401991736, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - YOUR PART 3: EXTRACT, TOTAL AND FLAG GAPS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - YOUR PART 3: EXTRACT, TOTAL AND FLAG GAPS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_37", "type": "text", "x": 934, "y": -54, "width": 974, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1159380354, "version": 1, "versionNonce": 2036236842, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Every visit, diagnosis, procedure, provider and charge, each traceable to its document and page. Expenses by provider, and missing\nrecords or gaps flagged before a draft exists.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Every visit, diagnosis, procedure, provider and charge, each traceable to its document and page. Expenses by provider, and missing\nrecords or gaps flagged before a draft exists.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_38", "type": "rectangle", "x": 2202, "y": -106, "width": 772, "height": 436, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 279172787, "version": 1, "versionNonce": 260573196, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_39", "type": "text", "x": 2224, "y": -90, "width": 728, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1329753548, "version": 1, "versionNonce": 1914012529, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - YOUR PART 4: DRAFT FROM YOUR TEMPLATE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - YOUR PART 4: DRAFT FROM YOUR TEMPLATE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_40", "type": "text", "x": 2224, "y": -54, "width": 728, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1222328496, "version": 1, "versionNonce": 1656961616, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The demand letter is drafted from your firm-approved template using only extracted facts, with an\norganized exhibit index. Nothing is invented.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The demand letter is drafted from your firm-approved template using only extracted facts, with an\norganized exhibit index. Nothing is invented.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_41", "type": "rectangle", "x": 3174, "y": -118, "width": 1048, "height": 274, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1490376254, "version": 1, "versionNonce": 96907016, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_42", "type": "text", "x": 3196, "y": -102, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1982966163, "version": 1, "versionNonce": 1526706730, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - ATTORNEY REVIEWS, EDITS AND APPROVES", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - ATTORNEY REVIEWS, EDITS AND APPROVES", "lineHeight": 1.25, "autoResize": false}, {"id": "text_43", "type": "text", "x": 3196, "y": -66, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 721762279, "version": 1, "versionNonce": 502922617, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Nothing leaves without attorney approval. Edits go back into the draft; approved packages export to Word and PDF.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Nothing leaves without attorney approval. Edits go back into the draft; approved packages export to Word and PDF.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_44", "type": "rectangle", "x": 4420, "y": -106, "width": 700, "height": 234, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2120395275, "version": 1, "versionNonce": 253207297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_45", "type": "text", "x": 4442, "y": -90, "width": 656, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 937195260, "version": 1, "versionNonce": 1234510746, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - IF ANY STEP FAILS", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - IF ANY STEP FAILS", "lineHeight": 1.25, "autoResize": false}, {"id": "text_46", "type": "text", "x": 4442, "y": -54, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness":