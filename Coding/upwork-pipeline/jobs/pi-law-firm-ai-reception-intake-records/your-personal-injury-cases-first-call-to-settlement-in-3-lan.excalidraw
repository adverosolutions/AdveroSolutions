{"type": "excalidraw", "version": 2, "source": "upwork-workflow-generator", "elements": [{"id": "rectangle_27", "type": "rectangle", "x": -104, "y": -42, "width": 700, "height": 250, "angle": 0, "strokeColor": "#9db7e6", "backgroundColor": "#e7f0fd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1475216846, "version": 1, "versionNonce": 1927728187, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_28", "type": "text", "x": -82, "y": -26, "width": 656, "height": 28, "angle": 0, "strokeColor": "#1e4f9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1236683273, "version": 1, "versionNonce": 314395343, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 - AI RECEPTIONIST AND FRONT DESK", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "1 - AI RECEPTIONIST AND FRONT DESK", "lineHeight": 1.25, "autoResize": false}, {"id": "text_29", "type": "text", "x": -82, "y": 9, "width": 656, "height": 49, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 507088657, "version": 1, "versionNonce": 1795823849, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Every call is answered 24/7 in English, Spanish or Haitian Creole, several at once. Haitian\nCreole voice gets tested on real-style calls with a Creole speaker you trust before any line\ngoes live.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Every call is answered 24/7 in English, Spanish or Haitian Creole, several at once. Haitian\nCreole voice gets tested on real-style calls with a Creole speaker you trust before any line\ngoes live.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_30", "type": "rectangle", "x": 796, "y": -26, "width": 700, "height": 234, "angle": 0, "strokeColor": "#9fd1a8", "backgroundColor": "#e8f6ea", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 708506837, "version": 1, "versionNonce": 1469118511, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_31", "type": "text", "x": 818, "y": -10, "width": 656, "height": 28, "angle": 0, "strokeColor": "#1f6b30", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 652768598, "version": 1, "versionNonce": 2100080515, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 - CLIENT INTAKE AND NEW CASE ONBOARDING", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "2 - CLIENT INTAKE AND NEW CASE ONBOARDING", "lineHeight": 1.25, "autoResize": false}, {"id": "text_32", "type": "text", "x": 818, "y": 26, "width": 656, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1811180650, "version": 1, "versionNonce": 168393880, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The intake runs by phone, website, text or email in the caller's language. Nothing becomes a\ncase until your conflict check and an attorney have cleared it.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The intake runs by phone, website, text or email in the caller's language. Nothing becomes a\ncase until your conflict check and an attorney have cleared it.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_33", "type": "rectangle", "x": 1694, "y": -26, "width": 1048, "height": 234, "angle": 0, "strokeColor": "#c7a6e3", "backgroundColor": "#f3e9fb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 333377415, "version": 1, "versionNonce": 1347535309, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_34", "type": "text", "x": 1716, "y": -10, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#5b2c8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1460814403, "version": 1, "versionNonce": 1504004732, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - MEDICAL RECORDS AND MEDICAL BILLING", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "3 - MEDICAL RECORDS AND MEDICAL BILLING", "lineHeight": 1.25, "autoResize": false}, {"id": "text_35", "type": "text", "x": 1716, "y": 26, "width": 1004, "height": 32, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2133201996, "version": 1, "versionNonce": 1959386987, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Records and bills are requested with your approved templates and authorizations, then chased until they arrive. Every visit, diagnosis and\nbill is logged with the page it came from.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Records and bills are requested with your approved templates and authorizations, then chased until they arrive. Every visit, diagnosis and\nbill is logged with the page it came from.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_36", "type": "rectangle", "x": 2942, "y": -90, "width": 1048, "height": 458, "angle": 0, "strokeColor": "#e6c97a", "backgroundColor": "#fff5df", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 295334610, "version": 1, "versionNonce": 401991736, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_37", "type": "text", "x": 2964, "y": -74, "width": 1004, "height": 28, "angle": 0, "strokeColor": "#8a5a00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1159380354, "version": 1, "versionNonce": 2036236842, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - SETTLEMENT BROCHURE AND DEMAND PACKAGE", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "4 - SETTLEMENT BROCHURE AND DEMAND PACKAGE", "lineHeight": 1.25, "autoResize": false}, {"id": "text_38", "type": "text", "x": 2964, "y": -38, "width": 1004, "height": 16, "angle": 0, "strokeColor": "#4a4a4a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 279172787, "version": 1, "versionNonce": 260573196, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The draft is built only from what is in the file, so nothing is invented. An attorney approves it before anything leaves the firm.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The draft is built only from what is in the file, so nothing is invented. An attorney approves it before anything leaves the firm.", "lineHeight": 1.25, "autoResize": false}, {"id": "rectangle_39", "type": "rectangle", "x": 4188, "y": -106, "width": 700, "height": 234, "angle": 0, "strokeColor": "#8fd0d8", "backgroundColor": "#e4f7f9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1329753548, "version": 1, "versionNonce": 1914012529, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_40", "type": "text", "x": 4210, "y": -90, "width": 656, "height": 28, "angle": 0, "strokeColor": "#0e5f6a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1222328496, "version": 1, "versionNonce": 1656961616, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5 - CASE MANAGEMENT AND CLIENT COMMUNICATION", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "5 - CASE MANAGEMENT AND CLIENT COMMUNICATION", "lineHeight": 1.25, "autoResize": false}, {"id": "text_41", "type": "text", "x": 4210, "y": -54, "width": 656, "height": 32, "angle": 0, "strok