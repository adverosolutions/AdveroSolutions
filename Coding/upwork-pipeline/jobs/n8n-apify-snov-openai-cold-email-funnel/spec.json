      "key": "write",
      "label": "3 \u00b7 RESEARCH AND WRITE A PERSONAL FIRST LINE",
      "color": 0,
      "note": "The agent reads their website and writes one line about them, plus a fit score."
    },
    {
      "key": "send",
      "label": "4 \u00b7 LOAD THE CAMPAIGN AND KEEP THE RECORD",
      "color": 0,
      "note": "Only prospects that passed both checks get added. Everything else is logged with a reason."
    },
    {
      "key": "replies",
      "label": "5 \u00b7 HANDLE EVERY REPLY THE SAME DAY",
