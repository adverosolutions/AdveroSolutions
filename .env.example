# AdveroSolutions Environment Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

# ============================================
# INSTANTLY API
# ============================================
# Get your API key from: https://app.instantly.ai/app/settings/integrations
INSTANTLY_API_KEY=your_instantly_api_key_here

# ============================================
# ANTHROPIC (CLAUDE API)
# ============================================
# Get your API key from: https://console.anthropic.com/
# Every model call runs on Claude Opus 5.5 (2026-09-25). The scripts pin
# claude-opus-5-5 in code and no longer read ANTHROPIC_MODEL; the line is kept
# so an old value in a local .env is easy to spot and update.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-5-5

# ============================================
# GOOGLE SHEETS CRM
# ============================================
# After running execution/initialize_crm.py, paste the Sheet ID here
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ============================================
# CALENDAR INTEGRATION
# ============================================
# Options: "google_calendar" or "calendly"
CALENDAR_TYPE=google_calendar
CALENDLY_API_KEY=your_calendly_key_if_using_calendly

# For Google Calendar: Uses credentials.json OAuth flow
# No additional config needed if using Google Calendar

# ============================================
# MODAL (CLOUD AUTOMATION)
# ============================================
# Modal token configured via: modal token new
# Webhooks deployed via: modal deploy execution/modal_webhook.py

# ============================================
# SLACK NOTIFICATIONS (OPTIONAL)
# ============================================
# Get webhook URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=your_slack_webhook_url_optional

# ============================================
# SUPABASE (FREE VALUE HOSTING)
# ============================================
# Project URL from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=free-value

# ============================================
# SYSTEM CONFIGURATION
# ============================================
# How often to check for new replies (seconds)
REPLY_CHECK_INTERVAL=60

# Maximum emails per day per account (stay under Instantly limits)
MAX_EMAILS_PER_ACCOUNT_PER_DAY=40

# Timezone for scheduling
TIMEZONE=America/New_York

# Environment (development or production)
ENVIRONMENT=production

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
ERROR_LOG_PATH=.tmp/error_log.txt

# =============================================================
# REVENUE AUTOMATION (added 2026-09-21)
# =============================================================
# shadow = propose/log/notify only (default). live = allowed to send/book/move, and only with ALLOW_LIVE_WRITES=1
MODE=shadow
ALLOW_LIVE_WRITES=0
# GHL Private Integration token (Settings > Private Integrations; scopes: contacts, opportunities, calendars, calendars/events, conversations, workflows)
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=ebyNANPagaK7ycf1pfge
# ntfy.sh topic for approvals and alerts (subscribe on your phone: https://ntfy.sh/<topic>)
NTFY_TOPIC=
# Signing secret for one-tap approve/veto links in notifications (any long random string)
REPLY_ENGINE_SECRET=
# Anthropic (runtime model: claude-opus-5-5 for every role, set in shared/llm.py MODEL_POLICY)
ANTHROPIC_API_KEY=
# Google Sheet that holds the Job_Log tab (service account JSON in GOOGLE_CREDENTIALS_JSON)
JOB_LOG_SHEET_ID=
